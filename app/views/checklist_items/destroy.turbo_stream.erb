<%= turbo_stream.remove @item %>
<%= turbo_stream.update "checklist-progress", partial: "trips/checklist_progress", locals: { trip: @trip } %>
<%= turbo_stream.update "checklist-flash" do %>
  <div class="rounded-xl border border-slate-800 bg-slate-900/40 px-4 py-3 flex items-center justify-between gap-3 mt-4"
       data-controller="auto-dismiss" data-auto-dismiss-delay-value="8000">
    <p class="text-sm text-slate-200 min-w-0 truncate">Removed <span class="font-medium text-slate-100">“<%= @item.title %>”</span></p>
    <%= button_to "Undo", restore_trip_checklist_item_path(@trip, @item), method: :patch,
          class: "btn btn-sm shrink-0 text-sm font-semibold text-amber-300 hover:text-amber-200 hover:bg-amber-500/10 rounded-lg cursor-pointer" %>
  </div>
<% end %>
