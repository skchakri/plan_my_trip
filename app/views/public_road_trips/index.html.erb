<% content_for :title, "Road Trip Guides · Wanderply" %>
<% content_for :description, "Curated road-trip guides — the best routes, famous stops, day-by-day plans, and weather. Then build your own in two minutes with Wanderply." %>
<% content_for :canonical, canonical_base_url + road_trips_path %>

<section class="relative overflow-hidden">
  <div class="absolute inset-0"><div class="aurora"></div></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-10 sm:pt-40">
    <p class="text-[11px] uppercase tracking-[0.18em] text-amber-300 font-semibold">Road trip guides</p>
    <h1 class="mt-3 font-display text-4xl sm:text-6xl font-semibold tracking-tight leading-[1.05]">The great American drives.</h1>
    <p class="mt-5 text-lg text-slate-400 max-w-2xl">The best routes, the famous stops, and a plan for each — then let Wanderply build your version and narrate every stop for the drive.</p>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
  <% if @road_trips.empty? %>
    <div class="rounded-2xl border border-dashed border-slate-700 bg-slate-900/30 p-16 text-center">
      <p class="text-slate-300 font-medium">No guides yet.</p>
    </div>
  <% else %>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% @road_trips.each do |rt| %>
        <%= link_to road_trip_path(rt.slug), class: "group rounded-3xl overflow-hidden border border-slate-800 bg-slate-900/40 hover:border-amber-500/40 transition-colors flex flex-col" do %>
          <div class="relative aspect-[16/10] bg-slate-800 overflow-hidden">
            <% if rt.hero_image_url.present? %>
              <img src="<%= rt.hero_image_url %>" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
            <% end %>
            <span class="absolute top-3 left-3 lp-mono inline-flex items-center px-2.5 py-1 rounded-full bg-slate-950/80 backdrop-blur text-[10px] uppercase tracking-widest font-semibold text-amber-200 border border-amber-500/30"><%= rt.corridor %></span>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <h2 class="font-display text-xl font-semibold tracking-tight leading-snug group-hover:text-amber-100 transition-colors"><%= rt.title %></h2>
            <% if rt.tagline.present? %>
              <p class="mt-2 text-sm text-slate-400 leading-relaxed line-clamp-3"><%= rt.tagline %></p>
            <% end %>
            <div class="mt-auto pt-4 flex items-center gap-3 text-xs text-slate-400">
              <% if rt.distance_label.present? %><span><%= rt.distance_label %></span><% end %>
              <% if rt.suggested_days.present? %><span aria-hidden="true">·</span><span><%= rt.suggested_days %> days</span><% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>

<% content_for :head do %>
  <%= render "shared/lp_styles" %>
<% end %>
