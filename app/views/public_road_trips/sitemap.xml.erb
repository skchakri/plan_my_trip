<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <url>
    <loc><%= road_trips_url %></loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
<% @road_trips.each do |rt| %>
  <url>
    <loc><%= road_trip_url(rt.slug) %></loc>
    <lastmod><%= rt.updated_at.utc.iso8601 %></lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    <% if rt.hero_image_url.present? %>
      <image:image>
        <image:loc><%= rt.hero_image_url %></image:loc>
        <image:title><%= rt.title.encode(xml: :text) %></image:title>
      </image:image>
    <% end %>
  </url>
<% end %>
</urlset>
