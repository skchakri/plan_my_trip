<% content_for :title, "#{@road_trip.title} · Wanderply" %>
<% light = @embed_theme == "light" %>
<% muted = light ? "text-slate-600" : "text-slate-400" %>
<% border = light ? "border-slate-200" : "border-slate-800" %>
<div class="p-4 font-sans">
  <a href="<%= road_trip_url(@road_trip.slug, utm_source: 'embed', utm_medium: 'widget') %>" target="_blank" rel="noopener" class="block group">
    <% if @road_trip.hero_image_url.present? %>
      <div class="relative aspect-[16/7] rounded-xl overflow-hidden bg-slate-800">
        <img src="<%= @road_trip.hero_image_url %>" alt="" class="absolute inset-0 w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 to-transparent"></div>
        <p class="absolute bottom-3 left-4 right-4 font-semibold text-lg text-white leading-tight"><%= @road_trip.title %></p>
      </div>
    <% else %>
      <p class="font-semibold text-lg leading-tight"><%= @road_trip.title %></p>
    <% end %>
  </a>
  <p class="mt-3 text-sm <%= muted %>"><%= [ @road_trip.distance_label, @road_trip.drive_time_label, (@road_trip.suggested_days ? "#{@road_trip.suggested_days} days" : nil) ].compact.join(" · ") %></p>
  <% if @road_trip.stops.any? %>
    <ol class="mt-3 space-y-1.5 text-sm">
      <% @road_trip.stops.first(6).each_with_index do |stop, i| %>
        <li class="flex gap-2.5"><span class="shrink-0 w-5 h-5 rounded-full bg-amber-500 text-slate-950 text-[11px] font-bold inline-flex items-center justify-center"><%= i + 1 %></span><span><span class="font-medium"><%= stop["name"] %></span><% if stop["blurb"].present? %> <span class="<%= muted %>">— <%= stop["blurb"].to_s.truncate(90) %></span><% end %></span></li>
      <% end %>
      <% if @road_trip.stops.size > 6 %><li class="text-xs <%= muted %> pl-7">+ <%= @road_trip.stops.size - 6 %> more stops</li><% end %>
    </ol>
  <% end %>
  <div class="mt-4 pt-3 border-t <%= border %> flex items-center justify-between gap-3">
    <a href="<%= road_trip_url(@road_trip.slug, utm_source: 'embed', utm_medium: 'widget') %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-semibold text-amber-500 hover:text-amber-400">Full guide &amp; hear it narrated &rarr;</a>
    <a href="<%= root_url(utm_source: 'embed', utm_medium: 'widget') %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs <%= muted %>"><%= image_tag "/icon.svg", alt: "", width: 16, height: 16, class: "rounded" %> Powered by Wanderply</a>
  </div>
</div>
