<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc><%= root_url %></loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc><%= about_url %></loc>
    <changefreq>monthly</changefreq>
  </url>
  <url>
    <loc><%= privacy_url %></loc>
    <changefreq>yearly</changefreq>
  </url>
  <url>
    <loc><%= blog_index_url %></loc>
    <changefreq>weekly</changefreq>
  </url>
  <% @posts.each do |post| %>
  <url>
    <loc><%= blog_url(post.slug) %></loc>
    <% if post.published_on %>
    <lastmod><%= post.published_on.iso8601 %></lastmod>
    <% end %>
    <changefreq>monthly</changefreq>
  </url>
  <% end %>
  <%# Curated road-trip guides — high-buyer-intent SEO landing pages. %>
  <url>
    <loc><%= road_trips_url %></loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <% @road_trips.each do |rt| %>
  <url>
    <loc><%= road_trip_url(rt.slug) %></loc>
    <lastmod><%= rt.updated_at.utc.iso8601 %></lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <% end %>
  <%# The trivia decks are public and are the app's widest organic surface —
      people search "guess the flag quiz" far more than "AI trip planner". %>
  <url>
    <loc><%= quizzes_url %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc><%= quiz_explore_url %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <% @quiz_keys.each do |key| %>
  <url>
    <loc><%= quiz_url(key) %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <% end %>
</urlset>
