<% content_for :title, "Trip invitation" %>

<div class="max-w-md mx-auto">
  <p class="text-xs uppercase tracking-widest text-slate-400 mb-1">You're invited</p>
  <h1 class="text-2xl font-semibold mb-2"><%= @invitation.inviter.display_name %> shared a trip with you</h1>
  <p class="text-slate-400 mb-6"><%= @invitation.inviter.display_name %> &lt;<%= @invitation.inviter.email %>&gt; wants you to see this plan. Add it to your trips?</p>

  <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5 mb-6">
    <h2 class="font-semibold text-lg mb-1"><%= @invitation.trip.title %></h2>
    <p class="text-sm text-slate-400">
      <% if @invitation.trip.destination.present? %><%= @invitation.trip.destination %><% end %>
      <% if @invitation.trip.start_date && @invitation.trip.end_date %>
        <% if @invitation.trip.destination.present? %> · <% end %>
        <%= @invitation.trip.start_date.strftime("%b %-d") %> – <%= @invitation.trip.end_date.strftime("%b %-d, %Y") %>
      <% end %>
    </p>
  </div>

  <div class="flex gap-3">
    <%= button_to "Add to my trips", accept_invitation_path(@invitation.token), method: :post, class: "flex-1 px-4 py-2.5 bg-amber-500 text-slate-900 rounded-md font-medium hover:bg-amber-400 cursor-pointer" %>
    <%= button_to "Decline", decline_invitation_path(@invitation.token), method: :delete, form: { data: { turbo_confirm: "Decline this invitation?" } }, class: "px-4 py-2.5 border border-slate-700 text-slate-300 rounded-md hover:border-rose-500/50 hover:text-rose-300 cursor-pointer" %>
  </div>
</div>
