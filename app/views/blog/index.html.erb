<% content_for :title, "Blog · Wanderply" %>

<section class="relative overflow-hidden">
  <div class="absolute inset-0"><div class="aurora"></div></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-12 sm:pt-40">
    <p class="text-[11px] uppercase tracking-[0.18em] text-amber-300 font-semibold">The blog</p>
    <h1 class="mt-3 font-display text-4xl sm:text-6xl font-semibold tracking-tight leading-[1.05]">Field notes from the road.</h1>
    <p class="mt-5 text-lg text-slate-400 max-w-2xl">Stories about why we built this, what works on long drives, and what to know before you visit the places we've planned.</p>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
  <% if @posts.empty? %>
    <div class="rounded-2xl border border-dashed border-slate-700 bg-slate-900/30 p-16 text-center">
      <p class="text-slate-300 font-medium">No posts yet.</p>
      <p class="text-sm text-slate-400 mt-1">Stories from the road are on the way.</p>
    </div>
  <% else %>
    <%# Featured post (first) %>
    <% featured = @posts.first %>
    <%= link_to blog_path(featured), class: "group block mb-12 rounded-3xl overflow-hidden border border-slate-800 bg-slate-900/40 hover:border-amber-500/40 transition-colors" do %>
      <div class="grid md:grid-cols-2 gap-0">
        <div class="relative aspect-[16/10] md:aspect-auto md:min-h-[360px] bg-slate-800 overflow-hidden">
          <% if featured.cover.present? %>
            <img src="<%= featured.cover %>" alt="" loading="eager" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
          <% end %>
          <div class="absolute top-4 left-4">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500 text-slate-950 text-[10px] uppercase tracking-widest font-bold">
              <%= icon :sparkles, class: "w-3 h-3" %> Featured
            </span>
          </div>
        </div>
        <div class="p-6 sm:p-10 flex flex-col justify-center">
          <% if featured.tag.present? %>
            <p class="text-[11px] uppercase tracking-[0.18em] text-amber-300 font-semibold mb-3"><%= featured.tag %></p>
          <% end %>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight leading-tight group-hover:text-amber-100 transition-colors"><%= featured.title %></h2>
          <% if featured.excerpt.present? %>
            <p class="mt-3 text-slate-400 leading-relaxed"><%= featured.excerpt %></p>
          <% end %>
          <div class="mt-5 flex items-center gap-3 text-xs text-slate-400">
            <% if featured.author.present? %><span><%= featured.author %></span><span aria-hidden="true">·</span><% end %>
            <% if featured.published_on.present? %><time datetime="<%= featured.published_on.iso8601 %>"><%= featured.published_on.strftime("%B %-d, %Y") %></time><span aria-hidden="true">·</span><% end %>
            <% if featured.reading_minutes.present? %><span><%= featured.reading_minutes %> min read</span><% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Remaining posts as a grid %>
    <% rest = @posts.drop(1) %>
    <% if rest.any? %>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% rest.each do |post| %>
          <%= link_to blog_path(post), class: "group rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/40 hover:border-amber-500/40 transition-colors flex flex-col" do %>
            <div class="relative aspect-[16/10] bg-slate-800 overflow-hidden">
              <% if post.cover.present? %>
                <img src="<%= post.cover %>" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
              <% end %>
              <% if post.tag.present? %>
                <span class="absolute top-3 left-3 inline-flex items-center px-2 py-0.5 rounded-full bg-slate-950/80 backdrop-blur text-[10px] uppercase tracking-widest font-semibold text-amber-200 border border-amber-500/30"><%= post.tag %></span>
              <% end %>
            </div>
            <div class="p-5 flex-1 flex flex-col">
              <h3 class="font-display text-xl font-semibold tracking-tight leading-snug group-hover:text-amber-100 transition-colors"><%= post.title %></h3>
              <% if post.excerpt.present? %>
                <p class="mt-2 text-sm text-slate-400 leading-relaxed line-clamp-3"><%= post.excerpt %></p>
              <% end %>
              <div class="mt-auto pt-4 flex items-center gap-2 text-xs text-slate-400">
                <% if post.published_on.present? %><time datetime="<%= post.published_on.iso8601 %>"><%= post.published_on.strftime("%b %-d, %Y") %></time><% end %>
                <% if post.reading_minutes.present? %><span aria-hidden="true">·</span><span><%= post.reading_minutes %> min</span><% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
