<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Plan My Trip" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="application-name" content="Plan My Trip">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0a0e1a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script nonce="<%= content_security_policy_nonce %>">
      // Register the PWA service worker for offline support
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("<%= pwa_service_worker_path(format: :js) %>", { scope: "/" })
            .catch((err) => console.warn("[pmt] SW registration failed:", err));
        });
      }
    </script>

    <style>
      :root { --font-sans: 'Inter', system-ui, sans-serif; --font-display: 'Fraunces', Georgia, serif; }
      html, body { font-family: var(--font-sans); font-feature-settings: 'cv11', 'ss01'; font-synthesis-weight: none; }
      .font-display { font-family: var(--font-display); letter-spacing: -0.02em; font-synthesis-weight: none; }
      *:focus-visible { outline: 2px solid #f0b870; outline-offset: 2px; border-radius: 6px; }
      input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; }
      .bg-noise { background-image: radial-gradient(rgba(232,160,79,0.04) 1px, transparent 1px); background-size: 24px 24px; }

      /* Hide Turbo's default top progress bar — replaced by centered spinner. */
      .turbo-progress-bar { display: none !important; }

      /* Centered spinner overlay shown during slow Turbo navigations. */
      .pmt-loading-overlay {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        background: rgba(10, 14, 26, 0.55); backdrop-filter: blur(4px);
        opacity: 0; pointer-events: none; transition: opacity 180ms ease;
      }
      .pmt-loading-overlay.is-visible { opacity: 1; pointer-events: auto; }
      .pmt-loading-ring {
        width: 56px; height: 56px; border-radius: 50%;
        background:
          conic-gradient(from 0deg, transparent 0deg, #f0b870 90deg, #fbbf24 270deg, transparent 360deg);
        -webkit-mask: radial-gradient(circle at center, transparent 58%, #000 60%);
                mask: radial-gradient(circle at center, transparent 58%, #000 60%);
        animation: pmt-spin 900ms linear infinite;
        filter: drop-shadow(0 0 12px rgba(240, 184, 112, 0.35));
      }
      @keyframes pmt-spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) {
        .pmt-loading-ring { animation-duration: 2400ms; }
        .pmt-loading-overlay { transition: none; }
      }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    </style>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-full antialiased <%= 'hotwire-native' if hotwire_native_app? %>">
    <%= render "layouts/loading_overlay" %>

    <% unless hotwire_native_app? %>
      <header class="sticky top-0 inset-x-0 z-30 border-b border-slate-800/70 bg-slate-950/80 backdrop-blur-xl">
        <%= render "layouts/site_nav" %>
      </header>
    <% end %>

    <div data-controller="network-status" hidden role="status"
         class="sticky top-0 z-40 bg-amber-500/15 border-b border-amber-500/30 text-amber-100 text-sm text-center px-4 py-2">
      <span class="inline-flex items-center gap-1.5"><%= icon :alert_triangle, class: "w-4 h-4" %> You're offline — saved pages still work, but new changes won't save until you reconnect.</span>
    </div>

    <div id="toast-stack" data-controller="toasts" data-action="toast@window->toasts#show"
         class="fixed z-[60] bottom-20 sm:bottom-6 inset-x-4 sm:inset-x-auto sm:right-6 flex flex-col gap-2 pointer-events-none" aria-live="polite">
      <%= render "layouts/flash" %>
    </div>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10 pb-24 sm:pb-12">
      <%= yield %>
    </main>

    <% if user_signed_in? && !hotwire_native_app? %>
      <nav class="sm:hidden fixed bottom-0 inset-x-0 z-30 border-t border-slate-800 bg-slate-950/95 backdrop-blur-xl pb-[env(safe-area-inset-bottom)]" aria-label="Primary">
        <div class="grid grid-cols-3 px-2 py-2">
          <%= link_to trips_path, aria: { current: (controller_name == 'trips' && action_name == 'index') ? "page" : nil }, class: "flex flex-col items-center gap-0.5 py-1.5 rounded-md #{(controller_name == 'trips' && action_name == 'index') ? 'text-amber-300' : 'text-slate-400 hover:text-white'}" do %>
            <%= icon :list, class: "w-5 h-5" %><span class="text-[10px] font-medium">Trips</span>
          <% end %>
          <%= link_to new_trip_path, aria: { current: action_name == 'new' ? "page" : nil }, class: "flex flex-col items-center gap-0.5 py-1.5 rounded-md #{action_name == 'new' ? 'text-amber-300' : 'text-slate-400 hover:text-white'}" do %>
            <%= icon :plus, class: "w-5 h-5" %><span class="text-[10px] font-medium">New</span>
          <% end %>
          <%= link_to edit_user_registration_path, aria: { current: controller_name == 'registrations' ? "page" : nil }, class: "flex flex-col items-center gap-0.5 py-1.5 rounded-md #{controller_name == 'registrations' ? 'text-amber-300' : 'text-slate-400 hover:text-white'}" do %>
            <%= icon :user_circle, class: "w-5 h-5" %><span class="text-[10px] font-medium">Account</span>
          <% end %>
        </div>
      </nav>
    <% end %>
  </body>
</html>
