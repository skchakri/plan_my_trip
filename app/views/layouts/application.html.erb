<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Plan My Trip" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Plan My Trip">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen <%= 'hotwire-native' if hotwire_native_app? %>">
    <% unless hotwire_native_app? %>
    <header class="border-b border-slate-800 bg-slate-900/60 backdrop-blur sticky top-0 z-30">
      <div class="max-w-3xl mx-auto px-5 py-3 flex items-center justify-between">
        <%= link_to root_path, class: "flex items-center gap-2 font-semibold tracking-tight text-amber-300" do %>
          <%= image_tag "/icon.svg", alt: "", width: 28, height: 28, class: "rounded-md" %>
          <span>Plan My Trip</span>
        <% end %>
        <nav class="flex items-center gap-4 text-sm">
          <% if user_signed_in? %>
            <span class="text-slate-400 hidden sm:inline">Hi, <%= current_user.display_name %></span>
            <%= link_to "Account", edit_user_registration_path, class: "text-slate-300 hover:text-white" %>
            <%= link_to "New trip", new_trip_path, class: "px-3 py-1.5 bg-amber-500 text-slate-900 rounded-md font-medium hover:bg-amber-400" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, form: { data: { turbo: false } }, class: "text-slate-300 hover:text-white" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-slate-300 hover:text-white" %>
            <%= link_to "Sign up", new_user_registration_path, class: "px-3 py-1.5 bg-amber-500 text-slate-900 rounded-md font-medium hover:bg-amber-400" %>
          <% end %>
        </nav>
      </div>
    </header>
    <% end %>

    <% if notice.present? %>
      <div class="max-w-3xl mx-auto px-5 mt-4">
        <div class="rounded-md bg-emerald-500/10 border border-emerald-500/30 text-emerald-200 px-4 py-2 text-sm"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-3xl mx-auto px-5 mt-4">
        <div class="rounded-md bg-rose-500/10 border border-rose-500/30 text-rose-200 px-4 py-2 text-sm"><%= alert %></div>
      </div>
    <% end %>

    <main class="max-w-3xl mx-auto px-5 py-8">
      <%= yield %>
    </main>
  </body>
</html>
