<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Wanderply · trips your crew will remember" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#0a0e1a">
    <% seo_title       = content_for(:title).presence || "Wanderply · trips your crew will remember" %>
    <% seo_description = content_for(:description).presence || "Day-by-day itineraries, drive-time games, podcast-style narration, and an offline PWA — Wanderply turns a road trip into a story." %>
    <% seo_image       = content_for(:og_image).presence || default_og_image_url %>
    <meta name="description" content="<%= seo_description %>">

    <%# ── SEO: canonical + social cards (views override via content_for
        :canonical / :og_type / :og_image) ─────────────────────────── %>
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:site_name"   content="Wanderply">
    <meta property="og:type"        content="<%= content_for(:og_type).presence || 'website' %>">
    <meta property="og:title"       content="<%= seo_title %>">
    <meta property="og:description" content="<%= seo_description %>">
    <meta property="og:url"         content="<%= canonical_url %>">
    <meta property="og:image"       content="<%= seo_image %>">
    <%# Default og-card.png and all per-page images (place photos, blog
        covers) are wide, so the large card is always right. %>
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="<%= seo_title %>">
    <meta name="twitter:description" content="<%= seo_description %>">
    <meta name="twitter:image"       content="<%= seo_image %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      :root { --font-sans: 'Inter', system-ui, sans-serif; --font-display: 'Fraunces', Georgia, serif; }
      html, body { font-family: var(--font-sans); font-feature-settings: 'cv11', 'ss01'; font-synthesis-weight: none; }
      .font-display { font-family: var(--font-display); letter-spacing: -0.02em; font-synthesis-weight: none; }
      *:focus-visible { outline: 2px solid #f0b870; outline-offset: 2px; border-radius: 6px; }
      input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; }

      /* Aurora hero background */
      .aurora { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
      .aurora::before, .aurora::after {
        content: ""; position: absolute; border-radius: 9999px; filter: blur(80px); opacity: 0.55;
        animation: drift 18s ease-in-out infinite alternate;
      }
      .aurora::before { width: 620px; height: 620px; background: radial-gradient(circle, rgba(232,160,79,.55), transparent 60%); top: -120px; left: -80px; }
      .aurora::after  { width: 720px; height: 720px; background: radial-gradient(circle, rgba(93,195,184,.45), transparent 60%); top: 80px; right: -120px; animation-delay: -6s; }
      @keyframes drift { from { transform: translate3d(0,0,0); } to { transform: translate3d(40px, -30px, 0); } }
      @media (prefers-reduced-motion: reduce) { .aurora::before, .aurora::after { animation: none; } }

      /* Subtle starfield noise */
      .grain { background-image: radial-gradient(rgba(255,255,255,.05) 1px, transparent 1px); background-size: 24px 24px; }

      /* Marquee logos row */
      .marquee { mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%); }

      /* Hide Turbo's top progress bar — replaced by centered spinner overlay. */
      .turbo-progress-bar { display: none !important; }
      .pmt-loading-overlay {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        background: rgba(10, 14, 26, 0.55); backdrop-filter: blur(4px);
        opacity: 0; pointer-events: none; transition: opacity 180ms ease;
      }
      .pmt-loading-overlay.is-visible { opacity: 1; pointer-events: auto; }
      .pmt-loading-ring {
        width: 56px; height: 56px; border-radius: 50%;
        background: conic-gradient(from 0deg, transparent 0deg, #f0b870 90deg, #fbbf24 270deg, transparent 360deg);
        -webkit-mask: radial-gradient(circle at center, transparent 58%, #000 60%);
                mask: radial-gradient(circle at center, transparent 58%, #000 60%);
        animation: pmt-spin 900ms linear infinite;
        filter: drop-shadow(0 0 12px rgba(240, 184, 112, 0.35));
      }
      @keyframes pmt-spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) {
        .pmt-loading-ring { animation-duration: 2400ms; }
        .pmt-loading-overlay { transition: none; }
      }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    </style>
  </head>

  <body class="bg-slate-950 text-slate-100 antialiased min-h-full flex flex-col">
    <%= render "layouts/loading_overlay" %>

    <%# ── Top nav — `absolute` so it overlays the aurora hero. Same
        contents as the in-app sticky header (shared partial). %>
    <header class="absolute top-0 inset-x-0 z-30">
      <%= render "layouts/site_nav" %>
    </header>

    <%# ── Flash ────────────────────────────────────────────────── %>
    <% if notice.present? %>
      <div class="fixed top-20 inset-x-0 z-40 px-4 flex justify-center pointer-events-none">
        <div role="status" class="pointer-events-auto rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-100 backdrop-blur px-4 py-2.5 text-sm flex items-start gap-2 shadow-xl">
          <%= icon :check, class: "w-4 h-4 mt-0.5 shrink-0" %><span><%= notice %></span>
        </div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="fixed top-20 inset-x-0 z-40 px-4 flex justify-center pointer-events-none">
        <div role="alert" class="pointer-events-auto rounded-lg bg-rose-500/15 border border-rose-500/30 text-rose-100 backdrop-blur px-4 py-2.5 text-sm shadow-xl"><%= alert %></div>
      </div>
    <% end %>

    <main class="flex-1"><%= yield %></main>

    <%# ── Footer ───────────────────────────────────────────────── %>
    <footer class="mt-16 border-t border-slate-800/80 bg-slate-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <div class="flex items-center gap-2.5">
            <%= image_tag "/icon.svg", alt: "", width: 28, height: 28, class: "rounded-md" %>
            <span class="text-sm font-semibold tracking-tight bg-gradient-to-r from-amber-200 to-amber-400 bg-clip-text text-transparent">Wanderply</span>
          </div>
          <p class="mt-3 text-sm text-slate-400 max-w-xs">Trips your whole crew will remember — day-by-day plans, drive-time games, and a podcast for the road.</p>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-widest text-slate-400 mb-3">Product</h3>
          <ul class="space-y-2 text-sm">
            <li><%= link_to "Why Wanderply", root_path(anchor: "features"), class: "text-slate-300 hover:text-amber-300" %></li>
            <li><%= link_to "How it works",     root_path(anchor: "how"),      class: "text-slate-300 hover:text-amber-300" %></li>
            <% if user_signed_in? %>
              <li><%= link_to "Open my trips",  trips_path,                    class: "text-slate-300 hover:text-amber-300" %></li>
            <% else %>
              <li><%= link_to "Sign up",        new_user_registration_path,    class: "text-slate-300 hover:text-amber-300" %></li>
              <li><%= link_to "Sign in",        new_user_session_path,         class: "text-slate-300 hover:text-amber-300" %></li>
            <% end %>
          </ul>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-widest text-slate-400 mb-3">Read</h3>
          <ul class="space-y-2 text-sm">
            <li><%= link_to "Blog",     blog_index_path, class: "text-slate-300 hover:text-amber-300" %></li>
            <li><%= link_to "About",    about_path,      class: "text-slate-300 hover:text-amber-300" %></li>
            <li><%= link_to "Privacy",  privacy_path,    class: "text-slate-300 hover:text-amber-300" %></li>
            <li><a href="/sample-trips.html" class="text-slate-300 hover:text-amber-300">Static itineraries</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-widest text-slate-400 mb-3">Get it on your phone</h3>
          <p class="text-sm text-slate-400">Add to your home screen — works offline once you've visited each page.</p>
          <p class="mt-3 text-xs text-slate-400">© <%= Date.current.year %> Wanderply. Made for road trips.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
