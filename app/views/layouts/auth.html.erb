<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Wanderply" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#0a0e1a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      :root { --font-sans: 'Inter', system-ui, sans-serif; --font-display: 'Fraunces', Georgia, serif; }
      html, body { font-family: var(--font-sans); }
      .font-display { font-family: var(--font-display); letter-spacing: -0.02em; }
      *:focus-visible { outline: 2px solid #f0b870; outline-offset: 2px; border-radius: 6px; }
      input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; }

      .aurora { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
      .aurora::before, .aurora::after {
        content: ""; position: absolute; border-radius: 9999px; filter: blur(80px); opacity: 0.55;
        animation: drift 18s ease-in-out infinite alternate;
      }
      .aurora::before { width: 520px; height: 520px; background: radial-gradient(circle, rgba(232,160,79,.55), transparent 60%); top: -120px; left: -80px; }
      .aurora::after  { width: 620px; height: 620px; background: radial-gradient(circle, rgba(93,195,184,.45), transparent 60%); bottom: -120px; right: -120px; animation-delay: -6s; }
      @keyframes drift { from { transform: translate3d(0,0,0); } to { transform: translate3d(40px, -30px, 0); } }
      @media (prefers-reduced-motion: reduce) { .aurora::before, .aurora::after { animation: none; } }
    </style>

    <%= render "layouts/analytics" %>
  </head>

  <body class="bg-slate-950 text-slate-100 antialiased min-h-full">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-amber-500 focus:text-slate-950 focus:font-semibold">Skip to content</a>
    <div id="toast-stack" data-controller="toasts" data-action="toast@window->toasts#show"
         class="fixed z-[60] bottom-6 inset-x-4 sm:inset-x-auto sm:right-6 flex flex-col gap-2 pointer-events-none" aria-live="polite">
      <%= render "layouts/flash" %>
    </div>

    <main id="main"><%= yield %></main>
  </body>
</html>
