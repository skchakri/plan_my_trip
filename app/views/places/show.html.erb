<% content_for :title, "#{@place.name} · place" %>

<div class="mb-5">
  <%= link_to root_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> Home
  <% end %>
</div>

<article class="rounded-3xl border border-slate-800 overflow-hidden bg-slate-900/50">
  <%# Hero — full-width image with name + kind chip overlaid %>
  <% if @place.image_url.present? %>
    <div class="relative aspect-[21/10] sm:aspect-[21/9] bg-slate-800 overflow-hidden">
      <img loading="lazy" src="<%= @place.image_url %>" alt="<%= @place.name %>" class="w-full h-full object-cover" referrerpolicy="no-referrer">
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
      <div class="absolute left-5 sm:left-8 right-5 sm:right-8 bottom-5 sm:bottom-8">
        <% if @place.kind.present? %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] uppercase tracking-widest font-semibold bg-amber-500/20 backdrop-blur-sm border border-amber-500/40 text-amber-100 mb-2"><%= @place.kind.tr("_", " ") %></span>
        <% end %>
        <h1 class="font-display text-3xl sm:text-5xl font-semibold tracking-tight text-white leading-tight drop-shadow"><%= @place.name %></h1>
      </div>
    </div>
  <% else %>
    <div class="px-5 sm:px-8 py-8 bg-gradient-to-br from-slate-800 to-slate-900">
      <% if @place.kind.present? %>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] uppercase tracking-widest font-semibold bg-amber-500/15 border border-amber-500/30 text-amber-200 mb-2"><%= @place.kind.tr("_", " ") %></span>
      <% end %>
      <h1 class="font-display text-3xl sm:text-5xl font-semibold tracking-tight text-slate-50 leading-tight"><%= @place.name %></h1>
    </div>
  <% end %>

  <div class="px-5 sm:px-8 py-6 space-y-6">
    <%# Stats strip %>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="rounded-xl border border-amber-500/20 bg-amber-500/[0.04] p-3">
        <p class="text-[10px] uppercase tracking-widest text-amber-300 font-semibold flex items-center gap-1.5">
          <%= icon :star, class: "w-3 h-3 text-amber-400 fill-current" %>Community rating
        </p>
        <div class="flex items-center gap-2 mt-1.5">
          <%= star_row(@place.community_rating || 0, klass: "w-3.5 h-3.5") %>
        </div>
        <p class="text-xs mt-1"><%= rating_caption(@place.community_rating, @place.community_rating_count) %></p>
      </div>
      <% [
        [ "Used in trips", @place.usage_count, :sparkles ],
        [ "Kind",          @place.kind || "—", :list ],
        [ "Coordinates",   @place.latitude && @place.longitude ? "#{@place.latitude.to_f.round(4)}, #{@place.longitude.to_f.round(4)}" : "—", :map_pin ]
      ].each do |label, value, icon_name| %>
        <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-3">
          <p class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold flex items-center gap-1.5">
            <%= icon icon_name, class: "w-3 h-3 text-amber-400" %><%= label %>
          </p>
          <p class="text-sm text-slate-100 mt-1 tabular-nums truncate"><%= value %></p>
        </div>
      <% end %>
    </div>

    <%# Famous-for hook %>
    <% if @place.famous_for.present? %>
      <div class="rounded-2xl border border-amber-500/20 bg-amber-500/[0.04] p-4 flex items-start gap-3">
        <span class="shrink-0 mt-0.5 text-amber-300"><%= icon :sparkles, class: "w-5 h-5" %></span>
        <div>
          <p class="text-[11px] uppercase tracking-widest text-amber-300 font-semibold mb-1">Famous for</p>
          <p class="text-slate-100 leading-relaxed"><%= @place.famous_for %></p>
        </div>
      </div>
    <% end %>

    <%# Description %>
    <% if @place.description.present? %>
      <div>
        <p class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold mb-2">About this place</p>
        <p class="text-base text-slate-200 leading-relaxed"><%= @place.description %></p>
      </div>
    <% end %>

    <%# Click-to-load rich detail: best time to go, things to do, pro tips.
        AI-backed (HighlightDetail, 30-day cache) — only fetched on demand. %>
    <%= turbo_frame_tag "place-more-info", class: "block aria-busy:opacity-60 aria-busy:animate-pulse",
          data: { controller: "frame-timeout", frame_timeout_timeout_value: 45000 } do %>
      <%= link_to more_info_place_path(@place.slug.presence || @place.id),
                  class: "w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-amber-500/30 bg-amber-500/10 hover:bg-amber-500/20 text-amber-200 text-sm font-semibold transition-colors" do %>
        <%= icon :sparkles, class: "w-4 h-4" %>
        More about this place — best time, things to do, tips
      <% end %>
    <% end %>

    <%# Open in Maps + image attribution %>
    <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-slate-800">
      <% if @place.latitude && @place.longitude %>
        <%= link_to "https://www.google.com/maps/dir/?api=1&destination=#{@place.latitude.to_f},#{@place.longitude.to_f}&travelmode=driving", target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-amber-500 text-slate-950 font-semibold text-sm hover:bg-amber-400" do %>
          <%= icon :map_pin, class: "w-4 h-4" %> Directions
        <% end %>
        <%= link_to "https://www.google.com/maps/search/?api=1&query=#{@place.latitude.to_f},#{@place.longitude.to_f}", target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-700 hover:border-amber-500/50 text-slate-200 text-sm" do %>
          Open in Maps <%= icon :external_link, class: "w-3.5 h-3.5" %>
        <% end %>
      <% end %>
      <% if @place.image_attribution.present? %>
        <p class="text-[11px] text-slate-400 ml-auto"><%= @place.image_attribution %></p>
      <% end %>
    </div>

    <%# Visiting from current user's trips %>
    <% if @visiting_activities.any? %>
      <section class="pt-3 border-t border-slate-800">
        <p class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold mb-3">On your trips</p>
        <ul class="space-y-2">
          <% @visiting_activities.each do |a| %>
            <li class="rounded-xl border border-slate-800 bg-slate-900/40 p-3 flex items-center justify-between gap-3 hover:border-amber-500/40 transition-colors">
              <div class="min-w-0">
                <p class="text-sm text-slate-100 font-medium truncate"><%= a.title %></p>
                <p class="text-xs text-slate-400 mt-0.5 truncate">
                  <%= a.trip.title_for(current_user) %>
                  <% if a.trip_day.date %> · <%= a.trip_day.date.strftime("%a %b %-d") %><% end %>
                  <% if a.time_label.present? %> · <%= a.time_label %><% end %>
                </p>
              </div>
              <%= link_to plan_trip_path(a.trip, anchor: "day-#{a.trip_day.id}"), class: "shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs text-amber-300 hover:text-amber-200 border border-slate-700 hover:border-amber-500/40" do %>
                Open <%= icon :arrow_right, class: "w-3 h-3" %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <% if @other_trip_count > 0 %>
          <p class="text-xs text-slate-400 mt-3 italic">Also visited by <%= pluralize(@other_trip_count, "other trip") %> across Wanderply travelers.</p>
        <% end %>
      </section>
    <% elsif @total_visits > 0 %>
      <section class="pt-3 border-t border-slate-800">
        <p class="text-sm text-slate-400 italic">Visited by <%= pluralize(@total_visits, "trip") %> on Wanderply — none of yours yet.</p>
      </section>
    <% end %>

    <%# Contributor credit %>
    <% if @place.contributed_by %>
      <p class="text-[11px] text-slate-400">First catalogued by <span class="text-slate-400"><%= @place.contributed_by.display_name.presence || @place.contributed_by.email %></span> on <%= @place.created_at.strftime("%b %-d, %Y") %>.</p>
    <% end %>

    <%# Ratings & reviews thread %>
    <section class="pt-5 mt-3 border-t border-slate-800" id="reviews">
      <div class="flex items-baseline justify-between gap-3 mb-4">
        <h2 class="font-display text-xl font-semibold text-slate-100">Ratings &amp; reviews</h2>
        <span class="text-xs text-slate-400"><%= rating_caption(@place.community_rating, @place.community_rating_count) %></span>
      </div>

      <%# My review — write or edit %>
      <%= form_with model: (@my_review || PlaceReview.new), url: place_reviews_path(@place.slug.presence || @place.id), local: true, html: { class: "rounded-2xl border border-slate-800 bg-slate-900/40 p-4 sm:p-5 mb-5" } do |f| %>
        <p class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold mb-3">
          <%= @my_review ? "Update your review" : "Write a review" %>
        </p>
        <div data-controller="star-input" data-star-input-value-value="<%= @my_review&.rating || 0 %>" class="flex items-center gap-2 mb-3">
          <%= f.hidden_field :rating, data: { star_input_target: "input" } %>
          <% 1.upto(5) do |n| %>
            <button type="button"
                    data-action="click->star-input#select mouseenter->star-input#preview mouseleave->star-input#reset"
                    data-value="<%= n %>"
                    data-star-input-target="star"
                    aria-label="Rate <%= n %>"
                    class="text-slate-700 hover:text-amber-300 transition-colors cursor-pointer">
              <%= icon :star, class: "w-7 h-7 fill-current" %>
            </button>
          <% end %>
          <span data-star-input-target="label" class="text-sm text-slate-400 ml-2"></span>
        </div>
        <%= f.text_area :body, rows: 3, placeholder: "What stood out? Practical tips? (optional)",
              class: "w-full rounded-lg bg-slate-950/60 border border-slate-700 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:outline-none focus:border-amber-500/60" %>
        <div class="flex items-center justify-between mt-3 gap-2">
          <% if @my_review %>
            <%= button_to "Remove my review",
                  place_review_path(@place.slug.presence || @place.id, @my_review),
                  method: :delete,
                  class: "text-xs text-slate-400 hover:text-rose-300 cursor-pointer",
                  data: { turbo_confirm: "Remove your review?" } %>
          <% else %>
            <span></span>
          <% end %>
          <%= f.submit(@my_review ? "Update" : "Post review",
                class: "inline-flex items-center px-4 py-2 rounded-lg bg-amber-500 text-slate-950 font-semibold text-sm shadow-lg shadow-amber-500/20 hover:bg-amber-400 cursor-pointer") %>
        </div>
      <% end %>

      <%# Others' reviews %>
      <% others = @reviews.reject { |r| r.author_id == current_user.id } %>
      <% if others.any? %>
        <ul class="space-y-3">
          <% others.each do |r| %>
            <li class="rounded-2xl border border-slate-800 bg-slate-900/30 p-4">
              <div class="flex items-center justify-between gap-3 mb-1.5">
                <div class="flex items-center gap-2">
                  <%= star_row(r.rating, klass: "w-3.5 h-3.5") %>
                  <span class="text-sm font-medium text-slate-200"><%= r.author.display_name.presence || r.author.email.split("@").first %></span>
                </div>
                <span class="text-[11px] text-slate-400 tabular-nums"><%= time_ago_in_words(r.created_at) %> ago</span>
              </div>
              <% if r.body.present? %>
                <p class="text-sm text-slate-300 leading-relaxed mt-1"><%= simple_format(r.body) %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% elsif @my_review.nil? %>
        <p class="text-sm text-slate-400 italic">Be the first to rate this place — your stars will help everyone planning a trip here.</p>
      <% end %>
    </section>
  </div>
</article>
