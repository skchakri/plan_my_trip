<%# Per-day suggestion board with thumbs-up voting. Embedded in the plan
    view inside each day card so the group can crowdsource alternatives
    without leaving the page. %>
<section class="mt-4 rounded-xl border border-slate-800/80 bg-slate-900/30 p-3 sm:p-4">
  <details <%= "open" if trip_day.suggestions.any? %>>
    <summary class="cursor-pointer list-none inline-flex items-center gap-2 text-xs uppercase tracking-wider text-slate-400 hover:text-amber-300 transition-colors">
      <%= icon :sparkles, class: "w-3.5 h-3.5" %>
      <% n = trip_day.suggestions.size %>
      <%= n.zero? ? "Suggest something for this day" : "#{pluralize(n, "suggestion")} · vote on what to do" %>
    </summary>
    <ul id="day-<%= trip_day.id %>-suggestions" class="mt-3 space-y-2">
      <% trip_day.suggestions.each do |s| %>
        <%= render "suggestions/suggestion", suggestion: s %>
      <% end %>
    </ul>
    <%= render "suggestions/form", trip: trip, trip_day: trip_day, suggestion: trip_day.suggestions.build %>
  </details>
</section>
