<% voted = suggestion.voted_by?(current_user) %>
<li id="suggestion-<%= suggestion.id %>"
    class="group flex items-start gap-3 px-3 py-2.5 rounded-lg <%= voted ? 'bg-amber-500/10 border border-amber-500/30' : 'bg-slate-800/40 border border-slate-700/50' %>">
  <%= button_to vote_trip_trip_day_suggestion_path(suggestion.trip, suggestion.trip_day, suggestion),
        method: :post,
        form: { class: "shrink-0", data: { turbo: true } },
        class: "inline-flex flex-col items-center justify-center w-12 py-1 rounded-md #{voted ? 'bg-amber-500/30 text-amber-100 border border-amber-500/50' : 'bg-slate-900/60 text-slate-300 border border-slate-700 hover:border-amber-500/40'} transition-colors",
        title: voted ? "Remove your vote" : "Vote for this" do %>
    <span class="text-xs leading-none">▲</span>
    <span class="text-sm font-bold tabular-nums leading-tight"><%= suggestion.vote_count %></span>
  <% end %>

  <div class="min-w-0 flex-1">
    <div class="flex items-baseline gap-2 flex-wrap">
      <% if suggestion.url.present? %>
        <%= link_to suggestion.title, suggestion.url, target: "_blank", rel: "noopener",
              class: "text-slate-100 font-medium hover:text-amber-300 transition-colors inline-flex items-center gap-1" %>
        <%= icon :external_link, class: "w-3 h-3 text-slate-500" %>
      <% else %>
        <span class="text-slate-100 font-medium"><%= suggestion.title %></span>
      <% end %>
      <span class="text-[11px] text-slate-500">by <%= suggestion.author.display_name %></span>
      <% if suggestion.author_id == current_user.id || suggestion.trip.owner_id == current_user.id %>
        <%= button_to trip_trip_day_suggestion_path(suggestion.trip, suggestion.trip_day, suggestion),
              method: :delete,
              form: { data: { turbo_confirm: "Delete this suggestion?" }, class: "inline ml-auto opacity-0 group-hover:opacity-100 transition-opacity" },
              class: "text-[11px] text-slate-500 hover:text-rose-300" do %>
          Delete
        <% end %>
      <% end %>
    </div>
    <% if suggestion.notes.present? %>
      <p class="mt-1 text-sm text-slate-400 leading-relaxed whitespace-pre-line"><%= suggestion.notes %></p>
    <% end %>
  </div>
</li>
