<div id="day-<%= trip_day.id %>-suggestion-form" class="mt-3">
  <%= form_with model: [ trip, trip_day, suggestion ],
        url: trip_trip_day_suggestions_path(trip, trip_day),
        local: false,
        class: "grid gap-2" do |f| %>
    <div class="flex gap-2">
      <%= f.text_field :title,
            placeholder: "Suggest a spot — 'Cottonwood Steakhouse for dinner?'",
            required: true,
            class: "flex-1 min-w-0 px-3 py-2 rounded-lg bg-slate-950/60 border border-slate-700 text-sm text-slate-100 placeholder-slate-500 focus:border-amber-500/60 outline-none" %>
      <%= f.submit "Suggest",
            class: "shrink-0 px-3 py-2 rounded-lg bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 transition-colors" %>
    </div>
    <details>
      <summary class="cursor-pointer text-[11px] uppercase tracking-wider text-slate-400 hover:text-amber-300 list-none">+ Link or notes</summary>
      <div class="mt-2 grid gap-2">
        <%= f.url_field :url, placeholder: "Link (optional)",
              class: "px-3 py-2 rounded-lg bg-slate-950/60 border border-slate-700 text-sm text-slate-100 placeholder-slate-500 outline-none" %>
        <%= f.text_area :notes, rows: 2, placeholder: "Why this place? (optional)",
              class: "px-3 py-2 rounded-lg bg-slate-950/60 border border-slate-700 text-sm text-slate-100 placeholder-slate-500 outline-none resize-none" %>
      </div>
    </details>
  <% end %>
  <% if suggestion.errors.any? %>
    <p class="mt-1 text-xs text-rose-300"><%= suggestion.errors.full_messages.to_sentence %></p>
  <% end %>
</div>
