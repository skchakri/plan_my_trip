<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f6f7fb; margin: 0; padding: 0; color: #1f2540; }
    .container { max-width: 540px; margin: 32px auto; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 8px 32px rgba(15,20,40,.08); }
    .head { padding: 28px 32px 18px; background: linear-gradient(135deg, #16213e, #0f1424); color: #f4f1e8; }
    .eyebrow { font-size: 11px; letter-spacing: 0.18em; color: #e8a04f; text-transform: uppercase; font-weight: 700; }
    .title { font-size: 22px; font-weight: 600; margin-top: 6px; }
    .body { padding: 24px 32px 32px; font-size: 15px; line-height: 1.55; }
    .card { border: 1px solid #e1e4ee; border-radius: 12px; padding: 16px; background: #f9faff; margin: 18px 0; }
    .card .name { font-weight: 600; font-size: 16px; margin-bottom: 4px; }
    .card .meta { color: #6b7390; font-size: 13px; }
    .cta { display: inline-block; background: #e8a04f; color: #0a0e1a; text-decoration: none; padding: 12px 22px; border-radius: 8px; font-weight: 600; margin: 6px 8px 0 0; }
    .cta.secondary { background: #eef1f9; color: #1f2540; }
    .small { font-size: 12px; color: #8a90a8; margin-top: 22px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="head">
      <div class="eyebrow">Plan My Trip</div>
      <div class="title">
        <% if @days_out == 1 %>
          Tomorrow's the day — <%= @trip.title %>
        <% else %>
          <%= @days_out %> days until <%= @trip.title %>
        <% end %>
      </div>
    </div>
    <div class="body">
      <p>Hi <%= @user.display_name %>,</p>
      <p>
        <% if @days_out == 1 %>
          Your trip starts tomorrow. Here's a final nudge to pack and download your plan for offline use.
        <% else %>
          Just <%= @days_out %> days to go. A good moment to finalise the plan and start your packing list.
        <% end %>
      </p>

      <div class="card">
        <div class="name"><%= @trip.title %></div>
        <div class="meta">
          <% if @trip.destination.present? %><%= @trip.destination %> · <% end %>
          <% if @trip.start_date && @trip.end_date %>
            <%= @trip.start_date.strftime("%a %b %-d") %> – <%= @trip.end_date.strftime("%a %b %-d, %Y") %>
          <% end %>
        </div>
      </div>

      <p>
        <a class="cta" href="<%= @url %>">Open the plan →</a>
        <a class="cta secondary" href="<%= @checklist_url %>">Packing checklist</a>
      </p>

      <p class="small">Tip: open the plan once while online and it stays available offline on the road.</p>
    </div>
  </div>
</body>
</html>
