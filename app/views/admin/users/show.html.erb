<% content_for :title, "#{@user.email} · Users · Admin" %>

<div class="mb-4">
  <%= link_to "← All users", admin_users_path, class: "text-xs text-slate-400 hover:text-amber-200" %>
</div>

<div class="flex items-start justify-between gap-4 mb-6">
  <div class="min-w-0">
    <h1 class="font-display text-2xl font-semibold"><%= @user.email %></h1>
    <% if @user.name.present? %><p class="text-sm text-slate-400"><%= @user.name %></p><% end %>
    <p class="text-[11px] text-slate-500 mt-1">
      Joined <%= @user.created_at.strftime("%b %-d, %Y") %>
      <% if @user.admin? %> · <span class="text-amber-300 font-semibold uppercase tracking-widest">admin</span><% end %>
    </p>
  </div>
  <%= link_to "Edit", edit_admin_user_path(@user), class: "px-3 py-1.5 rounded-md bg-amber-500 text-slate-950 text-xs font-semibold hover:bg-amber-400" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-6">
  <section class="space-y-6">
    <div>
      <h2 class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-2">Owned trips (<%= @owned_trips.size %>)</h2>
      <% if @owned_trips.any? %>
        <ul class="divide-y divide-slate-800/60 rounded-xl border border-slate-800 overflow-hidden">
          <% @owned_trips.each do |t| %>
            <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
              <div class="min-w-0">
                <%= link_to t.title, plan_trip_path(t), target: "_blank", class: "text-slate-200 hover:text-amber-200 truncate" %>
                <p class="text-[11px] text-slate-500"><%= t.destination %><% if t.start_date %> · <%= t.start_date.strftime("%b %-d, %Y") %><% end %></p>
              </div>
              <span class="text-[11px] text-slate-500 whitespace-nowrap"><%= time_ago_in_words(t.created_at) %> ago</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-500 italic">No owned trips yet.</p>
      <% end %>
    </div>

    <div>
      <h2 class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-2">Recent AI calls (<%= @recent_calls.size %>)</h2>
      <% if @recent_calls.any? %>
        <%= render "admin/ai_calls/table", calls: @recent_calls %>
      <% else %>
        <p class="text-sm text-slate-500 italic">No AI calls logged for this user.</p>
      <% end %>
    </div>
  </section>

  <aside class="space-y-3 text-sm">
    <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
      <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-2">Loyalty memberships</p>
      <% active = @user.discount_memberships.to_h.select { |_, v| v } %>
      <% if active.any? %>
        <ul class="space-y-1 text-xs">
          <% active.each do |key, _| %>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              <%= User::MEMBERSHIPS.dig(key.to_sym, :label) || key %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-xs text-slate-500 italic">None active.</p>
      <% end %>
      <% if @user.alltrails_pro? %>
        <p class="text-[11px] mt-3 text-emerald-300">AllTrails Pro</p>
      <% end %>
    </div>
  </aside>
</div>
