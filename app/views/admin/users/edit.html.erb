<% content_for :title, "Edit #{@user.email} · Admin" %>

<div class="mb-4">
  <%= link_to "← #{@user.email}", admin_user_path(@user), class: "text-xs text-slate-400 hover:text-amber-200" %>
</div>

<h1 class="font-display text-2xl font-semibold mb-4">Edit user</h1>

<%= form_with model: @user, url: admin_user_path(@user), method: :patch, class: "space-y-4 max-w-md" do |f| %>
  <% if @user.errors.any? %>
    <div class="rounded-lg bg-rose-500/15 border border-rose-500/30 text-rose-100 px-3 py-2 text-sm">
      <%= @user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-1">Email</p>
    <p class="text-sm text-slate-300"><%= @user.email %></p>
    <p class="text-[11px] text-slate-500 mt-0.5">Use Devise account flow to change.</p>
  </div>

  <div>
    <%= f.label :name, class: "text-[10px] uppercase tracking-widest text-slate-500 font-semibold block mb-1" %>
    <%= f.text_field :name, class: "w-full px-3 py-2 rounded-md bg-slate-900/60 border border-slate-700 text-slate-100" %>
  </div>

  <label class="flex items-center gap-2 text-sm text-slate-200">
    <%= f.check_box :admin, class: "rounded border-slate-700 bg-slate-900/60 text-amber-500 focus:ring-amber-500" %>
    Admin (full access to /admin)
  </label>
  <% if @user == current_user %>
    <p class="text-[11px] text-amber-300/80">Heads up — you can't remove your own admin flag here.</p>
  <% end %>

  <label class="flex items-center gap-2 text-sm text-slate-200">
    <%= f.check_box :alltrails_pro, class: "rounded border-slate-700 bg-slate-900/60 text-amber-500 focus:ring-amber-500" %>
    AllTrails Pro (self-declared)
  </label>

  <div class="flex items-center gap-2 pt-2">
    <%= f.submit "Save", class: "px-4 py-2 rounded-md bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 cursor-pointer" %>
    <%= link_to "Cancel", admin_user_path(@user), class: "px-4 py-2 rounded-md text-sm text-slate-400 hover:text-amber-200" %>
  </div>
<% end %>
