<% input = "w-full rounded-lg bg-slate-900/60 border border-slate-700 px-3 py-2 text-sm text-slate-100 focus:border-amber-500 focus:outline-none" %>
<% label = "block text-[11px] uppercase tracking-widest text-slate-400 font-semibold mb-1" %>

<%= form_with model: prompt, url: prompt.persisted? ? admin_ai_prompt_path(prompt) : admin_ai_prompts_path, class: "space-y-5" do |f| %>
  <% if prompt.errors.any? %>
    <div class="rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-100 px-3 py-2 text-sm">
      <p class="font-semibold mb-1"><%= pluralize(prompt.errors.count, "error") %> stopped this:</p>
      <ul class="list-disc list-inside text-rose-200/80">
        <% prompt.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :slug, class: label %>
      <%= f.text_field :slug, class: input, placeholder: "namespace.v1" %>
      <p class="text-xs text-slate-500 mt-1">Lowercase letters, digits, <code>_</code>, <code>.</code>, <code>-</code>. Bump <code>.v2</code> when you make breaking changes.</p>
    </div>
    <div>
      <%= f.label :name, class: label %>
      <%= f.text_field :name, class: input %>
    </div>
  </div>

  <div>
    <%= f.label :description, class: label %>
    <%= f.text_area :description, rows: 2, class: input, placeholder: "What is this prompt for? Which service invokes it?" %>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div>
      <%= f.label :provider, class: label %>
      <%= f.select :provider, AiPrompt::PROVIDERS.map { |p| [ p, p ] }, {}, class: input %>
    </div>
    <div>
      <%= f.label :model, class: label %>
      <%= f.text_field :model, class: input, placeholder: "claude-sonnet-4-6" %>
    </div>
    <div>
      <%= f.label :kind, class: label %>
      <%= f.select :kind, AiPrompt::KINDS.map { |k| [ k, k ] }, {}, class: input %>
    </div>
    <div>
      <%= f.label :max_tokens, class: label %>
      <%= f.number_field :max_tokens, class: input, placeholder: "1024" %>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div>
      <%= f.label :temperature, class: label %>
      <%= f.number_field :temperature, step: 0.01, class: input, placeholder: "(default)" %>
    </div>
    <div class="sm:col-span-2 flex items-end gap-2">
      <label class="inline-flex items-center gap-2 text-sm">
        <%= f.check_box :active, class: "w-4 h-4 rounded bg-slate-800 border-slate-600" %>
        Active (callers can hit this slug)
      </label>
    </div>
  </div>

  <div>
    <%= f.label :system_template, class: label %>
    <p class="text-xs text-slate-500 mb-1.5">Sent as the <code>system</code> message. Plain text; ERB allowed.</p>
    <%= f.text_area :system_template, rows: 8, class: input + " font-mono text-xs leading-relaxed" %>
  </div>

  <div>
    <%= f.label :user_template, class: label %>
    <p class="text-xs text-slate-500 mb-1.5">Sent as the <code>user</code> message. Use <code>&lt;%= variable %&gt;</code> for substitution. Variables available depend on which service invokes this prompt.</p>
    <%= f.text_area :user_template, rows: 10, class: input + " font-mono text-xs leading-relaxed" %>
  </div>

  <div>
    <%= f.label :notes, class: label %>
    <%= f.text_area :notes, rows: 2, class: input, placeholder: "Audit notes, gotchas, who tuned this last and why." %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-2">
    <%= link_to "Cancel", prompt.persisted? ? admin_ai_prompt_path(prompt) : admin_ai_prompts_path, class: "text-sm text-slate-400 hover:text-slate-200" %>
    <%= f.submit (prompt.persisted? ? "Save changes" : "Create prompt"), class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 cursor-pointer" %>
  </div>
<% end %>
