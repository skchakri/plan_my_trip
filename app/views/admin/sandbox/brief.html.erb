<%= turbo_frame_tag "sandbox-brief" do %>
  <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
    <%= render "block_header", title: "Destination brief", result: @result %>
    <% brief = @result[:value] %>
    <% if brief.nil? || brief.respond_to?(:empty?) && brief.empty? %>
      <p class="text-sm text-slate-500 italic">No brief returned. Check that <code class="text-amber-300">destination_brief.v1</code> is active under Prompts.</p>
    <% else %>
      <% if brief.tagline.present? %>
        <p class="text-amber-300 font-display text-lg leading-snug"><%= brief.tagline %></p>
      <% end %>
      <% if brief.pitch.present? %>
        <p class="text-sm text-slate-300 leading-relaxed mt-2"><%= brief.pitch %></p>
      <% end %>
      <% if brief.watchouts.any? %>
        <div class="mt-3">
          <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-1.5">Watch-outs</p>
          <ul class="list-disc list-inside text-sm text-slate-300 space-y-0.5">
            <% brief.watchouts.each do |w| %><li><%= w %></li><% end %>
          </ul>
        </div>
      <% end %>
      <% if brief.best_for.any? %>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <% brief.best_for.each do |tag| %>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 uppercase tracking-widest"><%= tag %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
