<% content_for :title, "Sandbox · Admin" %>

<%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
<style>
  .sandbox-map { background: #0a0e1a; border-radius: 0.75rem; }
  .sandbox-map .leaflet-control-zoom a { background: rgba(15,23,42,.92); color: #e2e8f0; border: 1px solid rgba(71,85,105,.5); }
  .sandbox-map .leaflet-control-zoom a:hover { background: rgba(30,41,59,.95); color: #fde68a; }
  .sandbox-map .leaflet-control-attribution { background: rgba(15,23,42,.7); color: #94a3b8; font-size: 10px; }
  .sandbox-map .leaflet-control-attribution a { color: #fbbf24; }
  .sandbox-map .leaflet-popup-content-wrapper, .sandbox-map .leaflet-popup-tip { background: #f8fafc; }
</style>

<div class="mb-5">
  <h1 class="font-display text-2xl font-semibold">Planner sandbox</h1>
  <p class="text-sm text-slate-400 mt-1">Run the full AI pipeline (brief → highlights → route landmarks → day plan → markdown itinerary) on any origin/destination, or browse the place catalog around a point. Results cached 1h.</p>
</div>

<div data-controller="sandbox-tabs" class="space-y-6">
  <nav class="flex items-center gap-1 text-sm border-b border-slate-800">
    <button type="button" data-action="click->sandbox-tabs#switch" data-sandbox-tabs-target="tab" data-tab="plan"
            class="px-3 py-2 -mb-px border-b-2 border-amber-400 text-amber-300 font-semibold">Plan a trip</button>
    <button type="button" data-action="click->sandbox-tabs#switch" data-sandbox-tabs-target="tab" data-tab="nearby"
            class="px-3 py-2 -mb-px border-b-2 border-transparent text-slate-400 hover:text-slate-200">Places near a point</button>
  </nav>

  <%# ───────── Plan a trip panel ───────── %>
  <section data-sandbox-tabs-target="panel" data-tab="plan" class="space-y-5">
    <%= form_with url: admin_sandbox_path, method: :get, local: true, class: "rounded-xl border border-slate-800 bg-slate-900/40 p-4 space-y-4" do %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Origin</label>
          <%= text_field_tag :origin, (@plan_params[:origin] || @plan_defaults[:origin]),
                class: "mt-1 w-full px-3 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm focus:border-amber-500/50 focus:outline-none",
                placeholder: "Salt Lake City, UT" %>
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Destination</label>
          <%= text_field_tag :destination, (@plan_params[:destination] || @plan_defaults[:destination]),
                class: "mt-1 w-full px-3 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm focus:border-amber-500/50 focus:outline-none",
                placeholder: "Yellowstone National Park" %>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Start date</label>
          <%= date_field_tag :start_date, (@plan_params[:start_date] || @plan_defaults[:start_date]),
                class: "mt-1 w-full px-2 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm focus:border-amber-500/50 focus:outline-none" %>
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">End date</label>
          <%= date_field_tag :end_date, (@plan_params[:end_date] || @plan_defaults[:end_date]),
                class: "mt-1 w-full px-2 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm focus:border-amber-500/50 focus:outline-none" %>
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Transport</label>
          <%= select_tag :transport_mode,
                options_for_select([ %w[drive drive], %w[fly fly], %w[train train], %w[mixed mixed] ], (@plan_params[:transport_mode] || @plan_defaults[:transport_mode])),
                class: "mt-1 w-full px-2 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm" %>
        </div>
        <div class="flex items-end">
          <button type="submit" class="w-full px-3 py-2 rounded-md bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 cursor-pointer">Run pipeline</button>
        </div>
      </div>

      <div>
        <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Travelers</label>
        <% people_source = (@plan_params[:people].presence || @plan_defaults[:people]) %>
        <div class="mt-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
          <% people_source.first(3).each_with_index do |person, i| %>
            <div class="rounded-md border border-slate-800 bg-slate-950/60 p-2 space-y-1.5">
              <div class="flex items-center gap-2">
                <%= text_field_tag "people[#{i}][name]", person[:name],
                      class: "flex-1 px-2 py-1 rounded bg-slate-900 border border-slate-800 text-xs",
                      placeholder: "Name" %>
                <%= number_field_tag "people[#{i}][age]", person[:age],
                      class: "w-14 px-2 py-1 rounded bg-slate-900 border border-slate-800 text-xs",
                      placeholder: "Age" %>
              </div>
              <%= text_field_tag "people[#{i}][interests][]", Array(person[:interests]).join(", "),
                    class: "w-full px-2 py-1 rounded bg-slate-900 border border-slate-800 text-xs",
                    placeholder: "interests (comma-sep)" %>
            </div>
          <% end %>
          <% (people_source.size...3).each do |i| %>
            <div class="rounded-md border border-slate-800 bg-slate-950/60 p-2 space-y-1.5">
              <div class="flex items-center gap-2">
                <%= text_field_tag "people[#{i}][name]", "",
                      class: "flex-1 px-2 py-1 rounded bg-slate-900 border border-slate-800 text-xs",
                      placeholder: "Name" %>
                <%= number_field_tag "people[#{i}][age]", "",
                      class: "w-14 px-2 py-1 rounded bg-slate-900 border border-slate-800 text-xs",
                      placeholder: "Age" %>
              </div>
              <%= text_field_tag "people[#{i}][interests][]", "",
                    class: "w-full px-2 py-1 rounded bg-slate-900 border border-slate-800 text-xs",
                    placeholder: "interests (comma-sep)" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @plan_ready %>
      <% qs = sandbox_plan_qs %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <%= turbo_frame_tag "sandbox-brief", src: admin_sandbox_brief_path(qs), loading: "lazy" do %>
          <%= render "loading", title: "Destination brief", note: "Calling DestinationBrief…" %>
        <% end %>
        <%= turbo_frame_tag "sandbox-route", src: admin_sandbox_route_landmarks_path(qs), loading: "lazy" do %>
          <%= render "loading", title: "Drive-by landmarks", note: "Calling RouteLandmarksBuilder…" %>
        <% end %>
      </div>

      <%= turbo_frame_tag "sandbox-highlights", src: admin_sandbox_highlights_path(qs), loading: "lazy" do %>
        <%= render "loading", title: "Highlights grid", note: "Calling DestinationHighlights…" %>
      <% end %>

      <%= turbo_frame_tag "sandbox-structure", src: admin_sandbox_structure_path(qs), loading: "lazy" do %>
        <%= render "loading", title: "Day-by-day plan", note: "Calling TripStructureBuilder… (longest call — ~15s)" %>
      <% end %>

      <%= turbo_frame_tag "sandbox-itinerary", src: admin_sandbox_itinerary_path(qs), loading: "lazy" do %>
        <%= render "loading", title: "Markdown itinerary", note: "Calling ItineraryBuilder…" %>
      <% end %>
    <% else %>
      <div class="rounded-xl border border-dashed border-slate-800 bg-slate-900/30 p-6 text-center text-sm text-slate-400">
        Set origin + destination above and click <span class="text-amber-300 font-semibold">Run pipeline</span>. Each block fetches independently — they appear as their AI calls return.
      </div>
    <% end %>
  </section>

  <%# ───────── Places near a point panel ───────── %>
  <section data-sandbox-tabs-target="panel" data-tab="nearby" class="space-y-5 hidden">
    <%= form_with url: admin_sandbox_path(anchor: "nearby"), method: :get, local: true, class: "rounded-xl border border-slate-800 bg-slate-900/40 p-4 space-y-4" do %>
      <%= hidden_field_tag :tab, "nearby" %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
        <div class="md:col-span-2">
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Label (optional)</label>
          <%= text_field_tag :label, (@nearby_params[:label] || @nearby_defaults[:label]),
                class: "mt-1 w-full px-3 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm",
                placeholder: "Salt Lake City" %>
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Lat</label>
          <%= number_field_tag :lat, (@nearby_params[:lat] || @nearby_defaults[:lat]), step: "0.0001",
                class: "mt-1 w-full px-3 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm font-mono" %>
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Lng</label>
          <%= number_field_tag :lng, (@nearby_params[:lng] || @nearby_defaults[:lng]), step: "0.0001",
                class: "mt-1 w-full px-3 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm font-mono" %>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Radius (km)</label>
          <%= select_tag :radius_km,
                options_for_select([ 10, 25, 50, 100, 200 ].map { |k| [ "#{k} km", k ] }, (@nearby_params[:radius_km] || @nearby_defaults[:radius_km])),
                class: "mt-1 w-full px-2 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm" %>
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Kind</label>
          <%= select_tag :kind,
                options_for_select([ [ "any", "" ] ] + Place::KINDS.map { |k| [ k, k ] }, @nearby_params[:kind]),
                class: "mt-1 w-full px-2 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm" %>
        </div>
        <div>
          <label class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold">Tier</label>
          <%= select_tag :tier,
                options_for_select([ [ "any", "" ] ] + Place::TIERS.map { |t| [ t, t ] }, @nearby_params[:tier]),
                class: "mt-1 w-full px-2 py-2 rounded-md bg-slate-950 border border-slate-800 text-sm" %>
        </div>
        <div class="flex items-end">
          <button type="submit" class="w-full px-3 py-2 rounded-md bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 cursor-pointer">Search nearby</button>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 text-xs text-slate-400">
        <span class="font-semibold uppercase tracking-widest">Presets:</span>
        <a class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200" href="<%= admin_sandbox_path(lat: 40.7608, lng: -111.8910, label: "Salt Lake City", radius_km: 50, tab: "nearby") %>">SLC 50km</a>
        <a class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200" href="<%= admin_sandbox_path(lat: 44.4280, lng: -110.5885, label: "Yellowstone", radius_km: 50, tab: "nearby") %>">Yellowstone 50km</a>
        <a class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200" href="<%= admin_sandbox_path(lat: 36.1716, lng: -115.1391, label: "Las Vegas", radius_km: 100, tab: "nearby") %>">Vegas 100km</a>
        <a class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200" href="<%= admin_sandbox_path(lat: 38.7325, lng: -109.5934, label: "Moab", radius_km: 50, tab: "nearby") %>">Moab 50km</a>
      </div>
    <% end %>

    <% if @nearby_ready %>
      <%= turbo_frame_tag "sandbox-nearby", src: admin_sandbox_nearby_path(lat: @nearby_params[:lat], lng: @nearby_params[:lng], radius_km: @nearby_params[:radius_km], label: @nearby_params[:label], kind: @nearby_params[:kind], tier: @nearby_params[:tier]), loading: "lazy" do %>
        <%= render "loading", title: "Nearby catalog", note: "Querying Place.near…" %>
      <% end %>
    <% end %>
  </section>
</div>

<%# ───────── Place-detail modal ─────────
    Lives outside the tab panels so it can be opened from anywhere on the
    page (currently: the nearby table rows + map popups). Closed by default;
    Stimulus opens it when the inner turbo-frame finishes loading content. %>
<div data-controller="place-modal">
  <div data-place-modal-target="dialog"
       data-action="click->place-modal#backdrop"
       hidden
       class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/70 backdrop-blur-sm transition-opacity duration-200 opacity-0 data-[open=true]:opacity-100">
    <div class="w-full sm:max-w-2xl max-h-[90vh] overflow-y-auto rounded-t-2xl sm:rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl">
      <%= turbo_frame_tag "sandbox-place-modal", data: { place_modal_target: "frame" } do %>
        <div class="p-6 text-center text-sm text-slate-400">Loading…</div>
      <% end %>
    </div>
  </div>
</div>

