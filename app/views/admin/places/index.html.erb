<% content_for :title, "Places · Admin" %>

<div class="flex items-end justify-between gap-3 mb-4">
  <div>
    <h1 class="font-display text-2xl font-semibold">Places catalog</h1>
    <p class="text-sm text-slate-400">Shared place catalog — every named location across all trips lives here.</p>
  </div>
</div>

<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
  <% [
    ["Total",     @stats[:total]],
    ["Kept",      @stats[:kept]],
    ["Verified",  @stats[:verified]],
    ["With image", @stats[:with_image]]
  ].each do |label, value| %>
    <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-3">
      <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold"><%= label %></p>
      <p class="font-display text-2xl font-semibold mt-1 tabular-nums"><%= value.to_i %></p>
    </div>
  <% end %>
</div>

<%= form_with url: admin_places_path, method: :get, local: true, class: "flex flex-wrap items-center gap-2 mb-4" do %>
  <%= text_field_tag :q, params[:q], placeholder: "name…", class: "px-3 py-1.5 rounded-md bg-slate-900/60 border border-slate-700 text-sm text-slate-100 placeholder:text-slate-500 focus:border-amber-500/50 focus:outline-none" %>
  <%= select_tag :scope, options_for_select([
        ["Kept",        "kept"],
        ["All",         "all"],
        ["Discarded",   "discarded"],
        ["Verified",    "verified"],
        ["Unverified",  "unverified"],
        ["No image",    "no_image"]
      ], @scope), class: "px-3 py-1.5 rounded-md bg-slate-900/60 border border-slate-700 text-sm" %>
  <%= select_tag :kind, options_for_select([["All kinds", ""]] + Place::KINDS.map { |k| [k, k] }, params[:kind]),
        class: "px-3 py-1.5 rounded-md bg-slate-900/60 border border-slate-700 text-sm" %>
  <button type="submit" class="px-3 py-1.5 rounded-md bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400">Filter</button>
  <% if params[:q].present? || params[:kind].present? || @scope != "kept" %>
    <%= link_to "Reset", admin_places_path, class: "px-3 py-1.5 text-sm text-slate-400 hover:text-amber-200" %>
  <% end %>
<% end %>

<% if @places.empty? %>
  <p class="text-sm text-slate-500 italic">No places match these filters.</p>
<% else %>
  <div class="rounded-xl border border-slate-800 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-slate-900/60 text-[10px] uppercase tracking-widest text-slate-500">
        <tr>
          <th class="text-left px-3 py-2">Place</th>
          <th class="text-left px-3 py-2">Kind</th>
          <th class="text-left px-3 py-2">Coords</th>
          <th class="text-right px-3 py-2">Usage</th>
          <th class="text-left px-3 py-2">Image</th>
          <th class="text-left px-3 py-2">Flags</th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60">
        <% @places.each do |p| %>
          <tr class="hover:bg-slate-900/40">
            <td class="px-3 py-2">
              <%= link_to p.name, admin_place_path(p), class: "text-amber-300 hover:text-amber-200 font-medium" %>
              <% if p.canonical_name.present? && p.canonical_name != p.name %>
                <div class="text-[11px] text-slate-500"><%= p.canonical_name %></div>
              <% end %>
            </td>
            <td class="px-3 py-2 text-slate-300"><%= p.kind || "—" %></td>
            <td class="px-3 py-2 text-[11px] text-slate-500 tabular-nums">
              <% if p.latitude && p.longitude %>
                <%= p.latitude.to_f.round(4) %>, <%= p.longitude.to_f.round(4) %>
              <% else %>—<% end %>
            </td>
            <td class="px-3 py-2 text-right tabular-nums"><%= p.usage_count %></td>
            <td class="px-3 py-2">
              <% if p.image_url.present? %>
                <img src="<%= p.image_url %>" alt="" class="w-10 h-10 rounded object-cover" referrerpolicy="no-referrer">
              <% else %>
                <span class="text-[11px] text-slate-500 italic">none</span>
              <% end %>
            </td>
            <td class="px-3 py-2">
              <% if p.verified %>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-300 font-semibold uppercase">verified</span>
              <% end %>
              <% if p.discarded? %>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-300 font-semibold uppercase">discarded</span>
              <% end %>
            </td>
            <td class="px-3 py-2 text-right">
              <%= link_to "view", admin_place_path(p), class: "text-xs text-slate-400 hover:text-amber-300" %>
              <%= link_to "edit", edit_admin_place_path(p), class: "text-xs text-slate-400 hover:text-amber-300 ml-2" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="text-[11px] text-slate-500 mt-2">Showing up to 200 rows.</p>
<% end %>
