<% content_for :title, "#{@place.name} · Places · Admin" %>

<div class="mb-4">
  <%= link_to "← All places", admin_places_path, class: "text-xs text-slate-400 hover:text-amber-200" %>
</div>

<div class="flex items-start justify-between gap-4 mb-4">
  <div class="min-w-0">
    <h1 class="font-display text-2xl font-semibold"><%= @place.name %></h1>
    <% if @place.canonical_name.present? %><p class="text-sm text-slate-400"><%= @place.canonical_name %></p><% end %>
    <p class="text-[11px] text-slate-500 mt-1"><%= @place.kind %><% if @place.latitude && @place.longitude %> · <%= @place.latitude.to_f.round(4) %>, <%= @place.longitude.to_f.round(4) %><% end %></p>
  </div>
  <div class="flex items-center gap-2">
    <%= button_to (@place.verified ? "Unverify" : "Verify"), verify_admin_place_path(@place), method: :post,
          class: "px-3 py-1.5 rounded-md text-xs font-semibold cursor-pointer #{@place.verified ? 'bg-slate-800 text-slate-200 border border-slate-700' : 'bg-emerald-500 text-slate-950 hover:bg-emerald-400'}" %>
    <%= link_to "Edit", edit_admin_place_path(@place), class: "px-3 py-1.5 rounded-md bg-amber-500 text-slate-950 text-xs font-semibold hover:bg-amber-400" %>
    <% unless @place.discarded? %>
      <%= button_to "Discard", admin_place_path(@place), method: :delete, form: { data: { turbo_confirm: "Discard #{@place.name}?" } },
            class: "px-3 py-1.5 rounded-md bg-rose-500/15 text-rose-300 border border-rose-500/30 text-xs font-semibold cursor-pointer hover:bg-rose-500/25" %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-6">
  <section class="space-y-4">
    <% if @place.image_url.present? %>
      <div class="rounded-xl border border-slate-800 overflow-hidden bg-slate-900/40">
        <img src="<%= @place.image_url %>" alt="<%= @place.name %>" class="w-full aspect-[16/9] object-cover" referrerpolicy="no-referrer">
        <% if @place.image_attribution.present? %>
          <p class="text-[10px] text-slate-500 px-3 py-1.5"><%= @place.image_attribution %> · <span class="uppercase tracking-widest"><%= @place.image_source %></span></p>
        <% end %>
      </div>
    <% end %>

    <% if @place.famous_for.present? %>
      <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
        <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-1">Famous for</p>
        <p class="text-sm text-amber-200/90"><%= @place.famous_for %></p>
      </div>
    <% end %>

    <% if @place.description.present? %>
      <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
        <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-1">Description</p>
        <p class="text-sm text-slate-200 leading-relaxed whitespace-pre-line"><%= @place.description %></p>
      </div>
    <% end %>

    <section>
      <h2 class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-2">Used in trips (<%= @recent_activities.size %>)</h2>
      <% if @recent_activities.any? %>
        <ul class="divide-y divide-slate-800/60 rounded-xl border border-slate-800 overflow-hidden">
          <% @recent_activities.each do |a| %>
            <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
              <div class="min-w-0">
                <p class="text-slate-200 truncate"><%= a.title %></p>
                <p class="text-[11px] text-slate-500 truncate"><%= a.trip_day.trip.title %> · <%= a.trip_day.date&.strftime("%b %-d, %Y") %></p>
              </div>
              <span class="text-[11px] text-slate-500 whitespace-nowrap"><%= time_ago_in_words(a.created_at) %> ago</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-500 italic">No activities link to this place.</p>
      <% end %>
    </section>
  </section>

  <aside class="space-y-3 text-sm">
    <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-4 space-y-2">
      <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Stats</p>
      <dl class="grid grid-cols-2 gap-x-3 gap-y-1.5">
        <dt class="text-slate-500">Usage</dt>      <dd class="text-slate-200 tabular-nums"><%= @place.usage_count %></dd>
        <dt class="text-slate-500">Verified</dt>   <dd><%= @place.verified ? "yes" : "no" %></dd>
        <dt class="text-slate-500">Image source</dt><dd class="text-slate-300"><%= @place.image_source || "—" %></dd>
        <dt class="text-slate-500">Contributed</dt><dd class="text-slate-300 truncate"><%= @place.contributed_by&.email || "—" %></dd>
        <dt class="text-slate-500">Created</dt>    <dd class="text-slate-300"><%= @place.created_at.strftime("%Y-%m-%d") %></dd>
      </dl>
    </div>

    <% if @place.source_urls.present? %>
      <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
        <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-2">Source URLs</p>
        <ul class="space-y-1">
          <% @place.source_urls.each do |label, url| %>
            <li class="text-xs">
              <span class="text-slate-500 uppercase tracking-widest"><%= label %></span>
              <%= link_to url, url, target: "_blank", rel: "noopener", class: "block text-amber-300 hover:text-amber-200 truncate" %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </aside>
</div>
