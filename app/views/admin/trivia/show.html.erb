<% content_for :title, "#{@tag.humanize} · Trivia · Admin" %>

<div class="mb-4">
  <%= link_to "← All categories", admin_trivia_path, class: "text-xs text-slate-400 hover:text-amber-200" %>
</div>

<div class="mb-6">
  <h1 class="font-display text-2xl font-semibold"><%= @tag.humanize %></h1>
  <p class="text-sm text-slate-400">
    <%= pluralize(@chains.size, "story chain") %> · <%= pluralize(@standalone.size, "stand-alone question") %>
  </p>
</div>

<%# ---- Render one question card. Used inside chains and stand-alones. ---- %>
<% render_question = ->(q, prefix: "#") do %>
  <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
    <div class="flex items-start justify-between gap-3 mb-2">
      <p class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold">
        <%= prefix %> · <%= q.source %><% if q.trip %> · trip <%= q.trip.title.to_s.truncate(30) %><% end %>
      </p>
      <% if q.difficulty.present? %>
        <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 font-semibold uppercase"><%= q.difficulty %></span>
      <% end %>
    </div>
    <p class="font-medium text-slate-100 mb-3"><%= q.question %></p>
    <ul class="space-y-1 mb-3">
      <% Array(q.options).each_with_index do |opt, oi| %>
        <li class="text-sm flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-semibold <%= oi == q.answer_index ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' : 'bg-slate-800 text-slate-400 border border-slate-700' %>">
            <%= ("A".ord + oi).chr %>
          </span>
          <span class="<%= oi == q.answer_index ? 'text-emerald-200 font-medium' : 'text-slate-300' %>"><%= opt %></span>
          <% if oi == q.answer_index %>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-300 font-semibold uppercase ml-1">answer</span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if q.fun_fact.present? %>
      <p class="text-xs text-amber-200/80 italic border-l-2 border-amber-500/40 pl-3">
        <span class="font-semibold not-italic">Fun fact:</span> <%= q.fun_fact %>
      </p>
    <% end %>
  </div>
<% end %>

<% if @chains.any? %>
  <section class="mb-8">
    <h2 class="text-[10px] uppercase tracking-widest text-amber-300 font-semibold mb-3">
      Story chains <span class="text-slate-500">· follow-up questions in order</span>
    </h2>
    <div class="space-y-5">
      <% @chains.each_with_index do |chain, ci|
           diff = chain.first.difficulty.presence
           diff_color = case diff
                       when "easy"   then "bg-emerald-500/15 text-emerald-300 border-emerald-500/40"
                       when "medium" then "bg-amber-500/15  text-amber-300  border-amber-500/40"
                       when "hard"   then "bg-rose-500/15   text-rose-300   border-rose-500/40"
                       else               "bg-slate-800     text-slate-400  border-slate-700"
                       end %>
        <article class="rounded-2xl border-2 border-amber-500/25 bg-amber-500/[0.04] p-4 sm:p-5">
          <header class="mb-4">
            <p class="text-[10px] uppercase tracking-widest text-amber-300 font-semibold flex items-center gap-2 flex-wrap">
              <span>Chain #<%= ci + 1 %> · <%= chain.size %> steps</span>
              <% if diff %>
                <span class="px-1.5 py-0.5 rounded border <%= diff_color %>"><%= diff %></span>
              <% end %>
            </p>
            <% if chain.first.chain_intro.present? %>
              <p class="text-sm text-slate-300 italic mt-2 leading-relaxed">
                <%= chain.first.chain_intro %>
              </p>
            <% end %>
          </header>
          <ol class="space-y-3 ml-0 sm:ml-4 border-l-2 border-amber-500/20 pl-4 sm:pl-5">
            <% chain.each_with_index do |q, si| %>
              <li>
                <p class="text-[10px] uppercase tracking-widest text-amber-200 font-semibold mb-1.5">
                  Step <%= si + 1 %> of <%= chain.size %>
                </p>
                <%= render_question.call(q, prefix: "step #{si + 1}") %>
              </li>
            <% end %>
          </ol>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<% if @standalone.any? %>
  <section>
    <h2 class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold mb-3">
      Stand-alone questions
    </h2>
    <div class="space-y-3">
      <% @standalone.each_with_index do |q, idx| %>
        <%= render_question.call(q, prefix: "##{idx + 1}") %>
      <% end %>
    </div>
  </section>
<% end %>
