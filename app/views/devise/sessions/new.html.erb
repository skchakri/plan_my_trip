<% content_for :title, "Sign in · Wanderply" %>

<div class="relative min-h-screen flex">
  <%# Left brand panel (hidden on mobile) %>
  <aside class="hidden lg:flex relative w-1/2 xl:w-[55%] overflow-hidden">
    <img src="https://images.unsplash.com/photo-1605833556294-ea5c7a74f57d?w=1400&q=80" alt="" class="absolute inset-0 w-full h-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-950/85 via-slate-950/60 to-slate-950/85"></div>
    <div class="absolute inset-0 aurora opacity-60"></div>
    <div class="relative z-10 flex flex-col justify-between p-10 xl:p-14 w-full">
      <%= link_to root_path, class: "flex items-center gap-2.5 self-start" do %>
        <%= image_tag "/icon.svg", alt: "", width: 32, height: 32, class: "rounded-lg shadow-lg shadow-amber-500/20" %>
        <span class="text-[15px] font-semibold tracking-tight bg-gradient-to-r from-amber-200 to-amber-400 bg-clip-text text-transparent">Wanderply</span>
      <% end %>
      <figure class="max-w-md">
        <span class="font-display text-6xl text-amber-400/30 leading-none">"</span>
        <blockquote class="-mt-4 font-display text-2xl xl:text-3xl font-medium text-slate-100 leading-snug tracking-tight">
          We've been on the road four days. The kids haven't asked <em class="text-amber-300 not-italic">"are we there yet"</em> once.
        </blockquote>
        <figcaption class="mt-4 text-sm text-slate-400">— A family that picked Wanderply for their Vegas crew trip</figcaption>
      </figure>
    </div>
  </aside>

  <%# Right form panel %>
  <div class="relative flex-1 flex items-center justify-center px-4 sm:px-8 py-12 bg-slate-950">
    <div class="lg:hidden absolute top-6 left-6">
      <%= link_to root_path, class: "flex items-center gap-2.5" do %>
        <%= image_tag "/icon.svg", alt: "", width: 28, height: 28, class: "rounded-lg shadow-lg shadow-amber-500/20" %>
        <span class="text-sm font-semibold tracking-tight bg-gradient-to-r from-amber-200 to-amber-400 bg-clip-text text-transparent">Wanderply</span>
      <% end %>
    </div>

    <div class="w-full max-w-md">
      <p class="text-[11px] uppercase tracking-[0.18em] text-amber-300 font-semibold">Welcome back</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight mt-2">Sign in to your trips.</h1>
      <p class="text-sm text-slate-400 mt-2">Don't have an account yet? <%= link_to "Create one", new_user_registration_path, class: "text-amber-300 hover:text-amber-200 font-medium" %>.</p>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-slate-200 mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "you@example.com", class: "w-full rounded-lg bg-slate-900 border border-slate-700 px-3.5 py-2.5 text-slate-100 placeholder:text-slate-400 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/40 focus:outline-none transition-colors" %>
        </div>

        <div>
          <div class="flex items-baseline justify-between mb-1.5">
            <%= f.label :password, class: "block text-sm font-medium text-slate-200" %>
            <% if devise_mapping.recoverable? %>
              <%= link_to "Forgot?", new_password_path(resource_name), class: "text-xs text-slate-400 hover:text-amber-300 transition-colors" %>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", required: true, placeholder: "••••••••", class: "w-full rounded-lg bg-slate-900 border border-slate-700 px-3.5 py-2.5 text-slate-100 placeholder:text-slate-400 focus:border-amber-500 focus:ring-1 focus:ring-amber-500/40 focus:outline-none transition-colors" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2 text-sm text-slate-300 select-none cursor-pointer">
            <%= f.check_box :remember_me, class: "rounded bg-slate-900 border-slate-600 text-amber-500 focus:ring-amber-500/40 cursor-pointer" %>
            Remember me on this device
          </label>
        <% end %>

        <%= f.submit "Sign in", class: "w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-lg font-semibold shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 transition-all cursor-pointer" %>
      <% end %>

      <p class="mt-8 text-xs text-slate-400 text-center">Demo account: <code class="text-slate-300 font-mono">demo@example.com</code> / <code class="text-slate-300 font-mono">password123</code></p>
    </div>
  </div>
</div>
