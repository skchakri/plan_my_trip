<% content_for :title, "Sign in" %>
<div class="max-w-sm mx-auto">
  <h1 class="text-2xl font-semibold mb-6">Sign in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full rounded-md bg-slate-800 border border-slate-700 px-3 py-2 focus:border-amber-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", required: true, class: "w-full rounded-md bg-slate-800 border border-slate-700 px-3 py-2 focus:border-amber-500 focus:outline-none" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-slate-300">
        <%= f.check_box :remember_me, class: "rounded bg-slate-800 border-slate-600" %>
        Remember me
      </label>
    <% end %>

    <%= f.submit "Sign in", class: "w-full px-4 py-2 bg-amber-500 text-slate-900 rounded-md font-medium hover:bg-amber-400 cursor-pointer" %>
  <% end %>

  <div class="mt-6 text-sm text-slate-400 text-center">
    <%= render "devise/shared/links" %>
  </div>
</div>
