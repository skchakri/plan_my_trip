<% content_for :title, "Sign up" %>
<div class="max-w-sm mx-auto">
  <h1 class="text-2xl font-semibold mb-6">Create your account</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.text_field :name, autofocus: true, required: true, class: "w-full rounded-md bg-slate-800 border border-slate-700 px-3 py-2 focus:border-amber-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.email_field :email, autocomplete: "email", required: true, class: "w-full rounded-md bg-slate-800 border border-slate-700 px-3 py-2 focus:border-amber-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true, class: "w-full rounded-md bg-slate-800 border border-slate-700 px-3 py-2 focus:border-amber-500 focus:outline-none" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-slate-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-300 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "w-full rounded-md bg-slate-800 border border-slate-700 px-3 py-2 focus:border-amber-500 focus:outline-none" %>
    </div>

    <%= f.submit "Sign up", class: "w-full px-4 py-2 bg-amber-500 text-slate-900 rounded-md font-medium hover:bg-amber-400 cursor-pointer" %>
  <% end %>

  <div class="mt-6 text-sm text-slate-400 text-center">
    <%= render "devise/shared/links" %>
  </div>
</div>
