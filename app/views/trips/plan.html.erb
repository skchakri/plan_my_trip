<% content_for :title, "Final plan · #{@trip.title_for(current_user)}" %>

<%# Per-day accent colours via CSS variables — Tailwind won't compile dynamic classes,
    so we set --accent on each day card and the rules below pick that up. %>
<% content_for :head do %>
<%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
<style>
  /* Leaflet dark-mode tweaks — match the slate palette of the app */
  .leaflet-container { background: #0a0e1a; }
  .leaflet-control-zoom a { background: rgba(15,23,42,.92); color: #e2e8f0; border: 1px solid rgba(71,85,105,.5); }
  .leaflet-control-zoom a:hover { background: rgba(30,41,59,.95); color: #fde68a; }
  .leaflet-control-attribution { background: rgba(15,23,42,.7); color: #94a3b8; font-size: 10px; }
  .leaflet-control-attribution a { color: #fbbf24; }
  .leaflet-popup-content-wrapper, .leaflet-popup-tip { background: #f8fafc; }

  [data-accent="blue"]    { --accent: 108 163 232; --accent-soft: rgba(108,163,232,.12); --accent-strong: rgba(108,163,232,.30); }
  [data-accent="gold"]    { --accent: 232 160 79;  --accent-soft: rgba(232,160,79,.12);  --accent-strong: rgba(232,160,79,.30); }
  [data-accent="teal"]    { --accent: 93 195 184;  --accent-soft: rgba(93,195,184,.12);  --accent-strong: rgba(93,195,184,.30); }
  [data-accent="pink"]    { --accent: 232 122 166; --accent-soft: rgba(232,122,166,.12); --accent-strong: rgba(232,122,166,.30); }
  [data-accent="violet"]  { --accent: 177 140 217; --accent-soft: rgba(177,140,217,.12); --accent-strong: rgba(177,140,217,.30); }
  [data-accent="emerald"] { --accent: 110 231 183; --accent-soft: rgba(110,231,183,.12); --accent-strong: rgba(110,231,183,.30); }
  [data-accent="rose"]    { --accent: 251 113 133; --accent-soft: rgba(251,113,133,.12); --accent-strong: rgba(251,113,133,.30); }
  .accent-text { color: rgb(var(--accent)); }
  .accent-bg   { background: var(--accent-soft); }
  .accent-bg-strong { background: var(--accent-strong); }
  .accent-border { border-color: var(--accent-strong); }
  .accent-fg-bg { background: rgb(var(--accent)); color: #0a0e1a; }
  .accent-dot::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 999px; background: rgb(var(--accent)); margin-right: 8px; vertical-align: middle; }

  /* ── Print / Save as PDF ────────────────────────────────────────
     Browser-native PDF via Cmd/Ctrl+P. Switches to a light, ink-friendly
     palette and hides chrome that doesn't make sense on paper. Pure CSS,
     no headless-Chrome dependency. */
  @media print {
    /* Hide all app chrome — nav, footers, modals, sticky toolbars,
       and any element explicitly opted out with .no-print. */
    header[class*="sticky"], nav, footer,
    .no-print, [data-controller~="reading-mode"] [role="dialog"],
    [data-reading-mode-target="modal"], [data-action*="reading-mode"] { display: none !important; }

    /* Light page. The screen palette is dark-on-dark; printer ink is
       precious and the slate-950 background would render as a grey wash. */
    html, body { background: #ffffff !important; color: #0a0e1a !important; }
    * { color: #0a0e1a !important; background: transparent !important; box-shadow: none !important; text-shadow: none !important; }
    a, a:visited { color: #0a0e1a !important; text-decoration: underline; }

    /* Keep each day's article together on a page when possible. */
    [data-accent] { page-break-inside: avoid; break-inside: avoid; }
    h1, h2, h3 { page-break-after: avoid; }

    /* Drop the per-day accent backgrounds — they print as ink-heavy bars. */
    .accent-bg, .accent-bg-strong, .accent-fg-bg { background: transparent !important; }
    .accent-text { color: #0a0e1a !important; font-weight: 600; }
    .accent-border { border-color: #cbd5e1 !important; }

    /* Hide map tiles + interactive buttons — they're not useful on paper. */
    .leaflet-container, [data-controller~="interactive-map"] button,
    [data-action*="interactive-map"] { display: none !important; }

    /* Inline checklists / details: force open so subscribers see them. */
    details { display: block !important; }
    details > summary { display: list-item !important; cursor: default; }

    /* Tighter spacing for paper. */
    body { font-size: 11pt; line-height: 1.4; }
    h1 { font-size: 22pt; margin: 0 0 6pt; }
    h2 { font-size: 14pt; margin: 12pt 0 4pt; }
    h3 { font-size: 12pt; margin: 8pt 0 4pt; }
    img { max-width: 100% !important; height: auto !important; max-height: 2.2in; object-fit: contain; }

    /* Page metadata — title, URL, page number — most browsers show these
       by default; if the user disables headers/footers we still want a
       trip title at the top. */
    @page { margin: 0.6in 0.5in; }
  }
</style>
<% end %>

<div class="mb-5">
  <%= link_to @trip, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> <%= @trip.title_for(current_user) %>
  <% end %>
</div>

<header class="mb-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <p class="text-[11px] uppercase tracking-[0.18em] text-slate-400 font-medium mb-1.5 inline-flex items-center gap-2">
        <%= icon :sparkles, class: "w-3.5 h-3.5 text-amber-400" %> Final plan
      </p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight"><%= @trip.title_for(current_user) %></h1>
      <% if @trip.start_date && @trip.end_date %>
        <p class="text-sm text-slate-400 mt-2 inline-flex items-center gap-1.5">
          <%= icon :calendar, class: "w-4 h-4 text-slate-400" %><%= @trip.start_date.strftime("%a, %b %-d") %> – <%= @trip.end_date.strftime("%a, %b %-d, %Y") %>
        </p>
      <% end %>
    </div>
    <div class="no-print shrink-0 flex items-center gap-2">
      <% if @trip.editable_by?(current_user) %>
        <%= link_to edit_plan_trip_path(@trip), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-700 text-slate-200 text-sm hover:border-amber-500/50 hover:bg-slate-800/50 transition-colors" do %>
          <%= icon :pencil, class: "w-4 h-4" %> Edit itinerary
        <% end %>
      <% end %>
      <%# Print / Save-as-PDF button. Hidden from print itself via the
          no-print stylesheet below. %>
      <button type="button"
              onclick="window.print()"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-700 text-slate-200 text-sm hover:border-amber-500/50 hover:bg-slate-800/50 transition-colors"
              title="Save as PDF or print">
        <%= icon :printer, class: "w-4 h-4" %> Save as PDF
      </button>
    </div>
  </div>
</header>

<%# Trip-level controls: Read whole plan (modal) + Drive co-pilot + Save maps offline %>
<%
  map_tile_urls = @days.flat_map { |d| d.activities.map { |a| a.map_tiles&.dig(:tiles) }.compact }.flatten.uniq
  activity_stops = @days.flat_map(&:activities).filter_map do |a|
    next unless a.latitude.present? && a.longitude.present? && a.guide_script.to_s.strip.present?
    {
      id: a.id,
      name: a.location_name.presence || a.title,
      kind: "itinerary",
      lat: a.latitude.to_f,
      lng: a.longitude.to_f,
      script: a.guide_script.to_s.strip,
      image_url: a.hero_image_url.presence
    }
  end
  landmark_stops = @trip.route_landmarks.filter_map do |l|
    next if l.narration.to_s.strip.blank?
    {
      id: l.client_id,
      name: l.name,
      kind: l.kind.presence || "scenic",
      lat: l.latitude.to_f,
      lng: l.longitude.to_f,
      script: l.narration.to_s.strip,
      image_url: l.image_url.presence
    }
  end
  # Layer the shared catalog onto the trip-scoped narrations: any
  # marquee landmark within ~10 mi of the route gets read by the Drive
  # Co-Pilot too. Name-dedup happens in Trip#nearby_global_landmarks.
  global_landmark_stops = @trip.nearby_global_landmarks(radius_m: 16_000).filter_map do |l|
    next if l.narration.to_s.strip.blank?
    {
      id: l.client_id,
      name: l.name,
      kind: l.kind.presence || "scenic",
      lat: l.latitude.to_f,
      lng: l.longitude.to_f,
      script: l.narration.to_s.strip,
      image_url: l.image_url.presence,
      source: "global"
    }
  end
  drive_stops = activity_stops + landmark_stops + global_landmark_stops

  # Pins for the in-app interactive map (Leaflet). Includes every activity
  # with coordinates regardless of guide_script — narration is optional here.
  trip_map_pins = @days.flat_map do |d|
    d.activities.filter_map do |a|
      next unless a.latitude.present? && a.longitude.present?
      {
        lat: a.latitude.to_f,
        lng: a.longitude.to_f,
        name: a.location_name.presence || a.title,
        kind: "itinerary",
        mapsHref: a.maps_link
      }
    end
  end
%>
<div data-controller="interactive-map">
<div data-controller="reading-mode" data-reading-mode-scenes-value="<%= @reading_scenes.to_json %>">
  <div class="mb-5 flex flex-wrap gap-2">
    <div class="inline-flex items-stretch rounded-lg overflow-hidden border border-amber-500/30 bg-amber-500/15">
      <button type="button"
              data-action="reading-mode#open"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm text-amber-200 hover:bg-amber-500/25">
        <%= icon :sparkles, class: "w-4 h-4" %>
        <span>Read the whole plan</span>
      </button>
      <button type="button"
              data-action="reading-mode#cycleSpeed"
              class="px-2.5 py-1.5 text-xs font-semibold tabular-nums text-amber-200/90 border-l border-amber-500/30 hover:bg-amber-500/25 cursor-pointer"
              aria-label="Change playback speed" title="Tap to cycle speed">
        <span data-reading-mode-target="speedLabel">1×</span>
      </button>
    </div>
    <%= link_to copilot_trip_path(@trip), class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-lg bg-slate-800 border border-slate-700 hover:border-amber-500/50 text-slate-100" do %>
      <%= icon :sparkles, class: "w-4 h-4 text-amber-400" %> Road trivia
    <% end %>
    <% if map_tile_urls.any? %>
      <button type="button"
              data-controller="offline-maps"
              data-action="offline-maps#cache"
              data-offline-maps-urls-value="<%= map_tile_urls.to_json %>"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-lg bg-teal-500/15 text-teal-200 border border-teal-500/30 hover:bg-teal-500/25 disabled:opacity-60 disabled:cursor-not-allowed">
        <%= icon :download, class: "w-4 h-4" %>
        <span data-offline-maps-target="status">Save maps offline (<%= map_tile_urls.size %>)</span>
      </button>
    <% end %>
    <% if trip_map_pins.any? %>
      <button type="button"
              data-action="interactive-map#open"
              data-interactive-map-pins-param="<%= trip_map_pins.to_json %>"
              data-interactive-map-title-param="All stops · <%= @trip.title_for(current_user) %>"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-lg bg-sky-500/15 text-sky-200 border border-sky-500/30 hover:bg-sky-500/25 cursor-pointer">
        <%= icon :map_pin, class: "w-4 h-4" %>
        <span>View map (<%= trip_map_pins.size %>)</span>
      </button>
    <% end %>
  </div>

  <%# ---- Road trip legs — per-leg mileage / drive time / fuel cost for
       own-car trips, lazy-loaded (RoadTripEstimator, cached). Sits with the
       Drive Co-Pilot since it's the at-the-wheel companion. ---- %>
  <% if @trip.own_car? %>
    <%= turbo_frame_tag "road-trip-legs", src: road_trip_stats_trip_path(@trip, detail: 1), loading: :lazy,
          data: { controller: "frame-timeout", frame_timeout_timeout_value: 45000 } do %>
      <div class="rounded-2xl border border-amber-500/20 bg-slate-900/40 p-4 sm:p-5 mb-5 animate-pulse" aria-busy="true">
        <div class="h-3 w-24 bg-slate-800 rounded mb-3"></div>
        <div class="space-y-2">
          <div class="h-12 bg-slate-800/70 rounded-xl"></div>
          <div class="h-12 bg-slate-800/70 rounded-xl"></div>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# ---- Drive Co-Pilot (opt-in, geolocation narration) ---- %>
  <% if drive_stops.any? %>
    <div data-controller="drive-copilot"
         data-drive-copilot-stops-value="<%= drive_stops.to_json %>"
         data-drive-copilot-proximity-mi-value="3"
         class="mb-5 rounded-2xl border border-amber-500/25 bg-gradient-to-br from-amber-500/[0.08] via-slate-900/40 to-slate-900/30 p-4 sm:p-5">
      <div class="flex items-start justify-between gap-3 flex-wrap">
        <div class="flex items-start gap-3 min-w-0">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-300 shrink-0">
            <%= icon :car, class: "w-5 h-5" %>
          </span>
          <div class="min-w-0">
            <p class="text-[11px] uppercase tracking-[0.18em] text-amber-300/90 font-semibold">Drive Co-Pilot · live</p>
            <h3 class="font-display text-lg font-semibold text-slate-50 leading-tight">Narrate landmarks as you drive</h3>
            <p class="text-xs sm:text-[13px] text-slate-400 mt-1 leading-relaxed max-w-2xl">
              Uses your location to narrate <strong class="text-slate-200"><%= drive_stops.size %> spots</strong> as you drive
              <% if landmark_stops.any? %>
                (<%= activity_stops.size %> from your plan + <%= landmark_stops.size %> drive-by landmarks along the route)
              <% end %>.
              <span class="text-amber-200/80 font-medium">Passenger-only — never look at your phone while driving.</span>
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button type="button"
                  data-action="drive-copilot#enable"
                  data-drive-copilot-target="enableButton"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-amber-500 text-slate-950 font-semibold text-sm hover:bg-amber-400 shadow-lg shadow-amber-500/20 cursor-pointer">
            <%= icon :sparkles, class: "w-4 h-4" %> Enable
          </button>
          <button type="button"
                  data-action="drive-copilot#playNext"
                  title="Narrate the next stop by hand — no location needed"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-slate-700 text-slate-200 font-semibold text-sm hover:border-amber-500/50 hover:bg-slate-800/50 cursor-pointer">
            <%= icon :play, class: "w-4 h-4" %> Next landmark
          </button>
          <button type="button"
                  data-action="drive-copilot#disable"
                  data-drive-copilot-target="disableButton"
                  hidden
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-rose-500/20 text-rose-200 border border-rose-500/40 font-semibold text-sm hover:bg-rose-500/30 cursor-pointer">
            Stop
          </button>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-amber-500/15 flex items-center justify-between gap-3 flex-wrap">
        <p data-drive-copilot-target="status"
           data-kind="info"
           class="text-xs sm:text-[13px] text-slate-300 leading-snug flex-1 min-w-0
                  data-[kind=error]:text-rose-300 data-[kind=warn]:text-amber-300 data-[kind=playing]:text-emerald-300"></p>
      </div>
    </div>

    <%# Floating narration card — surfaces when speechSynthesis is speaking.
        Fixed bottom-center, ~360px wide on mobile / 480px desktop. Image
        first, name + kind chip, action row with skip. Card slides up via
        CSS transition the controller toggles. %>
    <div data-drive-copilot-target="narratingCard"
         hidden
         class="fixed inset-x-0 bottom-3 z-50 flex justify-center pointer-events-none px-3">
      <div class="pointer-events-auto w-full max-w-md sm:max-w-lg rounded-2xl overflow-hidden border border-emerald-500/40 bg-slate-950/95 backdrop-blur shadow-2xl shadow-emerald-500/20 translate-y-3 opacity-0 transition-all duration-200
                  data-[shown=true]:translate-y-0 data-[shown=true]:opacity-100"
           data-drive-copilot-target="narratingCardInner">
        <%# Image / gradient hero %>
        <div data-drive-copilot-target="narratingImage"
             class="relative aspect-[16/9] bg-cover bg-center bg-gradient-to-br from-slate-800 to-slate-900">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
          <%# Kind chip top-left, animated pulse top-right %>
          <span data-drive-copilot-target="narratingKind"
                class="absolute top-3 left-3 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] uppercase tracking-widest font-semibold bg-slate-950/70 backdrop-blur-sm border border-slate-700/60 text-amber-200/90"></span>
          <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] uppercase tracking-widest font-semibold bg-emerald-500/20 backdrop-blur-sm border border-emerald-500/50 text-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span> Narrating
          </span>
          <%# Name overlaid bottom-left of hero %>
          <h3 data-drive-copilot-target="narratingName"
              class="absolute left-4 right-4 bottom-3 font-display text-lg sm:text-xl font-semibold text-white leading-tight drop-shadow"></h3>
        </div>
        <%# Action row %>
        <div class="px-4 py-2.5 flex items-center justify-between gap-3 border-t border-slate-800">
          <p class="text-[11px] text-slate-400">Drive Co-Pilot · live narration</p>
          <button type="button" data-action="drive-copilot#skipCurrent"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium cursor-pointer">
            Skip <%= icon :arrow_right, class: "w-3 h-3" %>
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <%# Reading-mode modal — hidden until #open is called %>
  <div data-reading-mode-target="modal"
       data-action="click->reading-mode#backdropClose"
       class="hidden fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-md flex items-center justify-center p-3 sm:p-6"
       role="dialog" aria-modal="true" aria-label="Reading the plan">
    <div class="relative w-full max-w-5xl max-h-full overflow-hidden rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-950 shadow-2xl flex flex-col">
      <%# Header %>
      <header class="flex items-center justify-between gap-3 px-5 sm:px-6 py-3 border-b border-slate-800">
        <div class="min-w-0 flex items-center gap-2 flex-wrap">
          <%= icon :sparkles, class: "w-4 h-4 text-amber-400 shrink-0" %>
          <span class="text-[11px] uppercase tracking-[0.18em] text-slate-400 font-semibold truncate">Plan My Trip · Podcast</span>
          <span class="text-xs text-slate-400 tabular-nums shrink-0" data-reading-mode-target="progress">1 / 1</span>
          <span data-reading-mode-target="speakerBadge"
                class="ml-1 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] uppercase tracking-widest font-semibold border border-slate-700 bg-slate-900/60 text-slate-300 data-[voice=host]:border-amber-500/50 data-[voice=host]:text-amber-200 data-[voice=guide]:border-teal-500/50 data-[voice=guide]:text-teal-200"
                data-voice="host">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            <span data-reading-mode-target="speakerLabel">Host</span>
          </span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button type="button" data-action="reading-mode#cycleSpeed"
                  class="inline-flex items-center px-2 py-0.5 rounded-md border border-slate-700 bg-slate-900/60 text-slate-200 text-xs font-semibold tabular-nums hover:border-amber-500/50 hover:text-amber-200 transition-colors cursor-pointer"
                  aria-label="Change playback speed" title="Tap to cycle speed">
            <span data-reading-mode-target="speedLabel">1×</span>
          </button>
          <button type="button" data-action="reading-mode#close"
                  class="text-slate-400 hover:text-white p-1 rounded transition-colors cursor-pointer" aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
      </header>

      <%# Body — photo + map side-by-side on desktop, stacked on mobile %>
      <div class="flex-1 overflow-y-auto">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-0">
          <div class="md:col-span-3 relative bg-slate-800 aspect-video md:aspect-auto md:min-h-[320px] flex items-center justify-center">
            <img data-reading-mode-target="photo" alt="" class="hidden absolute inset-0 w-full h-full object-cover">
            <div data-reading-mode-target="photoFallback" class="text-slate-600">
              <%= icon :sparkles, class: "w-16 h-16" %>
            </div>
          </div>
          <div class="md:col-span-2 relative bg-slate-800 aspect-square md:aspect-auto md:min-h-[320px] border-t md:border-t-0 md:border-l border-slate-800">
            <div data-reading-mode-target="mapGrid" class="absolute inset-0 grid grid-cols-2 grid-rows-2"></div>
            <span data-reading-mode-target="mapPin" class="hidden absolute -translate-x-1/2 -translate-y-full text-rose-500 drop-shadow-[0_1px_2px_rgba(0,0,0,0.7)]">
              <%= icon :map_pin, class: "w-8 h-8", stroke_width: 2 %>
            </span>
            <span class="absolute bottom-0 right-0 px-1.5 py-0.5 text-[10px] bg-black/60 text-white/80 rounded-tl">© OpenStreetMap</span>
            <a data-reading-mode-target="mapsLink" target="_blank" rel="noopener" class="hidden absolute top-2 right-2 inline-flex items-center gap-1 px-2 py-1 text-[11px] rounded-md bg-slate-900/80 backdrop-blur text-slate-200 border border-slate-700 hover:border-amber-500/50">
              <%= icon :external_link, class: "w-3 h-3" %> Open Maps
            </a>
          </div>
        </div>

        <div class="px-5 sm:px-6 py-5">
          <p class="text-[11px] uppercase tracking-[0.18em] text-amber-300 font-semibold mb-1" data-reading-mode-target="eyebrow"></p>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold tracking-tight text-slate-50 leading-tight" data-reading-mode-target="title"></h2>
          <p class="text-sm text-slate-400 mt-1" data-reading-mode-target="subtitle"></p>
          <p class="text-base text-slate-200 mt-4 leading-relaxed" data-reading-mode-target="text"></p>
        </div>
      </div>

      <%# Footer controls %>
      <footer class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3 border-t border-slate-800 bg-slate-950/60">
        <button type="button" data-action="reading-mode#prev"
                class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-slate-700 bg-slate-900 text-slate-200 text-sm hover:border-amber-500/50 cursor-pointer">
          <%= icon :arrow_left, class: "w-4 h-4" %> Prev
        </button>
        <button type="button" data-action="reading-mode#togglePlay"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 cursor-pointer">
          <%= icon :sparkles, class: "w-4 h-4" %>
          <span data-reading-mode-target="playPauseLabel">Pause</span>
        </button>
        <button type="button" data-action="reading-mode#next"
                class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-slate-700 bg-slate-900 text-slate-200 text-sm hover:border-amber-500/50 cursor-pointer">
          Next <%= icon :arrow_right, class: "w-4 h-4" %>
        </button>
      </footer>
    </div>
  </div>
</div>

<% if @trip.excitement_pitch.present? %>
  <div class="mb-5 rounded-xl border border-amber-500/30 bg-gradient-to-br from-amber-500/10 to-transparent p-4">
    <p class="text-[11px] uppercase tracking-widest text-amber-300 font-semibold mb-1">Why you'll love this trip</p>
    <p class="text-slate-100 leading-relaxed"><%= @trip.excitement_pitch %></p>
  </div>
<% end %>

<% if @trip.pwa_plan_url.present? %>
  <div class="mb-5 rounded-xl border border-teal-500/30 bg-teal-500/5 p-4 flex items-start gap-3">
    <span class="shrink-0 mt-0.5 text-teal-300"><%= icon :external_link, class: "w-4 h-4" %></span>
    <div class="text-sm">
      <p class="text-teal-100 font-medium">A standalone PWA itinerary exists for this trip</p>
      <p class="text-slate-400 mt-0.5">It works offline on its own home-screen icon. <%= link_to "Open the standalone plan →", @trip.pwa_plan_url, target: "_blank", rel: "noopener", class: "text-teal-300 hover:text-teal-200 underline-offset-2 hover:underline" %></p>
    </div>
  </div>
<% end %>

<%# This wrapper holds everything the "Read the whole plan" button speaks. %>
<div id="plan-readable">

<% if @days.empty? %>
  <div class="rounded-2xl border border-dashed border-slate-700/70 bg-slate-900/30 p-8 text-center mb-6">
    <p class="text-slate-300 font-medium">No day-by-day plan yet</p>
    <p class="text-sm text-slate-400 mt-1 max-w-md mx-auto">Add days and activities so the trip shows photos, addresses, deep-linked maps, and inline checklist items per day. For now you can still see the markdown notes below.</p>
  </div>
<% else %>
  <%# Day picker (jump-anchor strip) %>
  <nav class="sticky top-[60px] z-20 -mx-4 sm:-mx-6 px-4 sm:px-6 mb-4 bg-slate-950/85 backdrop-blur-md border-b border-slate-800/70 py-2 overflow-x-auto" aria-label="Days">
    <div class="flex gap-2 min-w-max">
      <% @days.each_with_index do |day, idx| %>
        <a href="#day-<%= day.id %>" data-accent="<%= day.accent %>" class="shrink-0 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border accent-border accent-bg text-slate-200 hover:accent-bg-strong text-sm">
          <span class="text-[10px] uppercase tracking-widest accent-text font-semibold">Day <%= idx + 1 %></span>
          <span class="font-medium"><%= day.date&.strftime("%a %-d") || day.title %></span>
        </a>
      <% end %>
    </div>
  </nav>

  <%# Day cards %>
  <div class="space-y-6">
    <% @days.each_with_index do |day, idx|
         day_items = day.checklist_items.to_a %>
      <article id="day-<%= day.id %>" data-accent="<%= day.accent %>" class="rounded-2xl border accent-border bg-slate-900/40 overflow-hidden">
        <header class="px-5 sm:px-6 pt-5 pb-4 accent-bg">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
            <div class="min-w-0">
              <p class="text-[11px] uppercase tracking-[0.18em] accent-text font-semibold mb-1 accent-dot">
                Day <%= idx + 1 %><% if day.theme.present? %> · <%= day.theme %><% end %>
              </p>
              <h2 class="font-display text-2xl font-semibold tracking-tight">
                <% if day.date %><span class="text-slate-300 font-normal"><%= day.date.strftime("%A %b %-d") %> — </span><% end %><%= day.title %>
              </h2>
              <% if day.summary.present? %>
                <p class="text-sm text-slate-300 mt-2"><%= day.summary %></p>
              <% end %>
            </div>
            <% read_text = "Day #{idx + 1}, #{day.title}.#{day.summary.present? ? " #{day.summary}" : ""} #{day.activities.map { |a| [a.time_label, a.title, a.famous_for.presence || a.notes.to_s.split('.').first].compact.join('. ') }.join(' Then, ')}" %>
            <div class="shrink-0 flex items-center flex-wrap gap-2">
              <% if (dir_url = day_directions_url(day)) %>
                <%= link_to dir_url, target: "_blank", rel: "noopener",
                      class: "inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md border border-slate-700 bg-slate-900/60 text-slate-200 text-xs hover:border-amber-500/50" do %>
                  <%= icon :navigation, class: "w-3.5 h-3.5 text-amber-400" %>
                  Navigate day
                <% end %>
              <% end %>
              <button type="button"
                      data-controller="tts"
                      data-tts-text-value="<%= read_text %>"
                      class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md border border-slate-700 bg-slate-900/60 text-slate-200 text-xs hover:border-amber-500/50">
                <%= icon :sparkles, class: "w-3.5 h-3.5 text-amber-400" %>
                <span data-tts-label data-play-label="Read day" data-stop-label="Stop">Read day</span>
              </button>
            </div>
          </div>
        </header>

        <%# Activities — vertical timeline: time chip on left rail,
            card on right with image hero + text + small map. %>
        <% if day.activities.any? %>
          <ol class="relative pl-12 sm:pl-16 pr-4 sm:pr-5 py-5 sm:py-6">
            <%# Timeline rail — vertical line behind the time chips %>
            <span aria-hidden="true" class="absolute left-[20px] sm:left-[28px] top-7 bottom-7 w-px bg-slate-700/60"></span>
            <% day.activities.each_with_index do |activity, ai| %>
              <li class="relative <%= 'mb-6 sm:mb-8' unless ai == day.activities.size - 1 %>">
                <%# Time chip on the timeline rail %>
                <span class="absolute left-[-44px] sm:left-[-56px] top-1 inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-full accent-bg accent-border border-2 ring-4 ring-slate-950 shadow-lg shadow-black/40">
                  <% if activity.time_label.present? %>
                    <span class="text-[9px] sm:text-[10px] font-semibold tabular-nums accent-text leading-[1.15] text-center">
                      <%# time_label comes from AI output — escape it before injecting the <br>. %>
                      <%= h(activity.time_label).gsub(/\s*(AM|PM)\b/i) { "<br>#{Regexp.last_match(1).upcase}" }.html_safe %>
                    </span>
                  <% else %>
                    <span class="w-2 h-2 rounded-full accent-fg-bg"></span>
                  <% end %>
                </span>

                <%# Card to the right of the rail %>
                <div class="rounded-2xl border border-slate-800/80 bg-slate-900/50 overflow-hidden">
                  <% map = activity.map_tiles %>

                  <% hero_url = activity.hero_image_url %>
                  <%
                    if map
                      day_pins = day.activities.filter_map { |a|
                        next unless a.latitude.present? && a.longitude.present?
                        {
                          lat: a.latitude.to_f,
                          lng: a.longitude.to_f,
                          name: a.location_name.presence || a.title,
                          kind: "itinerary",
                          mapsHref: a.maps_link
                        }
                      }
                      focus_pin = { lat: activity.latitude.to_f, lng: activity.longitude.to_f }
                      modal_title = "Day #{idx + 1} · #{activity.location_name.presence || activity.title}"
                    end
                  %>

                  <%# Upper region — media-object layout. On laptop the description
                      sits on the LEFT and a compact media rail (photo + map, ~300px)
                      on the RIGHT; everything stacks on mobile with the photo first. %>
                  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-5 lg:items-start lg:p-5">
                    <%# Media rail — first in DOM so the photo leads on mobile;
                        order-2 moves it to the right column on laptop. %>
                    <div class="order-1 lg:order-2 flex flex-col gap-3">
                      <% if hero_url.present? %>
                        <div class="relative aspect-[16/9] lg:aspect-[4/3] bg-slate-800 overflow-hidden lg:rounded-xl">
                      <img loading="lazy" src="<%= hero_url %>" alt="<%= activity.location_name.presence || activity.title %>" class="w-full h-full object-cover" referrerpolicy="no-referrer">
                      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/10 to-transparent"></div>
                      <% if activity.group_label.present? %>
                        <span class="absolute top-3 left-3 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] uppercase tracking-widest font-semibold bg-slate-950/70 backdrop-blur-sm border border-slate-700/60 text-amber-200/90"><%= activity.group_label %></span>
                      <% end %>
                      <%# Photo upload overlay — top-right of the hero %>
                      <%= form_with url: trip_activity_photos_path(@trip, activity), multipart: true, html: { class: "absolute top-3 right-3", data: { turbo: false } } do %>
                        <label class="cursor-pointer inline-flex items-center gap-1 px-2 py-1 rounded-md bg-slate-950/70 border border-slate-700/60 text-amber-200/90 text-[10px] uppercase tracking-widest backdrop-blur-sm hover:border-amber-500/50 hover:text-amber-200 transition-colors">
                          <%= icon :camera, class: "w-3.5 h-3.5" %>
                          <span>Add photo</span>
                          <%= file_field_tag "activity[photos][]", multiple: true, accept: "image/*", class: "sr-only", onchange: "this.form.requestSubmit()" %>
                        </label>
                      <% end %>
                      <% if activity.location_name.present? %>
                        <% loc_inner = capture do %>
                          <%= icon :map_pin, class: "w-3.5 h-3.5 text-amber-300 shrink-0" %><span class="truncate"><%= activity.location_name %></span>
                          <% if activity.place %><%= icon :arrow_right, class: "w-3 h-3 text-amber-300/70 shrink-0 opacity-0 group-hover/hero:opacity-100 transition-opacity" %><% end %>
                        <% end %>
                        <% if activity.place %>
                          <%= link_to place_path(activity.place), class: "group/hero absolute bottom-3 left-3 right-3 text-xs sm:text-sm text-slate-100/90 font-medium drop-shadow inline-flex items-center gap-1.5 hover:text-amber-200 transition-colors" do %><%= loc_inner %><% end %>
                        <% else %>
                          <p class="absolute bottom-3 left-3 right-3 text-xs sm:text-sm text-slate-100/90 font-medium drop-shadow inline-flex items-center gap-1.5"><%= loc_inner %></p>
                        <% end %>
                      <% end %>
                    </div>
                      <% else %>
                        <%# No photo yet — a dashed upload card keeps the rail balanced. %>
                        <%= form_with url: trip_activity_photos_path(@trip, activity), multipart: true, html: { data: { turbo: false } } do %>
                          <label class="cursor-pointer flex flex-col items-center justify-center gap-1.5 aspect-[16/9] lg:aspect-[4/3] lg:rounded-xl border border-dashed border-slate-700/60 bg-slate-900/40 text-slate-400 hover:border-amber-500/50 hover:text-amber-200 transition-colors">
                            <%= icon :camera, class: "w-6 h-6" %>
                            <span class="text-[10px] uppercase tracking-widest">Add photo</span>
                            <%= file_field_tag "activity[photos][]", multiple: true, accept: "image/*", class: "sr-only", onchange: "this.form.requestSubmit()" %>
                          </label>
                        <% end %>
                      <% end %>

                      <%# Map thumbnail — tap to open the interactive Leaflet map. %>
                      <% if map %>
                        <div class="flex flex-col gap-2 px-4 sm:px-5 lg:px-0">
                          <button type="button"
                                  data-action="interactive-map#open"
                                  data-interactive-map-pins-param="<%= day_pins.to_json %>"
                                  data-interactive-map-focus-param="<%= focus_pin.to_json %>"
                                  data-interactive-map-title-param="<%= modal_title %>"
                                  class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-slate-800 border border-slate-700/60 cursor-pointer group hover:border-amber-500/50 transition-colors"
                                  aria-label="Open interactive map for <%= activity.location_name.presence || activity.title %>">
                            <div class="absolute inset-0 grid grid-cols-2 grid-rows-2">
                              <% map[:tiles].each do |tile_url| %>
                                <img loading="lazy" src="<%= tile_url %>" alt="" class="w-full h-full object-cover" referrerpolicy="no-referrer">
                              <% end %>
                            </div>
                            <span class="absolute -translate-x-1/2 -translate-y-full text-rose-500 drop-shadow-[0_1px_2px_rgba(0,0,0,0.7)] pointer-events-none"
                                  style="left: <%= map[:pin_x_pct].round(2) %>%; top: <%= map[:pin_y_pct].round(2) %>%;">
                              <%= icon :map_pin, class: "w-7 h-7", stroke_width: 2 %>
                            </span>
                            <span class="absolute bottom-0 right-0 px-1 py-0.5 text-[9px] bg-black/60 text-white/80 rounded-tl pointer-events-none">© OpenStreetMap</span>
                            <span class="absolute top-1.5 right-1.5 inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] rounded bg-slate-900/80 backdrop-blur-sm text-slate-200 border border-slate-700/60 group-hover:border-amber-500/50 group-hover:text-amber-200 pointer-events-none">
                              <%= icon :map_pin, class: "w-3 h-3" %> Open
                            </span>
                          </button>
                          <% if (link = activity.maps_link) %>
                            <%= link_to link, target: "_blank", rel: "noopener",
                                  class: "inline-flex items-center justify-center gap-1.5 w-full text-xs px-3 py-1.5 rounded-md bg-slate-800 text-slate-200 border border-slate-700 hover:border-amber-500/50 hover:text-amber-200 transition-colors" do %>
                              <%= icon :navigation, class: "w-3.5 h-3.5 text-amber-300" %>
                              <span>Go</span>
                              <%= icon :external_link, class: "w-3 h-3 opacity-60" %>
                            <% end %>
                          <% end %>
                        </div>
                      <% end %>
                    </div><%# /media rail %>

                  <%# Description — left column on laptop, below the photo on mobile. %>
                  <div class="order-2 lg:order-1 min-w-0 px-4 sm:px-5 pt-4 sm:pt-5 lg:p-0">
                      <%# Eyebrow row — only when there's no photo (else
                          group_label / location appear over the photo) %>
                      <% if hero_url.blank? && (activity.group_label.present? || activity.time_label.present?) %>
                        <div class="flex items-baseline gap-2 flex-wrap mb-1.5">
                          <% if activity.group_label.present? %>
                            <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold"><%= activity.group_label %></span>
                          <% end %>
                        </div>
                      <% end %>
                      <% activity_read_text = [activity.title, activity.location_name, activity.famous_for.presence, activity.notes.to_s.gsub(/[*_`]/, ' ')].compact.reject(&:blank?).join('. ') %>
                      <div class="flex items-start gap-2">
                        <% if activity_read_text.present? %>
                          <button type="button"
                                  data-controller="tts"
                                  data-tts-text-value="<%= activity_read_text %>"
                                  aria-label="Read aloud"
                                  title="Read aloud"
                                  class="shrink-0 mt-0.5 inline-flex items-center justify-center w-9 h-9 rounded-full border border-slate-700 bg-slate-900/60 text-amber-300 hover:border-amber-500/50 hover:text-amber-200 transition-colors">
                            <%= icon :volume_2, class: "w-4 h-4" %>
                            <span class="sr-only" data-tts-label data-play-label="Read aloud" data-stop-label="Stop">Read aloud</span>
                          </button>
                        <% end %>
                        <h3 class="min-w-0 flex-1 font-display text-lg sm:text-xl font-semibold text-slate-50 leading-tight"><%= activity.title %></h3>
                        <% if (link = activity.uber_link) %>
                          <%= link_to link, target: "_blank", rel: "noopener", aria: { label: "Open in Uber" }, title: "Open in Uber",
                                class: "shrink-0 mt-0.5 inline-flex items-center justify-center w-9 h-9 rounded-full border border-slate-700 bg-slate-900/60 text-slate-300 hover:border-amber-500/50 hover:text-amber-200 transition-colors" do %>
                            <%= icon :car, class: "w-4 h-4" %>
                            <span class="sr-only">Open in Uber</span>
                          <% end %>
                        <% end %>
                      </div>
                      <% if hero_url.blank? && activity.location_name.present? %>
                        <% if activity.place %>
                          <%= link_to place_path(activity.place), class: "group inline-flex items-center gap-1 mt-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
                            <%= icon :map_pin, class: "w-3.5 h-3.5 text-slate-400 group-hover:text-amber-400" %><%= activity.location_name %>
                            <%= icon :arrow_right, class: "w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" %>
                          <% end %>
                        <% else %>
                          <p class="text-sm text-slate-400 inline-flex items-center gap-1 mt-1">
                            <%= icon :map_pin, class: "w-3.5 h-3.5 text-slate-400" %><%= activity.location_name %>
                          </p>
                        <% end %>
                      <% end %>
                      <% if activity.address.present? %>
                        <p class="text-xs text-slate-400 mt-0.5"><%= activity.address %></p>
                      <% end %>
                      <% if activity.famous_for.present? %>
                        <p class="text-sm text-amber-200/90 mt-2.5 leading-relaxed inline-flex items-start gap-1.5">
                          <%= icon :sparkles, class: "w-4 h-4 mt-0.5 shrink-0" %>
                          <span><span class="font-semibold">Famous for:</span> <%= activity.famous_for %></span>
                        </p>
                      <% end %>
                      <% if activity.notes.present? %>
                        <div class="text-sm text-slate-300 mt-2.5 leading-relaxed prose-invert"><%= render_markdown(activity.notes) %></div>
                      <% end %>
                    </div>

                  </div><%# /upper region grid %>

                  <%# Full-width footer: Documents + Activity checklist %>
                  <div class="px-4 sm:px-5 pb-4 sm:pb-5 pt-4 space-y-3">
                    <%# Inline activity documents (tickets, confirmations, etc.) %>
                    <% docs = activity.documents.attached? ? activity.documents : [] %>
                    <details class="mt-3 rounded-lg border border-slate-700/50 bg-slate-800/30" <%= 'open'.html_safe if docs.any? %>>
                      <summary class="cursor-pointer px-3 py-2 text-xs flex items-center justify-between gap-2 text-slate-300">
                        <span class="inline-flex items-center gap-1.5">
                          <%= icon :external_link, class: "w-3.5 h-3.5 text-amber-400" %>
                          Documents <% if docs.any? %><span class="text-slate-400 font-normal">· <%= docs.size %></span><% end %>
                        </span>
                        <span class="text-[11px] text-slate-400">tickets · confirmations</span>
                      </summary>
                      <div class="px-3 pb-3 space-y-2">
                        <% if docs.any? %>
                          <ul class="space-y-1.5">
                            <% docs.each do |doc| %>
                              <li class="flex items-center justify-between gap-2 rounded-md bg-slate-900/60 border border-slate-700/40 px-2.5 py-1.5">
                                <%= link_to rails_blob_path(doc, disposition: "inline"), target: "_blank", rel: "noopener", class: "min-w-0 flex items-center gap-2 text-sm text-slate-200 hover:text-amber-200 truncate" do %>
                                  <span class="shrink-0 text-slate-500"><%= icon :external_link, class: "w-3.5 h-3.5" %></span>
                                  <span class="truncate"><%= doc.filename %></span>
                                  <span class="shrink-0 text-[11px] text-slate-400">· <%= number_to_human_size(doc.byte_size) %></span>
                                <% end %>
                                <%= button_to trip_activity_document_path(@trip, activity, doc), method: :delete, form: { data: { turbo_confirm: "Remove #{doc.filename}?" } }, class: "shrink-0 text-rose-400 hover:text-rose-300 p-1 rounded transition-colors cursor-pointer", aria: { label: "Remove" } do %>
                                  <%= icon :trash, class: "w-3.5 h-3.5" %>
                                <% end %>
                              </li>
                            <% end %>
                          </ul>
                        <% else %>
                          <p class="text-xs text-slate-400 italic">No documents attached yet — upload tickets, confirmations, or anything else you'd want on your phone for this stop.</p>
                        <% end %>

                        <%= form_with url: trip_activity_documents_path(@trip, activity), method: :post, multipart: true, html: { class: "flex items-center gap-2 mt-2", data: { turbo: false } } do |f| %>
                          <%= file_field_tag "activity[documents][]", multiple: true, accept: "image/*,application/pdf,.ics,.txt", class: "block w-full text-xs text-slate-300 file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:bg-amber-500/15 file:text-amber-200 hover:file:bg-amber-500/25 file:cursor-pointer cursor-pointer" %>
                          <%= submit_tag "Upload", class: "shrink-0 px-3 py-1.5 bg-amber-500 text-slate-950 rounded-md text-xs font-semibold hover:bg-amber-400 cursor-pointer" %>
                        <% end %>
                        <p class="text-[11px] text-slate-400">PDF, image, .ics, or .txt — up to <%= number_to_human_size(Activity::MAX_DOCUMENT_BYTES) %> per file.</p>
                      </div>
                    </details>

                    <%# Inline activity checklist %>
                    <% activity_items = activity.checklist_items.to_a %>
                    <% if activity_items.any? %>
                      <details class="mt-3 rounded-lg border border-slate-700/50 bg-slate-800/30">
                        <summary class="cursor-pointer px-3 py-2 text-xs flex items-center justify-between gap-2 text-slate-300">
                          <span class="inline-flex items-center gap-1.5">
                            <%= icon :check, class: "w-3.5 h-3.5 text-emerald-400" %>
                            Activity checklist
                          </span>
                          <span class="text-[11px] tabular-nums text-slate-400"><%= activity.packed_count %>/<%= activity_items.size %></span>
                        </summary>
                        <ul class="px-2 pb-2 divide-y divide-slate-700/50">
                          <% activity_items.each do |item| %>
                            <%= render item %>
                          <% end %>
                        </ul>
                      </details>
                    <% end %>

                    <%= render "comments/thread", trip: @trip, activity: activity %>
                  </div>
                </div>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="px-5 py-4 text-sm text-slate-400 italic">No activities scheduled for this day yet.</p>
        <% end %>

        <div class="px-5 py-3 border-t border-slate-800/60">
          <%= render "suggestions/board", trip: @trip, trip_day: day %>
        </div>

        <%# Inline day checklist %>
        <% if day_items.any? %>
          <details class="border-t border-slate-800/60 bg-slate-900/30">
            <summary class="cursor-pointer px-5 py-3 flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-2 text-sm font-medium text-slate-200">
                <%= icon :check, class: "w-4 h-4 text-emerald-400" %>
                Day checklist
              </span>
              <span class="text-xs tabular-nums text-slate-400"><%= day.packed_count %>/<%= day_items.size %></span>
            </summary>
            <ul class="px-3 pb-3 divide-y divide-slate-800/50">
              <% day_items.each do |item| %>
                <%= render item %>
              <% end %>
            </ul>
          </details>
        <% end %>
      </article>
    <% end %>
  </div>
<% end %>
</div><%# /plan-readable %>

<%# Free-form markdown notes (fallback) %>
<% if @rendered_body.present? %>
  <details class="mt-8 rounded-2xl border border-slate-800 bg-slate-900/30">
    <summary class="cursor-pointer px-5 py-4 flex items-center justify-between gap-2">
      <span class="inline-flex items-center gap-2 text-sm font-medium text-slate-200">
        <%= icon :list, class: "w-4 h-4 text-slate-400" %>
        Trip notes (markdown)
      </span>
      <%= icon :chevron_down, class: "w-4 h-4 text-slate-400" %>
    </summary>
    <article class="prose-invert px-5 sm:px-6 pb-6">
      <%= @rendered_body %>
    </article>
  </details>
<% end %>

<%# Interactive map modal (Leaflet). Hidden until a thumbnail or the
    "View map" button calls interactive-map#open with pin params. %>
<div data-interactive-map-target="modal"
     hidden
     data-action="click->interactive-map#closeOnBackdrop"
     data-open="false"
     class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 opacity-0 transition-opacity duration-150 data-[open=true]:opacity-100"
     role="dialog" aria-modal="true" aria-label="Map">
  <div class="relative w-full max-w-5xl max-h-full overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-2xl flex flex-col">
    <header class="flex items-center justify-between gap-3 px-5 py-3 border-b border-slate-800">
      <div class="min-w-0">
        <p class="text-[11px] uppercase tracking-[0.18em] text-amber-300 font-semibold truncate" data-interactive-map-target="title">Map</p>
        <p class="text-xs text-slate-400 truncate" data-interactive-map-target="subtitle"></p>
      </div>
      <button type="button" data-action="interactive-map#close"
              class="text-slate-400 hover:text-white p-1 rounded transition-colors cursor-pointer" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </header>
    <div data-interactive-map-target="mapEl" class="w-full h-[70vh] sm:h-[600px]"></div>
  </div>
</div>
</div>
