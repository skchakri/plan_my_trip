<% content_for :title, "Plan · #{@trip.title_for(current_user)}" %>

<div class="mb-5">
  <%= link_to @trip, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> <%= @trip.title_for(current_user) %>
  <% end %>
</div>

<header class="mb-6">
  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 font-medium mb-1.5 inline-flex items-center gap-2">
    <%= icon :sparkles, class: "w-3.5 h-3.5 text-amber-400" %> Plan
  </p>
  <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight"><%= @trip.title_for(current_user) %></h1>
  <% if @trip.start_date && @trip.end_date %>
    <p class="text-sm text-slate-400 mt-2 inline-flex items-center gap-1.5">
      <%= icon :calendar, class: "w-4 h-4 text-slate-500" %><%= @trip.start_date.strftime("%a, %b %-d") %> – <%= @trip.end_date.strftime("%a, %b %-d, %Y") %>
    </p>
  <% end %>
</header>

<article class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-7">
  <% if @rendered_body.blank? %>
    <p class="text-slate-500 italic">No plan yet. <%= link_to "Add one", edit_trip_path(@trip), class: "text-amber-300 underline-offset-2 hover:underline" %>.</p>
  <% else %>
    <div class="prose-invert">
      <%= @rendered_body %>
    </div>
  <% end %>
</article>

<% if @trip.pwa_plan_url.present? %>
  <div class="mt-6 rounded-xl border border-slate-800 bg-slate-900/30 p-4 text-sm text-slate-400">
    A standalone PWA version exists for this trip:
    <%= link_to @trip.pwa_plan_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1 text-amber-300 hover:text-amber-200 ml-1" do %>
      Open separately <%= icon :external_link, class: "w-3 h-3" %>
    <% end %>
  </div>
<% end %>
