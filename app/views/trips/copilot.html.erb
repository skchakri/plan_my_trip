<% content_for :title, "Drive co-pilot · #{@trip.title_for(current_user)}" %>

<div class="mb-5">
  <%= link_to plan_trip_path(@trip), class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> Final plan
  <% end %>
</div>

<header class="mb-6 text-center">
  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 font-medium mb-1.5 inline-flex items-center gap-2">
    <%= icon :car, class: "w-3.5 h-3.5 text-amber-400" %> Drive co-pilot
  </p>
  <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight">Pick a traveler</h1>
  <p class="text-sm text-slate-400 mt-2 max-w-md mx-auto">We'll ask them a question they'll love. Answer right and they pick the music.</p>
</header>

<% if @people.empty? %>
  <div class="rounded-2xl border border-dashed border-slate-700/70 bg-slate-900/30 p-8 text-center">
    <p class="text-slate-300 font-medium mb-1">No travelers added yet</p>
    <p class="text-sm text-slate-500 mb-4">Add the people on this trip with their interests so the co-pilot can ask the right questions.</p>
    <%= link_to "Add travelers on the trip page", @trip, class: "inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-amber-500 text-slate-950 font-semibold text-sm hover:bg-amber-400" %>
  </div>
<% else %>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
    <% @people.each do |p| %>
      <%= link_to copilot_question_trip_path(@trip, person_id: p.id), class: "group rounded-2xl border border-slate-800 bg-slate-900/60 hover:border-amber-500/50 p-5 text-center transition-all" do %>
        <div class="mx-auto w-14 h-14 rounded-full bg-gradient-to-br from-amber-500/20 to-amber-500/5 border border-amber-500/30 flex items-center justify-center text-amber-200 font-semibold text-lg group-hover:scale-105 transition-transform">
          <%= p.initials %>
        </div>
        <h2 class="font-display text-lg font-semibold mt-3 leading-tight"><%= p.name %></h2>
        <% if p.interests_label %>
          <p class="text-[11px] text-slate-400 mt-0.5"><%= p.interests_label %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
