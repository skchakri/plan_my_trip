<% content_for :title, "Checklist · #{@trip.title_for(current_user)}" %>

<div class="mb-5">
  <%= link_to @trip, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> <%= @trip.title_for(current_user) %>
  <% end %>
</div>

<header class="mb-6">
  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 font-medium mb-1.5 inline-flex items-center gap-2">
    <%= icon :check, class: "w-3.5 h-3.5 text-emerald-400" %> Checklist
  </p>
  <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight"><%= @trip.title_for(current_user) %></h1>
  <p class="text-sm text-slate-400 mt-2">Tap a circle to mark packed. Saved automatically — works offline once visited.</p>
</header>

<%= render "checklist_progress", trip: @trip %>

<%# Add-item form: simple inline composer %>
<section class="mt-5 rounded-2xl border border-slate-800 bg-slate-900/40 p-4">
  <%= form_with url: trip_checklist_items_path(@trip), method: :post, class: "flex gap-2", data: { turbo_frame: "_top" } do |f| %>
    <%= f.text_field :title, required: true, placeholder: "Add an item…", autofocus: false, class: "flex-1 rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 focus:outline-none" %>
    <%= f.text_field :category, placeholder: "Category", class: "w-32 rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none hidden sm:block" %>
    <%= f.submit "Add", class: "px-4 py-2 bg-amber-500 text-slate-950 rounded-lg font-semibold text-sm hover:bg-amber-400 cursor-pointer" %>
  <% end %>
  <p class="text-xs text-slate-500 mt-2">Tip — the optional category groups items into sections (e.g. "Kids", "Sphere", "Drive").</p>
</section>

<% if @items.empty? %>
  <div class="mt-6 rounded-2xl border border-dashed border-slate-700/70 bg-slate-900/30 p-10 text-center">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-300 mb-3">
      <%= icon :check, class: "w-6 h-6" %>
    </div>
    <p class="text-slate-300 font-medium">No checklist items yet</p>
    <p class="text-sm text-slate-500 mt-1">Add your first item above. They save instantly and are available offline.</p>
  </div>
<% else %>
  <div class="mt-6 space-y-5">
    <% @grouped.each do |category, items| %>
      <section>
        <h2 class="text-xs uppercase tracking-widest text-slate-400 font-semibold mb-2 px-2"><%= category %></h2>
        <ul id="checklist-<%= category.parameterize %>" class="rounded-2xl border border-slate-800 bg-slate-900/40 divide-y divide-slate-800/50 overflow-hidden">
          <% items.each do |item| %>
            <%= render item %>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
<% end %>

<% if @trip.pwa_packing_url.present? %>
  <div class="mt-6 rounded-xl border border-slate-800 bg-slate-900/30 p-4 text-sm text-slate-400">
    A standalone PWA version exists for this trip:
    <%= link_to @trip.pwa_packing_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1 text-amber-300 hover:text-amber-200 ml-1" do %>
      Open separately <%= icon :external_link, class: "w-3 h-3" %>
    <% end %>
  </div>
<% end %>
