<% content_for :title, "Checklist · #{@trip.title_for(current_user)}" %>

<div class="mb-5">
  <%= link_to @trip, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> <%= @trip.title_for(current_user) %>
  <% end %>
</div>

<header class="mb-5">
  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 font-medium mb-1.5 inline-flex items-center gap-2">
    <%= icon :check, class: "w-3.5 h-3.5 text-emerald-400" %> Checklist
  </p>
  <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight"><%= @trip.title_for(current_user) %></h1>
  <p class="text-sm text-slate-400 mt-2">Items grouped by when they matter — overall trip, each day, each activity. Toggles save instantly. Once you've opened this page online it stays viewable offline; reconnect to save new changes.</p>
</header>

<%= render "checklist_progress", trip: @trip %>

<%# Undo bar target — destroy renders an undo affordance here. %>
<div id="checklist-flash" aria-live="polite"></div>

<% if @trip.pwa_packing_url.present? %>
  <div class="mt-4 rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-4 flex items-start gap-3">
    <span class="shrink-0 mt-0.5 text-emerald-300"><%= icon :external_link, class: "w-4 h-4" %></span>
    <div class="text-sm">
      <p class="text-emerald-100 font-medium">A standalone PWA checklist exists for this trip</p>
      <p class="text-slate-400 mt-0.5">It works offline on its own home-screen icon. <%= link_to "Open the standalone checklist →", @trip.pwa_packing_url, target: "_blank", rel: "noopener", class: "text-emerald-300 hover:text-emerald-200 underline-offset-2 hover:underline" %></p>
    </div>
  </div>
<% end %>

<%# Add-item form: scope, day/activity label (when relevant), title %>
<section class="mt-5 rounded-2xl border border-slate-800 bg-slate-900/40 p-4 space-y-3">
  <%= form_with url: trip_checklist_items_path(@trip), method: :post, class: "space-y-2", data: { turbo_frame: "_top" } do |f| %>
    <div class="flex flex-wrap gap-2 text-xs">
      <% [["before_trip","Before trip"], ["day","For a day"], ["activity","For an activity"]].each_with_index do |(val, lbl), i| %>
        <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-700 bg-slate-800/40 hover:border-amber-500/50 cursor-pointer has-checked:bg-amber-500/15 has-checked:border-amber-500/50 has-checked:text-amber-200">
          <%= radio_button_tag "checklist_item[scope]", val, i == 0, class: "sr-only" %>
          <%= lbl %>
        </label>
      <% end %>
    </div>

    <div class="flex flex-col sm:flex-row gap-2">
      <%= text_field_tag "checklist_item[day_label]", nil, list: "day-options", placeholder: "Day label (e.g. Friday — Sphere day)", class: "flex-1 rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none" %>
      <%= text_field_tag "checklist_item[activity_label]", nil, list: "activity-options", placeholder: "Activity label (e.g. Sphere — Wizard of Oz)", class: "flex-1 rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none" %>
    </div>
    <datalist id="day-options"><% @day_options.each do |d| %><option value="<%= d %>"><% end %></datalist>
    <datalist id="activity-options"><% @activity_options.each do |a| %><option value="<%= a %>"><% end %></datalist>

    <div class="flex gap-2">
      <%= text_field_tag "checklist_item[title]", nil, required: true, placeholder: "Add an item…", class: "flex-1 rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 focus:outline-none" %>
      <%= text_field_tag "checklist_item[person]", nil, placeholder: "Person (optional)", class: "w-32 rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none hidden sm:block" %>
      <%= submit_tag "Add", class: "px-4 py-2 bg-amber-500 text-slate-950 rounded-lg font-semibold text-sm hover:bg-amber-400 cursor-pointer" %>
    </div>
    <p class="text-xs text-slate-500">Day and activity labels are only used when the corresponding scope is picked. Existing labels autocomplete.</p>
  <% end %>
</section>

<%# Sectioned checklists %>
<% ChecklistItem::SCOPES.each do |scope_key|
     section_groups = @grouped[scope_key]
     progress = @section_progress[scope_key] %>
  <% next if section_groups.empty? && scope_key != "before_trip" %>
  <section class="mt-7" id="scope-<%= scope_key %>">
    <div class="flex items-center justify-between mb-2">
      <h2 class="font-display text-xl font-semibold flex items-center gap-2">
        <%= icon scope_key == "before_trip" ? :sparkles : (scope_key == "day" ? :calendar : :ticket), class: "w-5 h-5 text-amber-400/80" %>
        <%= ChecklistItem::SCOPE_LABELS[scope_key] %>
      </h2>
      <% if progress[:total] > 0 %>
        <span class="text-xs text-slate-400 tabular-nums"><%= progress[:packed] %>/<%= progress[:total] %></span>
      <% end %>
    </div>

    <% if section_groups.empty? %>
      <p class="text-sm text-slate-500 italic mt-2 px-1">No items yet — add one above and pick "<%= ChecklistItem::SCOPE_LABELS[scope_key] %>".</p>
    <% else %>
      <% section_groups.each do |section_name, items| %>
        <div class="mt-3">
          <% if scope_key != "before_trip" || section_groups.keys.size > 1 %>
            <h3 class="text-xs uppercase tracking-widest text-slate-400 font-semibold mb-1.5 px-2"><%= section_name %></h3>
          <% end %>
          <ul id="checklist-<%= scope_key %>-<%= section_name.parameterize %>" class="rounded-2xl border border-slate-800 bg-slate-900/40 divide-y divide-slate-800/50 overflow-hidden">
            <% items.each do |item| %>
              <%= render item %>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </section>
<% end %>
