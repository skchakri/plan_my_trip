<% content_for :title, @trip.title_for(current_user) %>

<% is_owner = (@trip.owner_id == current_user.id) %>

<div class="mb-6">
  <%= link_to "← All trips", trips_path, class: "text-sm text-slate-400 hover:text-white" %>
</div>

<div class="flex items-start justify-between gap-4 mb-2">
  <div class="min-w-0">
    <p class="text-xs uppercase tracking-widest text-slate-500 mb-1">
      <% if is_owner %>Your trip<% else %>Shared by <%= @trip.owner.display_name %><% end %>
    </p>
    <h1 class="text-3xl font-semibold tracking-tight"><%= @trip.title_for(current_user) %></h1>
    <% if @trip.title_for(current_user) != @trip.title %>
      <p class="text-xs text-slate-500 mt-1">Original: <%= @trip.title %></p>
    <% end %>
  </div>
  <div class="flex gap-2 shrink-0 flex-wrap justify-end">
    <% if @trip.pwa_plan_url.present? %>
      <%= link_to "Plan", @trip.pwa_plan_url, target: "_blank", rel: "noopener", class: "px-3 py-1.5 rounded-md bg-teal-500/15 text-teal-300 border border-teal-500/30 text-sm hover:bg-teal-500/25" %>
    <% end %>
    <% if @trip.pwa_packing_url.present? %>
      <%= link_to "Checklist", @trip.pwa_packing_url, target: "_blank", rel: "noopener", class: "px-3 py-1.5 rounded-md bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 text-sm hover:bg-emerald-500/25" %>
    <% end %>
    <% if is_owner %>
      <%= link_to "Edit", edit_trip_path(@trip), class: "px-3 py-1.5 border border-slate-700 rounded-md text-sm hover:border-amber-500" %>
      <%= link_to "Share", new_trip_share_path(@trip), class: "px-3 py-1.5 bg-amber-500 text-slate-900 rounded-md text-sm font-medium hover:bg-amber-400" %>
    <% end %>
  </div>
</div>

<p class="text-slate-400 mb-6">
  <% if @trip.destination.present? %><%= @trip.destination %><% end %>
  <% if @trip.start_date && @trip.end_date %>
    <% if @trip.destination.present? %> · <% end %>
    <%= @trip.start_date.strftime("%b %-d") %> – <%= @trip.end_date.strftime("%b %-d, %Y") %>
  <% end %>
</p>

<details class="mb-6 bg-slate-900/60 border border-slate-800 rounded-lg">
  <summary class="cursor-pointer px-4 py-3 text-sm font-medium">Rename this trip (just for you)</summary>
  <div class="px-4 pb-4">
    <%= form_with url: rename_trip_path(@trip), method: :patch, class: "flex gap-2" do |f| %>
      <%= f.text_field "trip_membership[custom_title]", value: @membership&.custom_title, placeholder: @trip.title, class: "flex-1 rounded-md bg-slate-800 border border-slate-700 px-3 py-2 focus:border-amber-500 focus:outline-none" %>
      <%= f.submit "Save", class: "px-4 py-2 bg-amber-500 text-slate-900 rounded-md font-medium hover:bg-amber-400 cursor-pointer" %>
    <% end %>
    <p class="text-xs text-slate-500 mt-2">Your custom title only changes how this trip looks in your list. Leave it blank to use the original.</p>
  </div>
</details>

<article class="prose prose-invert max-w-none prose-headings:font-semibold prose-headings:text-amber-200 prose-a:text-amber-300 prose-strong:text-slate-100 prose-table:text-sm">
  <%= @rendered_body %>
</article>

<%= render "bookings", booking: @booking %>

<% if @trip.trails.any? %>
  <section class="mt-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold flex items-center gap-2">
        <span>Trails</span>
        <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300">AllTrails</span>
      </h2>
      <% if current_user.alltrails_pro? %>
        <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300">AllTrails+ active</span>
      <% else %>
        <%= link_to "Get AllTrails+", "https://www.alltrails.com/plus", target: "_blank", rel: "noopener", class: "text-xs text-slate-400 hover:text-emerald-300 underline-offset-2 hover:underline" %>
      <% end %>
    </div>
    <ul class="space-y-3">
      <% @trip.trails.each do |trail| %>
        <li class="rounded-lg border border-slate-800 bg-slate-900/60 p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="font-semibold"><%= trail.name %></h3>
              <% if trail.notes.present? %>
                <p class="text-sm text-slate-400 mt-1 whitespace-pre-line"><%= trail.notes %></p>
              <% end %>
              <% if current_user.alltrails_pro? && trail.has_alltrails_link? %>
                <p class="text-xs text-emerald-300/80 mt-2">Tap "Open" — your AllTrails+ unlocks offline maps, 3D view, and Lifeline for this route.</p>
              <% elsif trail.has_alltrails_link? %>
                <p class="text-xs text-slate-500 mt-2">Opens in the AllTrails app if installed, otherwise in your browser.</p>
              <% end %>
            </div>
            <% if trail.has_alltrails_link? %>
              <%= link_to trail.alltrails_url, target: "_blank", rel: "noopener", class: "shrink-0 px-3 py-2 bg-emerald-500 text-slate-900 rounded-md text-sm font-medium hover:bg-emerald-400" do %>
                Open in AllTrails →
              <% end %>
            <% else %>
              <span class="shrink-0 px-3 py-2 text-xs text-slate-500 italic">No link yet</span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if is_owner %>
  <hr class="my-8 border-slate-800">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-lg font-semibold">People with access</h2>
    <%= link_to "Add", new_trip_share_path(@trip), class: "text-sm px-3 py-1 bg-amber-500 text-slate-900 rounded-md font-medium hover:bg-amber-400" %>
  </div>
  <ul class="space-y-2">
    <% @trip.trip_memberships.includes(:user).each do |m| %>
      <li class="flex items-center justify-between bg-slate-900/60 border border-slate-800 rounded-md px-4 py-2">
        <div>
          <span class="font-medium"><%= m.user.display_name %></span>
          <span class="text-slate-400 text-sm ml-2"><%= m.user.email %></span>
          <% if m.owner? %><span class="ml-2 text-xs px-2 py-0.5 bg-amber-500/15 text-amber-300 rounded">Owner</span><% end %>
        </div>
        <% unless m.owner? %>
          <%= button_to "Remove", trip_share_path(@trip, m), method: :delete, form: { data: { turbo_confirm: "Remove access for #{m.user.display_name}?" } }, class: "text-sm text-rose-400 hover:text-rose-300" %>
        <% end %>
      </li>
    <% end %>

    <% @trip.invitations.pending.each do |inv| %>
      <li class="flex items-center justify-between bg-slate-900/40 border border-dashed border-slate-700 rounded-md px-4 py-2">
        <div>
          <span class="text-slate-300"><%= inv.email %></span>
          <span class="ml-2 text-xs px-2 py-0.5 bg-sky-500/15 text-sky-300 rounded">Pending — invite sent</span>
        </div>
        <%= button_to "Revoke", trip_invitation_path(@trip, inv), method: :delete, form: { data: { turbo_confirm: "Revoke the invitation to #{inv.email}?" } }, class: "text-sm text-rose-400 hover:text-rose-300" %>
      </li>
    <% end %>
  </ul>

  <hr class="my-8 border-slate-800">
  <%= button_to "Delete trip", trip_path(@trip), method: :delete, form: { data: { turbo_confirm: "Delete this trip for everyone?" } }, class: "px-4 py-2 border border-rose-700/50 text-rose-300 rounded-md hover:bg-rose-500/10" %>
<% end %>
