<% content_for :title, @trip.title_for(current_user) %>
<% is_owner = (@trip.owner_id == current_user.id) %>
<% day_trip = @trip.day_trip? %>

<div class="mb-5">
  <%= link_to trips_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> All trips
  <% end %>
</div>

<!-- Hero -->
<section class="relative rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-900/40 overflow-hidden mb-6">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(232,160,79,0.10),transparent_60%)] pointer-events-none"></div>
  <div class="relative p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="min-w-0 flex-1">
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 font-medium mb-2 flex items-center gap-2">
          <% if is_owner %>
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-400"></span> Your trip
          <% else %>
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-sky-400"></span> Shared by <%= @trip.owner.display_name %>
          <% end %>
          <% if day_trip %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-200 border border-emerald-500/30 text-[10px] font-semibold tracking-normal normal-case ml-1">
              <%= icon :sun, class: "w-3 h-3" %> Day trip
            </span>
          <% end %>
        </p>
        <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-slate-50"><%= @trip.title_for(current_user) %></h1>
        <% if @trip.title_for(current_user) != @trip.title %>
          <p class="text-xs text-slate-500 mt-1">Original title: <%= @trip.title %></p>
        <% end %>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-slate-300">
          <% if @trip.destination.present? %>
            <span class="inline-flex items-center gap-1.5"><%= icon :map_pin, class: "w-4 h-4 text-amber-400/70" %><%= @trip.destination %></span>
          <% end %>
          <% if @trip.origin.present? %>
            <span class="inline-flex items-center gap-1.5 text-slate-400"><%= icon :plane, class: "w-4 h-4 text-slate-500" %>From <%= @trip.origin %></span>
          <% end %>
          <% if @trip.start_date && @trip.end_date %>
            <span class="inline-flex items-center gap-1.5 text-slate-400">
              <%= icon :calendar, class: "w-4 h-4 text-slate-500" %>
              <% if day_trip || @trip.start_date == @trip.end_date %>
                <%= @trip.start_date.strftime("%a %b %-d, %Y") %>
              <% else %>
                <%= @trip.start_date.strftime("%b %-d") %> – <%= @trip.end_date.strftime("%b %-d, %Y") %>
              <% end %>
            </span>
          <% end %>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 shrink-0">
        <%= link_to plan_trip_path(@trip), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-teal-500/10 text-teal-200 border border-teal-500/30 text-sm hover:bg-teal-500/20 transition-colors" do %>
          <%= icon :sparkles, class: "w-4 h-4" %> Final plan
        <% end %>
        <%= link_to checklist_trip_path(@trip), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/10 text-emerald-200 border border-emerald-500/30 text-sm hover:bg-emerald-500/20 transition-colors" do %>
          <%= icon :check, class: "w-4 h-4" %> Checklist
        <% end %>
        <% webcal = calendar_trip_url(@trip, format: :ics).sub(%r{\Ahttps?://}, "webcal://") %>
        <%= link_to webcal,
              class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-700 text-slate-200 text-sm hover:border-amber-500/50 hover:bg-slate-800/50 transition-colors",
              title: "Subscribe in Google/Apple/Outlook Calendar" do %>
          <%= icon :calendar, class: "w-4 h-4" %> Subscribe
        <% end %>
        <%= link_to wallet_trip_path(@trip),
              class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-700 text-slate-200 text-sm hover:border-amber-500/50 hover:bg-slate-800/50 transition-colors",
              title: "Print-ready survival sheet — bookings, addresses, coordinates" do %>
          <%= icon :printer, class: "w-4 h-4" %> Wallet
        <% end %>
        <%= button_to duplicate_trip_path(@trip),
              method: :post,
              data: { turbo_confirm: "Duplicate \"#{@trip.title_for(current_user)}\" into your trips?" },
              form_class: "inline",
              class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-700 text-slate-200 text-sm hover:border-amber-500/50 hover:bg-slate-800/50 transition-colors" do %>
          <%= icon :copy, class: "w-4 h-4" %> Duplicate
        <% end %>
        <% if is_owner %>
          <%= link_to edit_trip_path(@trip), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-700 text-slate-200 text-sm hover:border-amber-500/50 hover:bg-slate-800/50 transition-colors" do %>
            <%= icon :pencil, class: "w-4 h-4" %> Edit
          <% end %>
          <%= link_to new_trip_share_path(@trip), class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-semibold text-sm shadow-lg shadow-amber-500/20 hover:bg-amber-400 transition-all" do %>
            <%= icon :share, class: "w-4 h-4" %> Share
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Stat tiles -->
    <% stats = if day_trip
         [
           (@trip.trip_days.first&.activities&.any? ? { label: "Stops", value: @trip.trip_days.first.activities.size, icon: :map_pin } : nil),
           (@trip.max_radius_km ? { label: "Radius", value: "#{@trip.max_radius_km} km", icon: :compass } : nil),
           { label: "Travelers", value: @trip.traveler_count, icon: :users },
           { label: "With access", value: @trip.member_count, icon: :user_circle }
         ].compact
       else
         [
           (@trip.nights ? { label: "Nights",   value: @trip.nights,         icon: :calendar } : nil),
           { label: "Travelers", value: @trip.traveler_count, icon: :users },
           (@trip.trails.any? ? { label: "Trails", value: @trip.trails.size, icon: :mountain } : nil),
           { label: "With access", value: @trip.member_count, icon: :user_circle }
         ].compact
       end %>
    <% if stats.any? %>
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <% stats.each do |s| %>
          <div class="rounded-xl bg-slate-800/40 border border-slate-700/50 p-3">
            <div class="flex items-center gap-1.5 text-[11px] uppercase tracking-widest text-slate-500 font-medium">
              <%= icon s[:icon], class: "w-3.5 h-3.5" %><%= s[:label] %>
            </div>
            <div class="font-display text-2xl font-semibold text-slate-50 mt-1 tabular-nums"><%= s[:value] %></div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%= render "stack_points_banner" %>

<%# Realtime presence — pills of other trip members currently viewing the
    trip. Updated via Action Cable; only renders for trips with multiple
    members (no point on solo trips). %>
<% if @trip.member_count > 1 %>
  <div data-controller="trip-presence" data-trip-presence-trip-id-value="<%= @trip.id %>"
       class="mb-6 flex items-center gap-2 text-xs text-slate-500 flex-wrap">
    <span class="inline-flex items-center gap-1.5">
      <span class="relative flex w-2 h-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-50"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
      </span>
      Live
    </span>
    <span data-trip-presence-target="empty">No one else viewing right now</span>
    <span data-trip-presence-target="list" class="flex items-center gap-1.5 flex-wrap"></span>
  </div>
<% end %>

<!-- Personal title override -->
<details class="mb-6 rounded-xl bg-slate-900/40 border border-slate-800">
  <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-slate-300 flex items-center gap-2">
    <%= icon :pencil, class: "w-4 h-4 text-slate-500" %> Rename this trip (just for you)
  </summary>
  <div class="px-4 pb-4">
    <%= form_with url: rename_trip_path(@trip), method: :patch, class: "flex gap-2" do |f| %>
      <%= f.text_field "trip_membership[custom_title]", value: @membership&.custom_title, placeholder: @trip.title, class: "flex-1 rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none" %>
      <%= f.submit "Save", class: "px-4 py-2 bg-amber-500 text-slate-950 rounded-lg font-semibold text-sm hover:bg-amber-400 cursor-pointer" %>
    <% end %>
    <p class="text-xs text-slate-500 mt-2">Your custom title only changes how this trip looks in your list. Leave it blank to use the original.</p>
  </div>
</details>

<!-- Plan body -->
<section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-7 mb-6">
  <h2 class="font-display text-xl font-semibold mb-4 flex items-center gap-2"><%= icon :sparkles, class: "w-5 h-5 text-amber-400/80" %> Itinerary</h2>
  <article class="prose prose-invert max-w-none prose-headings:font-display prose-headings:tracking-tight prose-headings:text-amber-200 prose-a:text-amber-300 prose-strong:text-slate-100 prose-table:text-sm prose-li:my-1">
    <%= @rendered_body %>
  </article>
</section>

<!-- Trails -->
<% if @trip.trails.any? %>
  <section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-7 mb-6">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
      <h2 class="font-display text-xl font-semibold flex items-center gap-2">
        <%= icon :mountain, class: "w-5 h-5 text-emerald-400/80" %> Trails
        <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300 font-sans font-medium">AllTrails</span>
      </h2>
      <% if current_user.alltrails_pro? %>
        <span class="text-xs inline-flex items-center gap-1 px-2 py-1 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"><%= icon :check, class: "w-3 h-3" %> AllTrails+ active</span>
      <% else %>
        <%= link_to "Get AllTrails+ →", "https://www.alltrails.com/plus", target: "_blank", rel: "noopener", class: "text-xs text-slate-400 hover:text-emerald-300 underline-offset-2 hover:underline" %>
      <% end %>
    </div>
    <ul class="space-y-2.5">
      <% @trip.trails.each do |trail| %>
        <li class="rounded-xl border border-slate-700/50 bg-slate-800/30 p-4 hover:border-emerald-500/30 transition-colors">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="font-semibold text-slate-100"><%= trail.name %></h3>
              <% if trail.notes.present? %>
                <p class="text-sm text-slate-400 mt-1 whitespace-pre-line"><%= trail.notes %></p>
              <% end %>
              <% if current_user.alltrails_pro? && trail.has_alltrails_link? %>
                <p class="text-xs text-emerald-300/80 mt-2">Tap "Open" — AllTrails+ unlocks offline maps, 3D view, Lifeline.</p>
              <% elsif trail.has_alltrails_link? %>
                <p class="text-xs text-slate-500 mt-2">Opens in the AllTrails app if installed, otherwise in your browser.</p>
              <% end %>
            </div>
            <% if trail.has_alltrails_link? %>
              <%= link_to trail.alltrails_url, target: "_blank", rel: "noopener", class: "shrink-0 inline-flex items-center gap-1 px-3 py-2 bg-emerald-500 text-slate-950 rounded-lg text-sm font-semibold hover:bg-emerald-400 transition-colors" do %>
                Open <%= icon :external_link, class: "w-3.5 h-3.5" %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<!-- Travelers -->
<section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-7 mt-6">
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
    <h2 class="font-display text-xl font-semibold flex items-center gap-2">
      <%= icon :users, class: "w-5 h-5 text-amber-400/80" %> Travelers
      <span class="text-xs text-slate-500 font-sans font-normal">drives the co-pilot game on long stretches</span>
    </h2>
  </div>

  <% if @trip.people.any? %>
    <ul class="space-y-2 mb-4">
      <% @trip.people.ordered.each do |p| %>
        <li class="flex items-center justify-between gap-3 bg-slate-800/30 border border-slate-700/50 rounded-xl px-4 py-2.5">
          <div class="flex items-center gap-3 min-w-0">
            <div class="shrink-0 w-9 h-9 rounded-full bg-gradient-to-br from-amber-500/20 to-amber-500/5 border border-amber-500/30 flex items-center justify-center text-amber-200 text-sm font-semibold"><%= p.initials %></div>
            <div class="min-w-0">
              <p class="font-medium text-slate-100 truncate"><%= p.name %><% if p.age.present? %><span class="text-slate-500 font-normal"> · age <%= p.age %></span><% end %></p>
              <% if p.interests_label %>
                <p class="text-xs text-slate-400 truncate"><%= p.interests_label %></p>
              <% end %>
            </div>
          </div>
          <% if is_owner %>
            <%= button_to trip_person_path(@trip, p), method: :delete, form: { data: { turbo_confirm: "Remove #{p.name}?" } }, class: "text-xs text-rose-400 hover:text-rose-300 px-2 py-1 rounded hover:bg-rose-500/10 transition-colors" do %>
              Remove
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if is_owner %>
    <details class="rounded-xl border border-slate-800 bg-slate-900/30">
      <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-slate-300">
        <span class="inline-flex items-center gap-2"><%= icon :plus, class: "w-4 h-4" %> Add a traveler</span>
      </summary>
      <%= form_with url: trip_people_path(@trip), method: :post, html: { class: "px-4 pb-4 space-y-3" } do |f| %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2"
             data-controller="interests-input"
             data-interests-input-name-value="person[interests][]"
             data-interests-input-known-value="<%= (@known_traveler_interests || {}).to_json %>">
          <%= text_field_tag "person[name]", nil, required: true, placeholder: "Name",
                class: "rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none",
                data: { interests_input_target: "nameField", action: "change->interests-input#nameChanged blur->interests-input#nameChanged" } %>
          <%= number_field_tag "person[age]", nil, placeholder: "Age (optional)", class: "rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm focus:border-amber-500 focus:outline-none" %>
          <%= submit_tag "Add", class: "px-4 py-2 bg-amber-500 text-slate-950 rounded-lg font-semibold text-sm hover:bg-amber-400 cursor-pointer" %>
          <div class="sm:col-span-3">
            <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-1.5">Personal interests</p>
            <%= hidden_field_tag "person[interests][]", "", data: { interests_input_target: "emptyMarker" } %>
            <div class="flex flex-wrap items-center gap-1.5 rounded-lg bg-slate-800/40 border border-slate-700 px-2 py-1.5 focus-within:border-amber-500/60"
                 data-interests-input-target="chips">
              <input type="text"
                     data-interests-input-target="newInput"
                     data-action="keydown->interests-input#keydown blur->interests-input#commit"
                     placeholder="sports, art, photography…"
                     class="flex-1 min-w-[10ch] bg-transparent border-0 px-1 py-0.5 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-0">
            </div>
            <p class="text-[10px] text-slate-500 mt-1">Press Enter or comma to add. Saved for this person — pre-fills on your next trip.</p>
          </div>
        </div>
      <% end %>
    </details>
  <% end %>

  <% if @trip.people.any? %>
    <%= link_to copilot_trip_path(@trip), class: "mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-amber-500 text-slate-950 font-semibold text-sm hover:bg-amber-400" do %>
      <%= icon :sparkles, class: "w-4 h-4" %> Open the drive co-pilot
    <% end %>
  <% end %>
</section>

<!-- Bookings (multi-day only — day trips don't need hotels/flights) -->
<% unless day_trip %>
  <%= render "bookings", booking: @booking %>
<% end %>

<!-- Trip documents (hotel, car, flight confirmations) -->
<section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-7 mt-6">
  <h2 class="font-display text-xl font-semibold flex items-center gap-2 mb-3">
    <%= icon :external_link, class: "w-5 h-5 text-amber-400/80" %> Trip documents
    <span class="text-xs text-slate-500 font-sans font-normal">hotel · car · flight · insurance</span>
  </h2>
  <% if @trip.documents.attached? %>
    <ul class="space-y-1.5 mb-4">
      <% @trip.documents.each do |doc| %>
        <li class="flex items-center justify-between gap-2 rounded-md bg-slate-800/40 border border-slate-700/40 px-3 py-2">
          <%= link_to rails_blob_path(doc, disposition: "inline"), target: "_blank", rel: "noopener", class: "min-w-0 flex items-center gap-2 text-sm text-slate-200 hover:text-amber-200 truncate" do %>
            <span class="shrink-0 text-slate-500"><%= icon :external_link, class: "w-3.5 h-3.5" %></span>
            <span class="truncate"><%= doc.filename %></span>
            <span class="shrink-0 text-[11px] text-slate-500">· <%= number_to_human_size(doc.byte_size) %></span>
          <% end %>
          <% if is_owner %>
            <%= button_to trip_document_path(@trip, doc), method: :delete, form: { data: { turbo_confirm: "Remove #{doc.filename}?" } }, class: "shrink-0 text-rose-400 hover:text-rose-300 p-1 rounded transition-colors cursor-pointer", aria: { label: "Remove" } do %>
              <%= icon :trash, class: "w-3.5 h-3.5" %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with url: trip_documents_path(@trip), method: :post, multipart: true, html: { class: "flex items-center gap-2", data: { turbo: false } } do %>
    <%= file_field_tag "trip[documents][]", multiple: true, accept: "image/*,application/pdf,.ics,.txt", class: "block w-full text-xs text-slate-300 file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:bg-amber-500/15 file:text-amber-200 hover:file:bg-amber-500/25 file:cursor-pointer cursor-pointer" %>
    <%= submit_tag "Upload", class: "shrink-0 px-3 py-1.5 bg-amber-500 text-slate-950 rounded-md text-xs font-semibold hover:bg-amber-400 cursor-pointer" %>
  <% end %>
  <p class="text-[11px] text-slate-500 mt-1.5">PDF, image, .ics, or .txt — hotel reservations, car rental, flight tickets, etc.</p>
</section>

<!-- Owner-only: public share link (read-only URL anyone can open) -->
<% if is_owner %>
  <section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-7 mt-6"
           data-controller="share-link">
    <div class="flex items-start justify-between gap-3 flex-wrap mb-3">
      <div>
        <h2 class="font-display text-xl font-semibold flex items-center gap-2">
          <%= icon :link, class: "w-5 h-5 text-teal-300/80" %> Public link
        </h2>
        <p class="text-sm text-slate-400 mt-1">Anyone with the link sees a read-only version. No signup required.</p>
      </div>
      <span class="shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs <%= @trip.share_link_active? ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30' : 'bg-slate-800 text-slate-400 border border-slate-700' %>">
        <span class="w-1.5 h-1.5 rounded-full <%= @trip.share_link_active? ? 'bg-emerald-400' : 'bg-slate-500' %>"></span>
        <%= @trip.share_link_active? ? "On" : "Off" %>
      </span>
    </div>

    <% if @trip.share_link_active? %>
      <% public_url = public_trip_url(@trip.share_token) %>
      <div class="flex items-stretch gap-2 bg-slate-950/60 border border-slate-700 rounded-lg p-1 pl-3">
        <input type="text" readonly value="<%= public_url %>"
               data-share-link-target="url"
               class="flex-1 bg-transparent text-sm text-slate-200 outline-none truncate" />
        <button type="button"
                data-action="share-link#copy"
                data-share-link-target="copyBtn"
                class="shrink-0 px-3 py-1.5 rounded-md bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 transition-colors">
          Copy
        </button>
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        <%= button_to rotate_public_share_trip_path(@trip),
              method: :post,
              data: { turbo_confirm: "Rotate the link? The current URL will stop working." },
              class: "inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-md border border-slate-700 text-slate-300 hover:bg-slate-800/60 transition-colors" do %>
          <%= icon :refresh_cw, class: "w-3.5 h-3.5" %> Rotate URL
        <% end %>
        <%= button_to disable_public_share_trip_path(@trip),
              method: :delete,
              data: { turbo_confirm: "Disable the public link?" },
              class: "inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-md bg-rose-500/10 text-rose-200 border border-rose-500/30 hover:bg-rose-500/20 transition-colors" do %>
          <%= icon :x, class: "w-3.5 h-3.5" %> Revoke
        <% end %>
      </div>
    <% else %>
      <%= button_to enable_public_share_trip_path(@trip),
            method: :post,
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-teal-500/10 text-teal-200 border border-teal-500/30 hover:bg-teal-500/20 transition-colors text-sm" do %>
        <%= icon :link, class: "w-4 h-4" %> Generate public link
      <% end %>
    <% end %>
  </section>
<% end %>

<!-- Owner-only: members + pending invitations + delete -->
<% if is_owner %>
  <section class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-7 mt-6">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
      <h2 class="font-display text-xl font-semibold flex items-center gap-2"><%= icon :users, class: "w-5 h-5 text-sky-400/80" %> People with access</h2>
      <%= link_to new_trip_share_path(@trip), class: "inline-flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-semibold hover:bg-amber-400 transition-colors" do %>
        <%= icon :plus, class: "w-4 h-4" %> Invite
      <% end %>
    </div>
    <ul class="space-y-2">
      <% @trip.trip_memberships.includes(:user).each do |m| %>
        <li class="flex items-center justify-between gap-3 bg-slate-800/30 border border-slate-700/50 rounded-xl px-4 py-2.5">
          <div class="flex items-center gap-3 min-w-0">
            <div class="shrink-0 w-9 h-9 rounded-full bg-gradient-to-br from-amber-500/20 to-amber-500/5 border border-amber-500/20 flex items-center justify-center text-amber-300 text-sm font-semibold">
              <%= m.user.display_name[0].upcase %>
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-medium text-slate-100 truncate"><%= m.user.display_name %></span>
                <% if m.owner? %><span class="text-[10px] uppercase tracking-widest px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-300 font-semibold">Owner</span><% end %>
              </div>
              <span class="text-xs text-slate-400 truncate block"><%= m.user.email %></span>
            </div>
          </div>
          <% unless m.owner? %>
            <%= button_to trip_share_path(@trip, m), method: :delete, form: { data: { turbo_confirm: "Remove access for #{m.user.display_name}?" } }, class: "text-xs text-rose-400 hover:text-rose-300 px-2 py-1 rounded hover:bg-rose-500/10 transition-colors" do %>
              Remove
            <% end %>
          <% end %>
        </li>
      <% end %>

      <% @trip.invitations.pending.each do |inv| %>
        <li class="flex items-center justify-between gap-3 bg-slate-800/20 border border-dashed border-slate-700 rounded-xl px-4 py-2.5">
          <div class="flex items-center gap-3 min-w-0">
            <div class="shrink-0 w-9 h-9 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-500">
              <%= icon :user_circle, class: "w-5 h-5" %>
            </div>
            <div class="min-w-0">
              <span class="text-slate-300 truncate block"><%= inv.email %></span>
              <span class="text-[10px] uppercase tracking-widest text-sky-300">Pending — invite sent</span>
            </div>
          </div>
          <%= button_to trip_invitation_path(@trip, inv), method: :delete, form: { data: { turbo_confirm: "Revoke the invitation to #{inv.email}?" } }, class: "text-xs text-rose-400 hover:text-rose-300 px-2 py-1 rounded hover:bg-rose-500/10 transition-colors" do %>
            Revoke
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <div class="mt-8 pt-6 border-t border-slate-800/60">
    <%= button_to trip_path(@trip), method: :delete, form: { data: { turbo_confirm: "Delete this trip for everyone?" } }, class: "inline-flex items-center gap-1.5 px-4 py-2 border border-rose-700/50 text-rose-300 rounded-lg hover:bg-rose-500/10 cursor-pointer text-sm" do %>
      <%= icon :trash, class: "w-4 h-4" %> Delete trip
    <% end %>
  </div>
<% end %>
