<% sections = [
  ["Hotels",     :hotels,     "🛏"],
  ["Cars",       :cars,       "🚗"],
  ["Flights",    :flights,    "✈"],
  ["Activities", :activities, "🎟"]
] %>

<section class="mt-10">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-lg font-semibold">Book this trip</h2>
    <%= link_to "Edit your memberships", edit_user_registration_path, class: "text-xs text-slate-400 hover:text-amber-300 underline-offset-2 hover:underline" %>
  </div>
  <% if @trip.destination.blank? %>
    <p class="text-sm text-slate-500 italic">Add a destination to this trip to see booking links.</p>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% sections.each do |title, method, glyph|
           links = booking.public_send(method)
           next if links.empty? %>
        <details class="rounded-lg border border-slate-800 bg-slate-900/60 group" <%= "open" if method == :hotels %>>
          <summary class="cursor-pointer px-4 py-3 flex items-center justify-between">
            <span class="font-medium"><span class="mr-2"><%= glyph %></span><%= title %></span>
            <span class="text-xs text-slate-500"><%= links.size %> options</span>
          </summary>
          <ul class="px-4 pb-3 space-y-2">
            <% links.each do |link| %>
              <li class="flex items-start justify-between gap-3 border-t border-slate-800 pt-2">
                <div class="min-w-0">
                  <%= link_to link.url, target: "_blank", rel: "noopener", class: "font-medium text-slate-100 hover:text-amber-300" do %>
                    <%= link.provider %> →
                  <% end %>
                  <% if link.badge.present? %>
                    <span class="ml-2 text-xs px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300"><%= link.badge %></span>
                  <% end %>
                  <% if link.note.present? %>
                    <p class="text-xs text-slate-400 mt-0.5"><%= link.note %></p>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        </details>
      <% end %>
    </div>

    <% portals = booking.card_portals %>
    <% if portals.any? %>
      <div class="mt-4 rounded-lg border border-violet-500/30 bg-violet-500/5 p-4">
        <p class="text-xs uppercase tracking-widest text-violet-300 mb-2 font-medium">Stack points via your card portal</p>
        <ul class="space-y-1.5">
          <% portals.each do |link| %>
            <li>
              <%= link_to link.url, target: "_blank", rel: "noopener", class: "font-medium text-violet-200 hover:text-violet-100" do %>
                <%= link.provider %> →
              <% end %>
              <% if link.note.present? %>
                <span class="text-xs text-slate-400 ml-2"><%= link.note %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% tips = booking.discount_tips %>
    <% if tips.any? %>
      <details class="mt-4 rounded-lg border border-emerald-500/30 bg-emerald-500/5">
        <summary class="cursor-pointer px-4 py-3 flex items-center justify-between">
          <span class="font-medium text-emerald-200">💡 Discounts available to you (<%= tips.size %>)</span>
          <span class="text-xs text-emerald-300/70">Real recurring offers — no codes</span>
        </summary>
        <ul class="px-4 pb-4 space-y-3 mt-1">
          <% tips.each do |tip| %>
            <li class="border-t border-emerald-500/20 pt-2">
              <p class="font-medium text-emerald-100"><%= tip[:title] %></p>
              <p class="text-sm text-slate-300 mt-0.5"><%= tip[:body] %></p>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  <% end %>
</section>
