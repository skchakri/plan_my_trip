<% content_for :title, "Plan a trip — highlights" %>
<%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
<style>
  .highlights-map { background: #0a0e1a; }
  .highlights-map .leaflet-control-zoom a { background: rgba(15,23,42,.92); color: #e2e8f0; border: 1px solid rgba(71,85,105,.5); }
  .highlights-map .leaflet-control-zoom a:hover { background: rgba(30,41,59,.95); color: #fde68a; }
  .highlights-map .leaflet-control-attribution { background: rgba(15,23,42,.7); color: #94a3b8; font-size: 10px; }
  .highlights-map .leaflet-control-attribution a { color: #fbbf24; }
  .highlights-map .leaflet-popup-content-wrapper, .highlights-map .leaflet-popup-tip { background: #f8fafc; }
  /* Modal open animation — driven by a class added in JS rather than data-state
     so we can run the transition reliably on the inner card too. */
  [data-highlight-detail-target="modal"].is-open { opacity: 1 !important; }
  [data-highlight-detail-target="modal"].is-open > div { transform: translateY(0); opacity: 1; }
</style>

<div class="mb-6">
  <%= link_to wizard_travelers_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> Travelers
  <% end %>
  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 font-medium mt-3">Plan a trip · step 3 of 4</p>
  <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight">Pick the must-sees</h1>
  <p class="text-sm text-slate-400 mt-1.5">
    Tap a spot in <strong class="text-slate-200"><%= @draft["destination"] %></strong> to see why locals love it — then add the ones that excite you.
  </p>
</div>

<%= render "trips/wizard/progress", step: 3 %>

<%# The highlights research (DestinationHighlights + brief) is slow, so it loads
    in a lazy turbo-frame. target: "_top" so the picker's form submits (Continue
    → Review, Skip) navigate the full page rather than the frame. %>
<%= turbo_frame_tag "wizard-highlights",
      src: wizard_highlights_results_path(vibes: @vibes),
      target: "_top",
      loading: :eager,
      data: { controller: "frame-timeout", frame_timeout_timeout_value: 60000 } do %>
  <div class="space-y-5" aria-busy="true">
    <div class="flex items-center gap-2 text-sm text-amber-300">
      <svg class="w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.4 0 0 5.4 0 12h4z"></path></svg>
      Curating the must-sees in <%= @draft["destination"] %> — an honest brief, a map, and ranked picks…
    </div>
    <div class="h-24 rounded-2xl border border-slate-800 bg-slate-900/40 animate-pulse"></div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% 6.times do %>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/40 overflow-hidden animate-pulse">
          <div class="aspect-[16/10] bg-slate-800"></div>
          <div class="p-4 space-y-2.5">
            <div class="h-4 bg-slate-800 rounded w-3/4"></div>
            <div class="h-3 bg-slate-800/70 rounded w-full"></div>
            <div class="h-3 bg-slate-800/70 rounded w-5/6"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
