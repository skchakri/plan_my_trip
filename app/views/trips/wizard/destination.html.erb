<% content_for :title, "Plan a trip — where to?" %>
<span hidden data-controller="track" data-track-event-value="wizard_step_viewed" data-track-props-value='{"step":"destination"}'></span>
<% input_classes = "w-full rounded-lg bg-slate-800/70 border border-slate-700 px-3 py-2.5 text-slate-100 placeholder-slate-500 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 focus:outline-none transition-colors" %>
<% label_classes = "block text-xs uppercase tracking-widest text-slate-400 font-semibold mb-1.5" %>

<div class="mb-6">
  <%= link_to trips_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> Trips
  <% end %>
  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-400 font-medium mt-3">Plan a trip · step 1 of 4</p>
  <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight">Where are you going?</h1>
  <p class="text-sm text-slate-400 mt-1.5">A destination and dates is all we need to start. We'll pull in highlights and a day-by-day plan in the next steps.</p>
</div>

<%= render "trips/wizard/trip_type_switch", active: :multi_day %>

<%= render "trips/wizard/progress", step: 1 %>

<% draft_musts = Array(@draft["must_includes"]).map { |m| m.to_s.strip }.reject(&:blank?) %>
<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-6 lg:items-start"
     data-controller="wizard-summary"
     data-wizard-summary-mode-labels-value="<%= Trip::TRANSPORT_MODE_LABELS.to_json %>"
     data-action="input->wizard-summary#refresh change->wizard-summary#refresh click->wizard-summary#refresh keydown->wizard-summary#refresh">
<%= form_with url: wizard_destination_path, method: :post, scope: :wizard, class: "space-y-6 min-w-0" do |f| %>
  <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-6 space-y-5">
    <div data-controller="place-autocomplete"
         data-place-autocomplete-search-url-value="<%= search_places_path %>"
         class="relative">
      <%= f.label :destination, class: label_classes %>
      <%= f.text_field :destination,
            value: @draft["destination"],
            required: true,
            autofocus: true,
            autocomplete: "off",
            placeholder: "e.g. Las Vegas, NV · Grand Canyon · Tokyo",
            class: input_classes,
            data: {
              place_autocomplete_target: "input",
              action: "input->place-autocomplete#query focus->place-autocomplete#query keydown->place-autocomplete#navigate blur->place-autocomplete#blur"
            } %>
      <%# Hidden fields the typeahead fills when a known place is picked.
          The wizard ignores these for now (it still calls fresh Wikipedia
          / Claude lookups on save), but they're here for later: with
          place_id + coords pre-set, the highlights step could surface
          the catalog's known siblings instantly. %>
      <%= f.hidden_field :place_id,         value: @draft["place_id"], data: { place_autocomplete_target: "placeId" } %>
      <%= f.hidden_field :destination_lat,  value: @draft["destination_lat"], data: { place_autocomplete_target: "lat" } %>
      <%= f.hidden_field :destination_lng,  value: @draft["destination_lng"], data: { place_autocomplete_target: "lng" } %>

      <%# Suggestion dropdown — populated by the Stimulus controller. %>
      <ul data-place-autocomplete-target="results"
          hidden
          class="absolute left-0 right-0 top-full mt-1.5 z-30 rounded-xl border border-slate-700 bg-slate-900/95 backdrop-blur shadow-2xl shadow-black/60 overflow-hidden max-h-80 overflow-y-auto"></ul>

      <p class="text-[11px] text-slate-400 mt-1.5">Type a city, park, or region. Picks from our shared catalog of places others have visited — or just type a fresh one.</p>
    </div>

    <div>
      <%= f.label :origin, "Leaving from", class: label_classes %>
      <%= f.text_field :origin, value: @draft["origin"], placeholder: "e.g. SLC or Salt Lake City", class: input_classes %>
      <p class="text-[11px] text-slate-400 mt-1.5">Home base — where the trip starts. Powers flight search and road-trip routing.</p>
    </div>

    <fieldset class="border-0 p-0 m-0">
      <legend class="<%= label_classes %>">Getting there</legend>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        <% [["own_car", :car, "Drive", "your own car"], ["rental", :car, "Rental car", "pick up wheels"], ["flying", :plane, "Fly", "airport to airport"], ["mixed", :plane, "Fly + drive", "flight, then a car"]].each do |val, icon_name, title, hint| %>
          <label class="cursor-pointer">
            <input type="radio" name="wizard[transport_mode]" value="<%= val %>" <%= "checked" if @draft["transport_mode"] == val %> class="peer sr-only">
            <span class="flex flex-col items-center gap-1 rounded-lg border border-slate-700 bg-slate-800/60 px-2 py-2.5 min-h-[44px] text-center peer-checked:border-amber-500/60 peer-checked:bg-amber-500/10 peer-checked:text-amber-100 peer-focus-visible:outline-2 peer-focus-visible:outline-amber-400 hover:border-amber-500/40 transition-colors">
              <%= icon icon_name, class: "w-4 h-4 text-slate-400" %>
              <span class="block text-sm font-semibold leading-tight"><%= title %></span>
              <span class="block text-[11px] text-slate-400 leading-tight"><%= hint %></span>
            </span>
          </label>
        <% end %>
      </div>
      <p class="text-[11px] text-amber-200/80 mt-1.5" data-wizard-summary-target="driveHint" hidden>
        Road trip picked — we'll fold the famous stops along your route into the day-by-day plan.
      </p>
    </fieldset>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
      <div>
        <%= f.label :start_date, "Leaving on", class: label_classes %>
        <%= f.date_field :start_date, value: @draft["start_date"], required: true, class: input_classes %>
      </div>
      <div>
        <%= f.label :departure_time, "Departure time", class: label_classes %>
        <%= f.time_field :departure_time, value: @draft["departure_time"], class: input_classes %>
        <p class="text-[11px] text-slate-400 mt-1.5">When you're leaving home</p>
      </div>
      <div class="hidden sm:block"></div>
      <div>
        <%= f.label :end_date, "Returning on", class: label_classes %>
        <%= f.date_field :end_date, value: @draft["end_date"], required: true, class: input_classes %>
      </div>
      <div>
        <%= f.label :return_time, "Return time", class: label_classes %>
        <%= f.time_field :return_time, value: @draft["return_time"], class: input_classes %>
        <p class="text-[11px] text-slate-400 mt-1.5">When you want to be back</p>
      </div>
      <div>
        <%= f.label :traveler_count, "Travelers", class: label_classes %>
        <%= f.number_field :traveler_count, value: @draft["traveler_count"] || 2, min: 1, max: 30, class: input_classes %>
      </div>
    </div>

    <div>
      <%= f.label :title, "Trip title (optional)", class: label_classes %>
      <%= f.text_field :title, value: @draft["title"], placeholder: "We'll auto-name it if you skip", class: input_classes %>
    </div>
  </div>

  <%# ---- Must-include favourites: hard anchors the plan is built around ---- %>
  <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-6">
    <p class="text-[11px] uppercase tracking-[0.18em] text-amber-400/90 font-semibold">Must include <span class="text-slate-400 normal-case tracking-normal font-normal">optional · we'll build the plan around these</span></p>
    <p class="text-sm text-slate-400 mt-1.5">Favourites this trip has to have. Add a duration and we'll allocate it — e.g. “Disneyland — 2 days”, “Yosemite”, “a beach day”.</p>
    <div data-controller="interests-input" data-interests-input-name-value="wizard[must_includes][]" data-interests-input-max-value="<%= Trip::MUST_INCLUDES_MAX %>">
      <div data-interests-input-target="chips"
           class="mt-3 flex flex-wrap items-center gap-2 rounded-lg bg-slate-800/70 border border-slate-700 px-3 py-2.5 focus-within:border-amber-500 transition-colors">
        <% draft_musts.each do |m| %>
          <span data-interests-input-target="chip" data-value="<%= m %>" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs bg-amber-500/20 border border-amber-500/50 text-amber-200">
            <input type="hidden" name="wizard[must_includes][]" value="<%= m %>">
            <%= m %>
            <button type="button" class="inline-flex items-center justify-center w-6 h-6 -mr-1 rounded-full text-amber-200/70 hover:text-rose-300 hover:bg-rose-500/10 cursor-pointer leading-none" aria-label="Remove <%= m %>" data-action="interests-input#removeChip">×</button>
          </span>
        <% end %>
        <input type="text" name="wizard[must_includes][]"
               data-interests-input-target="newInput"
               data-action="keydown->interests-input#keydown blur->interests-input#commit"
               placeholder="<%= draft_musts.any? ? "Add another…" : "Type one, press Enter — e.g. Disneyland — 2 days" %>"
               aria-label="Add a must-include favourite"
               autocomplete="off"
               class="flex-1 min-w-40 bg-transparent border-0 p-0 py-1 text-sm text-slate-100 placeholder-slate-500 focus:ring-0 focus:outline-none">
      </div>
      <%# Blank marker so removing every chip still submits the (empty) list. %>
      <input type="hidden" name="wizard[must_includes][]" value="" data-interests-input-target="emptyMarker">
      <p class="mt-1.5 text-xs text-slate-400" data-interests-input-target="limitHint" aria-live="polite"></p>
    </div>
  </div>

  <%# ---- Trip style: levers that actually change the plan ---- %>
  <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-5 sm:p-6 space-y-5">
    <p class="text-[11px] uppercase tracking-[0.18em] text-amber-400/90 font-semibold">Trip style <span class="text-slate-400 normal-case tracking-normal font-normal">optional · shapes the day-by-day plan</span></p>

    <fieldset class="border-0 p-0 m-0">
      <legend class="<%= label_classes %>">Pace</legend>
      <div class="grid grid-cols-3 gap-2">
        <% [["relaxed", "Relaxed", "fewer stops, more downtime"], ["balanced", "Balanced", "a comfortable mix"], ["packed", "Packed", "see as much as possible"]].each do |val, title, hint| %>
          <% checked = (@draft["pace"].presence || "balanced") == val %>
          <label class="cursor-pointer">
            <input type="radio" name="wizard[pace]" value="<%= val %>" <%= "checked" if checked %> class="peer sr-only">
            <span class="block rounded-lg border border-slate-700 bg-slate-800/60 px-3 py-2.5 text-center peer-checked:border-amber-500/60 peer-checked:bg-amber-500/10 peer-checked:text-amber-100 hover:border-amber-500/40 transition-colors">
              <span class="block text-sm font-semibold"><%= title %></span>
              <span class="block text-[11px] text-slate-400 mt-0.5 leading-tight"><%= hint %></span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :budget, "Budget", class: label_classes %>
        <% budget_labels = { "shoestring" => "Shoestring — free/cheap, budget stays", "moderate" => "Moderate — mid-range dining + hotels", "comfortable" => "Comfortable — nicer stays, some splurges", "luxury" => "Luxury — top dining + lodging" } %>
        <select name="wizard[budget]" class="<%= input_classes %>">
          <option value="">No preference</option>
          <% Trip::BUDGETS.each do |b| %>
            <option value="<%= b %>" <%= "selected" if @draft["budget"] == b %>><%= budget_labels[b] %></option>
          <% end %>
        </select>
      </div>
    </div>

    <div>
      <%= f.label :preferences, "Anything we should know?", class: label_classes %>
      <%= f.text_area :preferences, value: @draft["preferences"], rows: 2,
            placeholder: "Dietary needs, mobility/accessibility, must-dos, things to avoid — e.g. \"vegetarian, one wheelchair user, no long hikes, loves live music\"",
            class: input_classes %>
    </div>
  </div>

  <div class="flex items-center justify-between gap-3">
    <%= link_to trips_path, class: "text-sm text-slate-400 hover:text-slate-200" do %>Cancel<% end %>
    <%= f.submit "Continue → Travelers", class: "inline-flex items-center gap-1.5 px-5 py-2.5 rounded-lg bg-amber-500 text-slate-950 font-semibold shadow-lg shadow-amber-500/20 hover:bg-amber-400 transition-colors cursor-pointer" %>
  </div>
<% end %>

<%# ---- Live "your trip so far" summary — desktop right rail ---- %>
<aside class="hidden lg:block lg:sticky lg:top-6 mt-6 lg:mt-0" aria-label="Trip summary" aria-live="polite">
  <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 space-y-4">
    <p class="text-[11px] uppercase tracking-[0.18em] text-amber-400/90 font-semibold flex items-center gap-1.5">
      <%= icon :compass, class: "w-3.5 h-3.5" %> Your trip so far
    </p>
    <dl class="space-y-3 text-sm">
      <div>
        <dt class="text-[11px] uppercase tracking-widest text-slate-400">Destination</dt>
        <dd class="text-slate-100 font-medium mt-0.5" data-wizard-summary-target="destination">—</dd>
      </div>
      <div>
        <dt class="text-[11px] uppercase tracking-widest text-slate-400">Dates</dt>
        <dd class="text-slate-100 mt-0.5" data-wizard-summary-target="dates">—</dd>
      </div>
      <div>
        <dt class="text-[11px] uppercase tracking-widest text-slate-400">Travelers</dt>
        <dd class="text-slate-100 mt-0.5" data-wizard-summary-target="travelers">—</dd>
      </div>
      <div>
        <dt class="text-[11px] uppercase tracking-widest text-slate-400">Getting there</dt>
        <dd class="text-slate-100 mt-0.5" data-wizard-summary-target="mode">Not set yet</dd>
      </div>
    </dl>
    <div>
      <p class="text-[11px] uppercase tracking-widest text-slate-400">Must include</p>
      <ul class="mt-1.5 flex flex-wrap gap-1.5" data-wizard-summary-target="favourites" hidden></ul>
      <p class="text-xs text-slate-400 mt-1" data-wizard-summary-target="favouritesEmpty">Nothing yet — favourites you add will pin here.</p>
    </div>
    <p class="text-[11px] text-slate-400 border-t border-slate-800 pt-3" data-wizard-summary-target="driveNote" hidden>
      Driving? We'll break the drive into legs and plan the famous stops along the way.
    </p>
  </div>
</aside>
</div>
