<%# Progress bar shared across the 4 wizard steps.
    Pass :step (1..4) when rendering. %>
<% steps = [
  [ 1, "Destination", wizard_destination_path ],
  [ 2, "Travelers",   wizard_travelers_path ],
  [ 3, "Highlights",  wizard_highlights_path ],
  [ 4, "Review",      wizard_review_path ]
] %>
<nav aria-label="Trip wizard progress" class="mb-6">
  <ol class="flex items-center gap-2 sm:gap-3">
    <% steps.each_with_index do |(num, label, path), i| %>
      <% state = num < step ? :done : (num == step ? :current : :pending) %>
      <li class="flex items-center gap-2 flex-1 min-w-0">
        <% if state == :done %>
          <%= link_to path, class: "flex items-center gap-2 group" do %>
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-amber-500/20 border border-amber-500/50 text-amber-200 text-xs font-semibold">
              <%= icon :check, class: "w-3.5 h-3.5" %>
            </span>
            <span class="hidden sm:inline text-xs font-semibold text-amber-200 group-hover:text-amber-100"><%= label %></span>
          <% end %>
        <% elsif state == :current %>
          <span class="flex items-center justify-center w-7 h-7 rounded-full bg-amber-400 text-slate-950 text-xs font-bold"><%= num %></span>
          <span class="text-xs font-semibold text-amber-200 truncate"><%= label %></span>
        <% else %>
          <span class="flex items-center justify-center w-7 h-7 rounded-full bg-slate-800 border border-slate-700 text-slate-400 text-xs font-semibold"><%= num %></span>
          <span class="hidden sm:inline text-xs font-medium text-slate-400 truncate"><%= label %></span>
        <% end %>
        <% if i < steps.size - 1 %>
          <span class="flex-1 h-px <%= num < step ? 'bg-amber-500/30' : 'bg-slate-800' %>"></span>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
