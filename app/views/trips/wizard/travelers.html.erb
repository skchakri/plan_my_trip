<% content_for :title, "Plan a trip — travelers" %>
<% input_classes = "w-full rounded-lg bg-slate-800/70 border border-slate-700 px-3 py-2.5 text-slate-100 placeholder-slate-500 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 focus:outline-none transition-colors" %>
<% label_classes = "block text-xs uppercase tracking-widest text-slate-400 font-semibold mb-1.5" %>

<div class="mb-6">
  <%= link_to wizard_destination_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> Destination
  <% end %>
  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 font-medium mt-3">Plan a trip · step 2 of 4</p>
  <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight">Who's going?</h1>
  <p class="text-sm text-slate-400 mt-1.5">Names, ages, and a few interests per traveler. The interests shape the day plan, the podcast intro, and the drive co-pilot game.</p>
</div>

<%= render "trips/wizard/progress", step: 2 %>

<%= form_with url: wizard_travelers_path, method: :post, scope: :wizard, class: "space-y-6" do |f| %>
  <fieldset class="rounded-2xl border border-amber-500/20 bg-amber-500/[0.03] p-5 sm:p-6 space-y-4"
            data-controller="nested-form">
    <legend class="px-2 text-xs uppercase tracking-widest text-amber-300 font-semibold">Travelers</legend>

    <div data-nested-form-target="container" class="space-y-3">
      <% Array(@draft["people"]).each_with_index do |person, idx| %>
        <%= render "trips/wizard/person_row",
                   idx: idx,
                   person: person,
                   input_classes: input_classes %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= render "trips/wizard/person_row",
                 idx: "NEW_RECORD",
                 person: { "name" => "", "age" => nil, "interests" => [] },
                 input_classes: input_classes %>
    </template>

    <button type="button"
            data-action="nested-form#add"
            class="inline-flex items-center gap-1.5 text-xs text-amber-300 hover:text-amber-200 font-semibold uppercase tracking-widest cursor-pointer">
      <%= icon :plus, class: "w-3.5 h-3.5" %> Add another traveler
    </button>
  </fieldset>

  <div class="flex items-center justify-between gap-3">
    <%= link_to wizard_destination_path, class: "text-sm text-slate-400 hover:text-slate-200" do %>← Back<% end %>
    <%= f.submit "Continue → Highlights", class: "inline-flex items-center gap-1.5 px-5 py-2.5 rounded-lg bg-amber-500 text-slate-950 font-semibold shadow-lg shadow-amber-500/20 hover:bg-amber-400 transition-colors cursor-pointer" %>
  </div>
<% end %>
