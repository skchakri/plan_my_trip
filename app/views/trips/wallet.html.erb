<% content_for :title, "Trip wallet · #{@trip.title}" %>

<header class="mb-6 pb-4 border-b border-slate-300">
  <p class="text-[10px] uppercase tracking-[0.2em] text-slate-400">Trip wallet</p>
  <h1 class="font-semibold text-2xl mt-0.5"><%= @trip.title %></h1>
  <div class="flex flex-wrap gap-x-5 gap-y-1 mt-2 text-sm text-slate-700">
    <% if @trip.start_date && @trip.end_date %>
      <span><%= @trip.start_date.strftime("%a, %b %-d") %> – <%= @trip.end_date.strftime("%a, %b %-d, %Y") %></span>
    <% end %>
    <% if @trip.destination.present? %>
      <span>·</span><span><%= @trip.destination %></span>
    <% end %>
    <% if @trip.traveler_count.to_i.positive? %>
      <span>·</span><span><%= pluralize(@trip.traveler_count, "traveler") %></span>
    <% end %>
  </div>
</header>

<%# Travelers, with anything useful for the trip (initials at minimum). %>
<% people = @trip.people.to_a %>
<% if people.any? %>
  <section class="mb-6 wallet-card">
    <h2 class="text-xs uppercase tracking-widest text-slate-400 mb-2">Travelers</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2">
      <% people.each do |p| %>
        <li class="border border-slate-300 rounded-md px-3 py-1.5 text-sm">
          <span class="font-medium"><%= p.name %></span>
          <% if p.age.present? %><span class="text-slate-400"> · age <%= p.age %></span><% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%# Bookings — flights, stays, cars, activities with attached docs. The
    actual document blobs aren't embedded (they'd bloat the PDF); we
    list filenames + signed URLs so the user can tap them on their phone. %>
<% if @bookings.any? %>
  <section class="mb-6 wallet-card">
    <h2 class="text-xs uppercase tracking-widest text-slate-400 mb-2">Confirmations & bookings</h2>
    <ul class="space-y-2">
      <% @bookings.each do |claim| %>
        <li class="border border-slate-300 rounded-md p-3">
          <p class="text-sm font-semibold"><%= claim.kind_label %><% if claim.documents.any? %>
            <span class="text-slate-400 font-normal text-xs">· <%= pluralize(claim.documents.size, "doc") %></span>
          <% end %></p>
          <% claim.documents.each do |d| %>
            <p class="text-xs text-slate-700 mt-1">
              <%= link_to rails_blob_path(d, disposition: "inline"), class: "underline", target: "_blank", rel: "noopener" do %>
                <%= d.filename %>
              <% end %>
              <span class="text-slate-400">· <%= number_to_human_size(d.byte_size) %></span>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%# Forwarded reservations — confirmations parsed from emails. Distinct from the
    booking_claims above (which carry uploaded docs); these carry structured
    vendor/confirmation/date fields, the most useful thing to have on paper. %>
<% if @reservations.present? && @reservations.any? %>
  <section class="mb-6 wallet-card">
    <h2 class="text-xs uppercase tracking-widest text-slate-400 mb-2">Forwarded reservations</h2>
    <ul class="space-y-2">
      <% @reservations.each do |r| %>
        <li class="border border-slate-300 rounded-md p-3">
          <p class="text-sm font-semibold"><%= r.headline %>
            <span class="text-slate-400 font-normal text-xs">· <%= r.kind_label %></span>
          </p>
          <% if r.confirmation_number.present? %>
            <p class="text-xs text-slate-700 mt-1">Confirmation <span class="font-mono">#<%= r.confirmation_number %></span></p>
          <% end %>
          <% if r.start_at.present? %>
            <p class="text-xs text-slate-700 mt-0.5">
              <%= r.start_at.strftime("%a, %b %-d") %><% if r.end_at.present? && r.end_at.to_date != r.start_at.to_date %> – <%= r.end_at.strftime("%a, %b %-d") %><% end %>
            </p>
          <% end %>
          <% if r.vendor.present? || r.location.present? || r.address.present? %>
            <p class="text-xs text-slate-700 mt-0.5"><%= [ r.vendor, r.location, r.address ].reject(&:blank?).uniq.join(" · ") %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%# Day-by-day addresses + lat/lng — the survival sheet for the road. %>
<% if @days.any? %>
  <section class="mb-6 wallet-card">
    <h2 class="text-xs uppercase tracking-widest text-slate-400 mb-2">Stops & addresses</h2>
    <% @days.each_with_index do |day, idx| %>
      <% next if day.activities.empty? %>
      <div class="mt-3 first:mt-0">
        <h3 class="text-sm font-semibold mb-1">Day <%= idx + 1 %> — <%= day.title %><% if day.date %>
          <span class="text-slate-400 font-normal">· <%= day.date.strftime("%a, %b %-d") %></span>
        <% end %></h3>
        <ul class="divide-y divide-slate-200 border border-slate-300 rounded-md">
          <% day.activities.order(:position).each do |a| %>
            <li class="px-3 py-2 text-sm">
              <div class="flex items-baseline gap-2">
                <% if a.time_label.present? %>
                  <span class="text-slate-400 tabular-nums text-xs shrink-0 w-12"><%= a.time_label %></span>
                <% end %>
                <span class="font-medium"><%= a.title %></span>
              </div>
              <% if a.address.present? || a.location_name.present? %>
                <p class="mt-0.5 text-xs text-slate-700 ml-14">
                  <%= [ a.location_name, a.address ].reject(&:blank?).uniq.join(" · ") %>
                </p>
              <% end %>
              <% if a.latitude.present? && a.longitude.present? %>
                <p class="text-[11px] text-slate-400 ml-14 tabular-nums">
                  <%= a.latitude.to_f.round(5) %>, <%= a.longitude.to_f.round(5) %>
                  <% if a.maps_link %>
                    · <%= link_to "Open in Maps", a.maps_link, target: "_blank", rel: "noopener", class: "underline" %>
                  <% end %>
                </p>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>
<% end %>

<%# Trails — already-curated, linked, and the AllTrails URL is the most
    useful thing for offline reference. %>
<% trails = @trip.trails.to_a %>
<% if trails.any? %>
  <section class="mb-6 wallet-card">
    <h2 class="text-xs uppercase tracking-widest text-slate-400 mb-2">Trails</h2>
    <ul class="space-y-1.5 text-sm">
      <% trails.each do |t| %>
        <li>
          <span class="font-medium"><%= t.name %></span>
          <% if t.alltrails_url.present? %>
            · <%= link_to t.alltrails_url, t.alltrails_url, target: "_blank", rel: "noopener", class: "underline break-all text-xs" %>
          <% end %>
          <% if t.notes.present? %>
            <p class="text-xs text-slate-600 mt-0.5"><%= t.notes %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<footer class="mt-10 pt-4 border-t border-slate-300 text-[10px] text-slate-400 flex items-center justify-between">
  <span>Plan My Trip · planmytrip.app</span>
  <span>Generated <%= Time.current.strftime("%b %-d, %Y at %-l:%M %p") %></span>
</footer>
