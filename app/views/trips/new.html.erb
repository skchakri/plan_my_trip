<% content_for :title, "New trip" %>
<div class="mb-6">
  <%= link_to trips_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 transition-colors" do %>
    <%= icon :arrow_left, class: "w-4 h-4" %> Trips
  <% end %>
  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-400 font-medium mt-3">Plan a trip</p>
  <h1 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight">New trip</h1>
  <p class="text-sm text-slate-400 mt-1.5">Title, destination, dates first — you can fill in the itinerary, trails, and PWA links below.</p>
</div>
<%= render "form" %>
