<%# One question/answer pair in the concierge log. %>
<div class="space-y-2">
  <div class="flex justify-end">
    <div class="max-w-[85%] rounded-2xl rounded-br-sm bg-amber-500/15 border border-amber-500/25 text-amber-50 px-3.5 py-2 text-sm">
      <%= question %>
    </div>
  </div>
  <div class="flex justify-start gap-2">
    <div class="shrink-0 mt-0.5 w-7 h-7 rounded-full bg-gradient-to-br from-teal-500/30 to-emerald-500/10 border border-teal-500/30 flex items-center justify-center text-teal-200">
      <%= icon :sparkles, class: "w-3.5 h-3.5" %>
    </div>
    <div class="max-w-[85%] rounded-2xl rounded-bl-sm bg-slate-800/70 border border-slate-700/60 text-slate-200 px-3.5 py-2 text-sm prose-concierge">
      <%= render_markdown(answer) %>
    </div>
  </div>
</div>
