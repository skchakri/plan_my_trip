<%# Structured editor for one TripDay + its activities. Display/inline-edit
    toggle via the inline-edit Stimulus controller; all forms full-page-redirect
    back to edit_plan. %>
<section class="rounded-2xl border border-slate-800 bg-slate-900/40 overflow-hidden" data-controller="inline-edit" data-action="keydown->inline-edit#keydown">
  <div class="flex items-start justify-between gap-2 px-4 py-3 border-b border-slate-800 bg-slate-900/60">
    <%# Day display %>
    <div class="min-w-0 flex-1" data-inline-edit-target="display">
      <h2 class="font-display text-lg font-semibold text-slate-50 truncate"><%= day.title.presence || day.label %></h2>
      <p class="text-xs text-slate-400 mt-0.5">
        <%= day.label %><% if day.date.present? %> · <%= day.date.strftime("%a %b %-d") %><% end %> ·
        <%= pluralize(day.activities.size, "stop") %>
      </p>
    </div>

    <%# Day inline-edit form %>
    <%= form_with url: trip_trip_day_path(trip, day), method: :patch, class: "min-w-0 flex-1 space-y-2", data: { inline_edit_target: "form" }, html: { hidden: true } do %>
      <%= text_field_tag "trip_day[label]", day.label, required: true, data: { inline_edit_target: "field" },
            class: "w-full rounded-md bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none" %>
      <div class="flex gap-2">
        <%= text_field_tag "trip_day[title]", day.title, placeholder: "Title",
              class: "flex-1 rounded-md bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none" %>
        <%= date_field_tag "trip_day[date]", day.date,
              class: "rounded-md bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none" %>
      </div>
      <%= text_area_tag "trip_day[summary]", day.summary, rows: 2, placeholder: "Short summary (optional)",
            class: "w-full rounded-md bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none" %>
      <div class="flex gap-1.5">
        <button type="submit" class="px-2.5 py-1.5 bg-amber-500 text-slate-950 rounded-md text-xs font-semibold hover:bg-amber-400 cursor-pointer">Save day</button>
        <button type="button" data-action="inline-edit#cancel" class="px-2 py-1.5 text-xs text-slate-400 hover:text-slate-200 cursor-pointer">Cancel</button>
      </div>
    <% end %>

    <div class="flex items-center gap-0.5 shrink-0">
      <% unless index.zero? %>
        <%= button_to move_trip_trip_day_path(trip, day, direction: "up"), method: :patch, class: "p-1.5 text-slate-400 hover:text-amber-300 rounded hover:bg-slate-800 cursor-pointer", form: { title: "Move up" } do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
        <% end %>
      <% end %>
      <% unless last %>
        <%= button_to move_trip_trip_day_path(trip, day, direction: "down"), method: :patch, class: "p-1.5 text-slate-400 hover:text-amber-300 rounded hover:bg-slate-800 cursor-pointer", form: { title: "Move down" } do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        <% end %>
      <% end %>
      <button type="button" data-action="inline-edit#edit" aria-label="Edit day" class="p-1.5 text-slate-400 hover:text-amber-300 rounded hover:bg-slate-800 cursor-pointer">
        <%= icon :pencil, class: "w-4 h-4" %>
      </button>
      <%= button_to trip_trip_day_path(trip, day), method: :delete, form: { data: { turbo_confirm: "Delete this day and all its stops?" } }, class: "p-1.5 text-rose-400 hover:text-rose-300 rounded hover:bg-rose-500/10 cursor-pointer", aria: { label: "Delete day" } do %>
        <%= icon :trash, class: "w-4 h-4" %>
      <% end %>
    </div>
  </div>

  <%# Activities %>
  <ul class="divide-y divide-slate-800/50">
    <% day.activities.each_with_index do |activity, j| %>
      <%= render "trips/activity_editor", trip: trip, activity: activity, index: j, last: (j == day.activities.size - 1) %>
    <% end %>
  </ul>

  <%# Add a stop %>
  <div class="px-4 py-3 border-t border-slate-800/60 bg-slate-900/30">
    <details>
      <summary class="cursor-pointer text-xs font-medium text-slate-300 inline-flex items-center gap-1.5">
        <%= icon :plus, class: "w-3.5 h-3.5 text-amber-400" %> Add a stop
      </summary>
      <%= form_with url: trip_activities_path(trip), method: :post, class: "mt-2.5 space-y-2" do %>
        <%= hidden_field_tag :trip_day_id, day.id %>
        <div class="flex gap-2">
          <%= text_field_tag "activity[title]", nil, required: true, placeholder: "Stop name",
                class: "flex-1 rounded-md bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none" %>
          <%= text_field_tag "activity[time_label]", nil, placeholder: "Time (e.g. 9am)",
                class: "w-28 rounded-md bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none" %>
        </div>
        <%= text_field_tag "activity[location_name]", nil, placeholder: "Location / address (optional)",
              class: "w-full rounded-md bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none" %>
        <%= text_area_tag "activity[notes]", nil, rows: 2, placeholder: "Notes (optional)",
              class: "w-full rounded-md bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none" %>
        <%= submit_tag "Add stop", class: "px-3 py-1.5 bg-amber-500 text-slate-950 rounded-md text-xs font-semibold hover:bg-amber-400 cursor-pointer" %>
      <% end %>
    </details>
  </div>
</section>
