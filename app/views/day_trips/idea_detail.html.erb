<%= turbo_frame_tag "day-trip-idea-modal" do %>
  <article class="relative"
           data-controller="idea-modal"
           data-idea-modal-slug-value="<%= @idea.slug %>">
    <%# Close affordance — modal controller listens for the click. %>
    <button type="button"
            data-action="place-modal#close"
            aria-label="Close"
            class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-slate-900/90 border border-slate-700 text-slate-300 hover:text-amber-200 hover:border-amber-500/50 flex items-center justify-center text-xl leading-none cursor-pointer">×</button>

    <% if @idea.image_url.present? %>
      <div class="rounded-t-xl overflow-hidden bg-slate-900">
        <img src="<%= @idea.image_url %>" alt="<%= @idea.name %>" referrerpolicy="no-referrer"
             class="w-full aspect-[16/9] object-cover">
      </div>
    <% else %>
      <div class="rounded-t-xl bg-gradient-to-br from-slate-800 to-slate-900 aspect-[16/9] flex items-center justify-center text-slate-700 text-5xl">◌</div>
    <% end %>

    <div class="p-5 space-y-4">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 class="font-display text-2xl font-semibold text-slate-50 leading-tight"><%= @idea.name %></h2>
          <div class="flex flex-wrap items-center gap-1.5 mt-2 text-[10px] uppercase tracking-widest font-semibold">
            <% if @idea.category.present? %>
              <span class="chip"><%= @idea.category %></span>
            <% end %>
            <% if @idea.tier.present? %>
              <span class="px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-300"><%= @idea.tier %></span>
            <% end %>
            <% if @idea.from_catalog? %>
              <span class="px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-300">in catalog</span>
            <% end %>
            <% if @idea.respond_to?(:has_real_rating?) && @idea.has_real_rating? %>
              <span class="chip">
                <%= star_row(@idea.rating, klass: "w-3 h-3") %>
                <%= @idea.community_rating %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <%# ── Quick stats grid ── %>
      <div class="grid grid-cols-3 sm:grid-cols-4 gap-2 text-xs">
        <% [
             [ "Drive", @idea.drive_minutes ? "#{@idea.drive_minutes} min" : nil ],
             [ "Distance", @idea.distance_km ? "#{km_to_miles(@idea.distance_km)} mi" : nil ],
             [ "On site", @idea.duration_hours ? "#{@idea.duration_hours} hr" : nil ],
             [ "Best time", @idea.best_time ]
           ].each do |label, value| %>
          <% next if value.blank? %>
          <div class="rounded-md border border-slate-800 bg-slate-950/40 px-2.5 py-1.5">
            <p class="text-[9px] uppercase tracking-widest text-slate-400 font-semibold"><%= label %></p>
            <p class="text-slate-200 text-sm"><%= value %></p>
          </div>
        <% end %>
      </div>

      <% if @idea.summary.present? %>
        <div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
          <p class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold mb-1">About</p>
          <p class="text-sm text-slate-200 leading-relaxed"><%= @idea.summary %></p>
        </div>
      <% end %>

      <% if Array(@idea.tags).any? %>
        <div class="flex flex-wrap gap-1.5">
          <% @idea.tags.each do |tag| %>
            <span class="chip"><%= tag.to_s.tr("_", " ") %></span>
          <% end %>
        </div>
      <% end %>

      <%# ── Map + external links ── %>
      <% if @idea.latitude.present? && @idea.longitude.present? %>
        <% maps_q = URI.encode_www_form_component("#{@idea.name} #{@idea.latitude},#{@idea.longitude}") %>
        <div class="flex flex-wrap gap-2 text-xs">
          <a href="https://www.google.com/maps/search/?api=1&query=<%= maps_q %>" target="_blank" rel="noopener"
             class="inline-flex items-center gap-1 px-3 py-1.5 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-200">
            Open in Google Maps ↗
          </a>
          <a href="https://www.openstreetmap.org/?mlat=<%= @idea.latitude %>&mlon=<%= @idea.longitude %>#map=14/<%= @idea.latitude %>/<%= @idea.longitude %>"
             target="_blank" rel="noopener"
             class="inline-flex items-center gap-1 px-3 py-1.5 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-200">
            OpenStreetMap ↗
          </a>
          <% if @idea.wikipedia_url.present? %>
            <a href="<%= @idea.wikipedia_url %>" target="_blank" rel="noopener"
               class="inline-flex items-center gap-1 px-3 py-1.5 rounded-md bg-slate-800 hover:bg-slate-700 text-slate-200">
              Wikipedia ↗
            </a>
          <% end %>
        </div>
      <% end %>

      <%# ── Click-to-load rich detail (best time, things to do, pro tips) ──
          The link targets its own frame, so tapping it swaps the button for
          the HighlightDetail sections without leaving the modal. %>
      <%= turbo_frame_tag "idea-more", class: "block aria-busy:opacity-60 aria-busy:animate-pulse" do %>
        <%= link_to day_trip_idea_more_path(request.query_parameters),
                    class: "w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-amber-500/30 bg-amber-500/10 hover:bg-amber-500/20 text-amber-200 text-sm font-semibold transition-colors" do %>
          <%= icon :sparkles, class: "w-4 h-4" %>
          More about this place
        <% end %>
      <% end %>

      <%# ── Add/remove from plan ──
          Dispatches a window-level event the parent page's idea-picker
          controller listens for. Button label flips after the parent
          confirms via the `idea-picker:changed` event. %>
      <div class="pt-2">
        <button type="button"
                data-action="click->idea-modal#togglePlan"
                data-idea-modal-target="planButton"
                class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold transition-colors">
          <span data-idea-modal-target="planLabel">Add to my day plan</span>
        </button>
      </div>
    </div>
  </article>
<% end %>
