<%# New-comment form. Wrapped in a turbo-frame-like id so the Turbo Stream
    can replace it (and clear the textarea) after a successful create. %>
<div id="activity-<%= activity.id %>-comment-form" class="mt-3">
  <%= form_with model: [ trip, activity, comment ],
        url: trip_activity_comments_path(trip, activity),
        local: false,
        class: "flex gap-2 items-start" do |f| %>
    <%= f.text_area :body,
          rows: 1,
          placeholder: "Discuss this stop…",
          class: "flex-1 min-w-0 px-3 py-2 rounded-lg bg-slate-950/60 border border-slate-700 text-sm text-slate-100 placeholder-slate-500 focus:border-amber-500/60 outline-none resize-none",
          data: { controller: "auto-grow", action: "input->auto-grow#resize" },
          required: true %>
    <%= f.submit "Post",
          class: "shrink-0 px-3 py-2 rounded-lg bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 transition-colors" %>
  <% end %>
  <% if comment.errors.any? %>
    <p class="mt-1 text-xs text-rose-300"><%= comment.errors.full_messages.to_sentence %></p>
  <% end %>
</div>
