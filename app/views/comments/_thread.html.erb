<%# Full comment thread for an activity — list + new-comment form. Embedded
    inside the plan view; current_user must be a trip member to see this. %>
<section class="mt-4 pl-3 border-l-2 border-slate-800/80">
  <details <%= "open" if activity.comments.any? %>>
    <summary class="cursor-pointer list-none inline-flex items-center gap-1.5 text-[11px] uppercase tracking-wider text-slate-400 hover:text-amber-300 transition-colors">
      <%= icon :message_circle, class: "w-3.5 h-3.5" %>
      <% n = activity.comments.size %>
      <%= n.zero? ? "Add a comment" : pluralize(n, "comment") %>
    </summary>
    <ul id="activity-<%= activity.id %>-comments" class="mt-3 space-y-3">
      <% activity.comments.each do |c| %>
        <%= render "comments/comment", comment: c %>
      <% end %>
    </ul>
    <%= render "comments/form", trip: trip, activity: activity, comment: activity.comments.build %>
  </details>
</section>
