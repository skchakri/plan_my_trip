<% content_for :title, "Help & Support" %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10">
  <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
    <h1 class="font-display text-3xl text-slate-50">Help &amp; Support</h1>
    <%= link_to "Ask a question", new_support_ticket_path,
          class: "text-sm px-3 py-1.5 rounded-md bg-amber-500 text-slate-950 font-semibold hover:bg-amber-400 transition-colors" %>
  </div>

  <% if @tickets.empty? %>
    <div class="rounded-xl border border-dashed border-slate-700 bg-slate-900/30 p-10 text-center">
      <p class="text-slate-300 font-medium">No questions yet.</p>
      <p class="text-sm text-slate-400 mt-1">Ask us anything about planning trips, sharing, or your account. We usually reply within an hour.</p>
      <%= link_to "Ask a question", new_support_ticket_path, class: "inline-block mt-4 text-sm px-3 py-1.5 rounded-md bg-amber-500 text-slate-950 font-semibold hover:bg-amber-400" %>
    </div>
  <% else %>
    <ul class="divide-y divide-slate-800 rounded-xl border border-slate-800 bg-slate-900/40">
      <% @tickets.each do |ticket| %>
        <li>
          <%= link_to support_ticket_path(ticket), class: "block px-4 py-3 hover:bg-white/5 transition-colors" do %>
            <div class="flex items-start justify-between gap-3">
              <p class="text-slate-100 font-medium min-w-0 truncate"><%= ticket.subject %></p>
              <%= support_status_badge(ticket.status) %>
            </div>
            <p class="text-xs text-slate-400 mt-1">Updated <%= time_ago_in_words(ticket.last_activity_at || ticket.updated_at) %> ago</p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
