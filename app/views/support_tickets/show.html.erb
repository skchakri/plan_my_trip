<% content_for :title, @ticket.subject %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10">
  <%= link_to support_tickets_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 mb-4" do %>
    ← Back to support
  <% end %>

  <div class="flex items-start justify-between gap-3 mb-6">
    <h1 class="font-display text-2xl sm:text-3xl text-slate-50 min-w-0"><%= @ticket.subject %></h1>
    <%= support_status_badge(@ticket.status) %>
  </div>

  <div class="space-y-4">
    <% @messages.each do |message| %>
      <% label, bubble = support_message_meta(message) %>
      <div class="rounded-xl border <%= bubble %> px-4 py-3">
        <div class="flex items-center justify-between mb-1">
          <span class="text-xs font-semibold text-slate-300"><%= label %></span>
          <span class="text-[11px] text-slate-400"><%= message.created_at.strftime("%b %-d, %-l:%M %p") %></span>
        </div>
        <div class="prose-invert max-w-none text-slate-200 text-sm leading-relaxed">
          <%= simple_format(message.body) %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @ticket.status == "open" && @messages.last&.from_user? %>
    <p class="text-sm text-slate-400 mt-6 rounded-lg border border-slate-800 bg-slate-900/40 px-4 py-3">
      Thanks — we've got your message. Our assistant usually replies within an hour.
    </p>
  <% end %>

  <% unless @ticket.status.in?(%w[resolved closed]) %>
    <div class="mt-6 pt-6 border-t border-slate-800">
      <%= form_with url: reply_support_ticket_path(@ticket), method: :post, class: "space-y-3" do |f| %>
        <%= f.label :"support_message[body]", "Add a reply", class: "block text-sm text-slate-300" %>
        <%= f.text_area "support_message[body]", rows: 3, required: true,
              class: "w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-slate-100 focus:border-amber-500 focus:ring-1 focus:ring-amber-500",
              placeholder: "Add more detail or ask a follow-up…" %>
        <%= f.submit "Send reply", class: "px-4 py-2 rounded-lg bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 cursor-pointer" %>
      <% end %>
    </div>
  <% end %>
</div>
