<% content_for :title, "Ask a question" %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10">
  <%= link_to support_tickets_path, class: "inline-flex items-center gap-1 text-sm text-slate-400 hover:text-amber-300 mb-4" do %>
    ← Back to support
  <% end %>
  <h1 class="font-display text-3xl text-slate-50 mb-2">Ask a question</h1>
  <p class="text-sm text-slate-400 mb-6">Tell us what's going on. Our assistant usually replies within an hour — trickier questions get handed to a human.</p>

  <%= form_with model: @ticket, url: support_tickets_path, class: "space-y-5" do |f| %>
    <% if @ticket.errors.any? %>
      <div class="rounded-lg bg-rose-500/15 border border-rose-500/30 text-rose-100 px-3 py-2 text-sm">
        <%= @ticket.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <% field = "w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-slate-100 focus:border-amber-500 focus:ring-1 focus:ring-amber-500" %>

    <div>
      <%= f.label :subject, "Subject", class: "block text-sm text-slate-300 mb-1" %>
      <%= f.text_field :subject, required: true, placeholder: "e.g. How do I share a trip with my family?", class: field %>
    </div>

    <div>
      <%= f.label :body, "Your question", class: "block text-sm text-slate-300 mb-1" %>
      <%= f.text_area :body, rows: 6, required: true, placeholder: "Add as much detail as you can…", class: field %>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit "Send question", class: "px-4 py-2 rounded-lg bg-amber-500 text-slate-950 text-sm font-semibold hover:bg-amber-400 cursor-pointer" %>
      <%= link_to "Cancel", support_tickets_path, class: "text-sm text-slate-400 hover:text-white" %>
    </div>
  <% end %>
</div>
