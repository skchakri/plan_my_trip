<%# Shared "travel ephemera" design language (lp-*) used by the marketing
    landing page AND the /road-trips route guides. Render inside content_for
    :head. See [[landing-page-design-language]]. %>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  /* ── Travel-ephemera styles (lp-*) ─────────────────────────── */
  .lp-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: 0.14em; }

  /* Paper ephemera — the light artifacts on the dark page */
  .lp-paper {
    background:
      radial-gradient(rgba(15,23,42,.045) 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(160deg, #F2EEE3, #E9E4D6);
    color: #0f172a;
    box-shadow: 0 30px 60px -18px rgba(0,0,0,.75), 0 4px 14px rgba(0,0,0,.4);
  }
  .lp-paper-hole {
    background: #020617;
    box-shadow: inset 0 1px 2px rgba(0,0,0,.5);
  }

  /* Perforation between ticket body and stub */
  .lp-perf {
    background-image: linear-gradient(to bottom, rgba(15,23,42,.35) 45%, transparent 45%);
    background-size: 2px 12px;
    background-repeat: repeat-y;
  }
  @media (max-width: 767px) {
    .lp-perf { background-image: linear-gradient(to right, rgba(15,23,42,.35) 45%, transparent 45%); background-size: 12px 2px; background-repeat: repeat-x; }
  }

  /* Fake barcode on the boarding pass stub */
  .lp-barcode {
    background-image: repeating-linear-gradient(to right,
      #0f172a 0 2px, transparent 2px 4px, #0f172a 4px 5px, transparent 5px 9px,
      #0f172a 9px 12px, transparent 12px 14px, #0f172a 14px 15px, transparent 15px 20px);
  }

  /* Scroll reveals */
  .lp-reveal {
    opacity: 0; transform: translateY(26px);
    transition: opacity .7s ease, transform .8s cubic-bezier(.16, 1, .3, 1);
    transition-delay: var(--lp-d, 0ms);
  }
  .lp-reveal.lp-in { opacity: 1; transform: none; }

  /* Itinerary route spine */
  .lp-spine-road  { stroke: rgba(148,163,184,.28); stroke-width: 2; stroke-dasharray: 2 9; fill: none; }
  .lp-spine-drawn { stroke: url(#lp-route-gradient); stroke-width: 2.5; fill: none;
                    filter: drop-shadow(0 0 6px rgba(251,191,36,.55)); }

  /* Chapter stop markers */
  .lp-stop-marker {
    transition: border-color .6s ease, color .6s ease, box-shadow .6s ease;
    transition-delay: 150ms;
  }
  .lp-reveal.lp-in .lp-stop-marker {
    border-color: rgba(251,191,36,.7); color: #fcd34d;
    box-shadow: 0 0 22px rgba(251,191,36,.28);
  }

  /* Destination marquee */
  .lp-marquee-track { display: flex; width: max-content; animation: lp-marquee 46s linear infinite; }
  @keyframes lp-marquee { to { transform: translateX(-50%); } }

  /* Hero route ticker — the dot driving origin → destination */
  .lp-drive-dot { animation: lp-drive 9s cubic-bezier(.45,.05,.55,.95) infinite; }
  @keyframes lp-drive {
    0%   { left: 0%;   opacity: 0; }
    6%   { opacity: 1; }
    94%  { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  /* Podcast waveform */
  .lp-wave-bar { transform-origin: bottom; animation: lp-wave 1.15s ease-in-out infinite alternate; }
  @keyframes lp-wave { from { transform: scaleY(.25); } to { transform: scaleY(1); } }

  /* Async-build shimmer */
  .lp-shimmer {
    background: linear-gradient(100deg, rgba(251,191,36,.15) 30%, rgba(251,191,36,.5) 50%, rgba(251,191,36,.15) 70%);
    background-size: 200% 100%;
    animation: lp-shimmer 1.8s linear infinite;
  }
  @keyframes lp-shimmer { to { background-position: -200% 0; } }

  @media (prefers-reduced-motion: reduce) {
    .lp-reveal { opacity: 1; transform: none; transition: none; }
    .lp-marquee-track, .lp-drive-dot, .lp-wave-bar, .lp-shimmer { animation: none; }
    .lp-wave-bar { transform: scaleY(.65); }
  }
</style>
