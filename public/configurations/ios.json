{
  "settings": {
    "screenshots_enabled": true
  },
  "rules": [
    {
      "patterns": ["/users/sign_in$", "/users/sign_up$", "/users/password/.*"],
      "properties": {
        "context": "modal",
        "presentation": "replace_root",
        "title": "Wanderply"
      }
    },
    {
      "_comment": "/trips/new 302s into the 4-step wizard (/trip_wizard/destination). A modal that immediately redirects out of its own rule fails to load in the native shell, so the whole wizard pushes like any other page.",
      "patterns": ["/trips/new$", "/trip_wizard/.*"],
      "properties": {
        "context": "default",
        "title": "New trip"
      }
    },
    {
      "patterns": ["/trips/[0-9a-f-]+/edit$"],
      "properties": {
        "context": "modal",
        "title": "Edit trip"
      }
    },
    {
      "patterns": ["/trips/[0-9a-f-]+/shares/new$"],
      "properties": {
        "context": "modal",
        "title": "Share trip"
      }
    },
    {
      "patterns": ["/$"],
      "properties": {
        "context": "default",
        "presentation": "replace_root",
        "title": "Trips"
      }
    },
    {
      "patterns": [".*"],
      "properties": {
        "context": "default"
      }
    }
  ]
}
