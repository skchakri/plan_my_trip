{
  "settings": {
    "screenshots_enabled": true
  },
  "rules": [
    {
      "patterns": ["/users/sign_in$", "/users/sign_up$", "/users/password/.*"],
      "properties": {
        "context": "modal",
        "uri": "hotwire://fragment/web/modal",
        "title": "Wanderply"
      }
    },
    {
      "_comment": "/trips/new is deliberately NOT here: it 302s into the 4-step wizard (/trip_wizard/destination), and a modal that immediately redirects out of its own rule fails to load in the native shell. Multi-step flows push like any other page.",
      "patterns": ["/trips/[0-9a-f-]+/edit$", "/trips/[0-9a-f-]+/shares/new$", "/users/edit$"],
      "properties": {
        "context": "modal",
        "uri": "hotwire://fragment/web/modal"
      }
    },
    {
      "patterns": ["/$"],
      "properties": {
        "uri": "hotwire://fragment/web/home",
        "fallback_uri": "hotwire://fragment/web",
        "title": "Trips"
      }
    },
    {
      "patterns": [".*"],
      "properties": {
        "uri": "hotwire://fragment/web",
        "context": "default",
        "pull_to_refresh_enabled": true
      }
    }
  ]
}
